// Mereholt's people: one row a role. Each is given a name from the
// `townsfolk` set in names.ron when the run starts, a different one every
// run, and stands at its post the first time the adventurer comes to town.
// `src/townsfolk.rs` reads it.
//
// Every field:
//   role:     the role in a word, one row each: what a line's `{role}` names,
//             and what a photograph's `UNDERMERE_NEAR` stands the adventurer
//             beside
//   called:   the role's words, said under the person's name on the look
//             panel: "the smith"
//   glyph:    the person on the map
//   color:    (r, g, b) in 0..=1: the glyph's, the person's lines in the log,
//             and for a keeper every ware on their trade screen
//   post:     the glyph of the person's mark in prefabs/mereholt.ron, where
//             they stand on the first arrival; one person a mark
//   moves:    one of
//               Keeps                 stands at the post, all run
//               Wanders(["cobbles"])  drifts a step now and then, onto these
//                                     tiles only, so never out of Mereholt
//               Rounds("lamp post")   walks from one of these props to the
//                                     next, round the whole town, and again
//   offers:   what a walk into them takes up, one or more, in this order:
//               Talk   says the next of `lines`, and takes a turn
//               Trade  opens the shop whose post in `src/shops.rs` is the role's
//               Rites  the temple's rites from rites.ron, beside Trade
//             A walk into someone who offers one thing takes it up; into
//             someone who offers more, it asks which.
//   greeting: optional: a keeper's line under their name on the trade screen,
//             said as written
//   lines:    optional, and needed by Talk: what talking says, each
//             (say: "...", when: ...), with `when` optional and one of
//               deepest(n)     once the adventurer has been down to floor n
//               slain("name")  once that monster of monsters.ron has died
//             Talking says the next line not yet said whose `when` holds,
//             and once each of those is said, the last of them again; so a
//             role that talks has a first line with no `when`. A line may
//             name another person by role, `{gatewarden}`, and says their
//             name this run.
[
    // The keepers.
    (
        role: "innkeeper",
        called: "the innkeeper",
        glyph: 'i',
        color: (0.95, 0.8, 0.45),
        post: 'I',
        moves: Keeps,
        offers: [Talk],
        // The next part's rumours take this line's place, and keep it as the
        // one said once they have all been told.
        lines: [
            (say: "That's all I've heard. Come back when you've been somewhere."),
        ],
    ),
    (
        role: "smith",
        called: "the smith",
        glyph: 's',
        color: (0.95, 0.55, 0.25),
        post: 'S',
        moves: Keeps,
        offers: [Trade],
        greeting: "Steel, leather, and arrows by the bundle. I buy what's straight and sell what's sharp.",
    ),
    (
        role: "apothecary",
        called: "the apothecary",
        glyph: 'a',
        color: (0.45, 0.85, 0.5),
        post: 'Y',
        moves: Keeps,
        offers: [Trade],
        greeting: "Everything on my shelves has a name, and I'll tell you it. What you bring me had better have one too.",
    ),
    (
        role: "curio",
        called: "the curio dealer",
        glyph: 'c',
        color: (0.75, 0.55, 0.95),
        post: 'D',
        moves: Keeps,
        offers: [Trade],
        greeting: "Rare things, dear things. Things the dead had no more use for.",
    ),
    (
        role: "priest",
        called: "the priest",
        glyph: 'p',
        color: (0.6, 0.8, 1.0),
        post: 'P',
        moves: Keeps,
        offers: [Trade, Rites],
        greeting: "The Still Water mends, unbinds and names. It asks a little gold for the candles.",
    ),
    // The townsfolk.
    (
        role: "gatewarden",
        called: "the gatewarden",
        glyph: 'w',
        color: (0.7, 0.75, 0.82),
        post: 'G',
        moves: Keeps,
        offers: [Talk],
        lines: [
            (say: "The stones let anyone through. It's the coming back they're particular about."),
            (say: "Carry a waystone. Kneel where it's quiet, and the gate will find you."),
            (say: "You've been deeper than my brother got. He's still down there, I'd guess.", when: deepest(5)),
        ],
    ),
    (
        role: "lamplighter",
        called: "the lamplighter",
        glyph: 'l',
        color: (1.0, 0.88, 0.55),
        post: 'M',
        moves: Rounds("lamp post"),
        offers: [Talk],
        lines: [
            (say: "Every lamp in Mereholt is lit by dusk. The lake doesn't like the dark either."),
            (say: "The deeper you go, the less your lantern helps. It isn't the oil. It's what's down there."),
        ],
    ),
    (
        role: "drunk",
        called: "the drunk",
        glyph: 'd',
        color: (0.8, 0.5, 0.45),
        post: 'U',
        moves: Keeps,
        offers: [Talk],
        lines: [
            (say: "Went down once. Came up. Never again."),
            (say: "Daggers. The sleeping ones never see a dagger coming."),
        ],
    ),
    (
        role: "gravedigger",
        called: "the gravedigger",
        glyph: 'g',
        color: (0.6, 0.55, 0.45),
        post: 'R',
        moves: Keeps,
        offers: [Talk],
        lines: [
            (say: "I bury what comes back up. Mostly it's just the name."),
            (say: "Fire or a hammer, for the bones that stand back up. Nothing else keeps them down."),
        ],
    ),
    (
        role: "fishwife",
        called: "the fishwife",
        glyph: 'f',
        color: (0.55, 0.78, 0.8),
        post: 'N',
        moves: Keeps,
        offers: [Talk],
        lines: [
            (say: "Nets came up empty again. Fish know better than to swim over the gate."),
            (say: "Heavy armor is loud. Half the lake can hear a man in plate."),
        ],
    ),
    (
        role: "child",
        called: "the child",
        glyph: 'k',
        color: (0.95, 0.7, 0.8),
        post: 'C',
        moves: Wanders(["cobbles"]),
        offers: [Talk],
        lines: [
            (say: "Are you going down? Will you bring me a bone? A real one?"),
            (say: "You came back! Was it dark? Was it scary?", when: deepest(3)),
            (say: "Everyone says you killed the goblin king! Was he big?", when: slain("Grubnak the goblin king")),
        ],
    ),
]
