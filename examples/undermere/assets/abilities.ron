// Undermere's abilities: what a monster knows besides its blow. A trait in
// `traits.ron` names the ones it grants, and whatever has the trait knows them.
//
// Every field (the ones marked "optional" may be left out):
//   name:        unique; a trait's `abilities` names it by this
//   description: optional; what it is, in a sentence
//   look:        optional; (glyph:, color: (r:, g:, b:)) in bytes, what flies and bursts when
//                it is used; without one the renderer's plain look is drawn
//   aim:         optional; Foe (default) | Ally | SelfOnly | Ground | Anyone
//   mode:        Own | Adjacent | Bolt(range:) | Ball(range:, radius:) | Beam(range:) |
//                Cone(length:)
//   sight:       optional; whether the aim must be a cell the user can see (default true)
//   requires:    optional; Has(status) | Lacks(status) | Wielding(tag) | InSlot(slot, tag) |
//                Above(stat, n); the slots are "main hand" | "off hand" | "head" | "body" |
//                "left finger" | "right finger" | "light", the tags "weapon" | "armor" |
//                "potion" | "scroll" | "staff" | "wand" | "ring" | "gold" | "arrow" | "light",
//                and the stats "strength" | "accuracy" | "evasion" | "speed" | "stealth" |
//                "mending" | "light" | "armor"
//   costs:       optional; Pool(stat, n) | Health(n) | Item(tag, n); Undermere has no pools
//   time:        optional; hundredths of a step the turn costs (default 100)
//   cooldown:    optional; hundredths before it may be used again, from the moment of use
//                (default 0)
//   effects:     each (kind:, chance:, args:); kind is one of the engine's Undermere registers:
//                Harm(kind:, roll:), Mend(roll:), Inflict(status:, turns:), Cleanse(status:),
//                Shove(cells:), Pull(cells:); Ignite(turns:), which sets what it lands on alight;
//                Emit(gas:, amount:); or one of Undermere's own, as `items.ron` lists them,
//                Teleport among them, which sends its user far off; or, part 3's own, Blink(reach:,
//                per_level:), the user along the line aimed, up to reach cells, Conjure(blades:,
//                turns:), spectral blades on the user's own side, RaiseDead, the nearest body in
//                sight and reach stood up as the user's own ally,
//                Steal, a landed blow's own trick, Rally(turns:), Grubnak's,
//                every ally in sight hasted, and CallDrowned(count:, range:), drowned thralls stood
//                up out of the water within range. The damage kinds are
//                "slash" | "pierce" | "crush" | "fire" | "cold" | "poison" | "lightning", and the
//                statuses "poisoned" | "scorched" | "mending" | "regenerating" | "chilled" |
//                "slowed" | "hasted" | "fireproof" | "shrouded" | "paralysed" | "confused" |
//                "discordant" | "webbed" | "warded" | "weakened" | "asleep"
#![enable(implicit_some)]
[
    // The salamander's: a cone of flame that sets the ground it reaches
    // alight, which its fire-blooded breather stands in unharmed.
    (
        name: "fire breath",
        description: "A gout of flame that burns whatever it reaches and leaves the ground alight.",
        look: (glyph: '*', color: (r: 255, g: 130, b: 40)),
        mode: Cone(length: 4),
        cooldown: 600,
        effects: [
            (kind: "Harm", args: (kind: "fire", roll: "2d6")),
            (kind: "Ignite", args: (turns: 3)),
        ],
    ),
    // The Ember Wyrm's own: wider and hotter than the salamander's, so a
    // trait of its own grants it rather than `fire breath`, whose numbers
    // are the salamander's to keep.
    (
        name: "wyrm breath",
        description: "A wide gout of flame that burns whatever it reaches and leaves the ground alight.",
        look: (glyph: '*', color: (r: 255, g: 115, b: 25)),
        mode: Cone(length: 5),
        cooldown: 700,
        effects: [
            (kind: "Harm", args: (kind: "fire", roll: "2d6+2")),
            (kind: "Ignite", args: (turns: 3)),
        ],
    ),
    // The Drowned King's: a grip of cold water reaching out of the dark,
    // which chills what it catches, a quarter slower for four turns.
    (
        name: "drowning grasp",
        description: "A grip of cold water that reaches out of the dark for the living.",
        look: (glyph: '~', color: (r: 140, g: 225, b: 205)),
        mode: Bolt(range: 5),
        cooldown: 500,
        effects: [
            (kind: "Harm", args: (kind: "cold", roll: "2d4")),
            (kind: "Inflict", args: (status: "chilled", turns: 4)),
        ],
    ),
    // Part 3's bestiary: a cave spider's and the Widow's web, a short
    // blink many kinds share, a goblin mystic's ward, a dar priestess's
    // mending hand, and a dar battlemage's fire and chill.
    (
        name: "spit web",
        description: "A gout of web that holds whatever it catches.",
        look: (glyph: '*', color: (r: 230, g: 230, b: 235)),
        mode: Bolt(range: 5),
        cooldown: 600,
        effects: [(kind: "Inflict", args: (status: "webbed", turns: 2))],
    ),
    (
        name: "blink",
        description: "A short step through the air, there and gone.",
        look: (glyph: '*', color: (r: 200, g: 210, b: 255)),
        aim: Ground,
        mode: Bolt(range: 6),
        cooldown: 500,
        effects: [(kind: "Blink", args: (reach: 4, per_level: 0))],
    ),
    (
        name: "ward ally",
        description: "A ward that turns three more of every blow for a while.",
        look: (glyph: '*', color: (r: 220, g: 220, b: 160)),
        aim: Ally,
        mode: Bolt(range: 6),
        cooldown: 800,
        effects: [(kind: "Inflict", args: (status: "warded", turns: 8))],
    ),
    (
        name: "mend ally",
        description: "A hand laid on an ally's wound.",
        look: (glyph: '*', color: (r: 180, g: 255, b: 190)),
        aim: Ally,
        mode: Bolt(range: 6),
        cooldown: 600,
        effects: [(kind: "Mend", args: (roll: "3d6"))],
    ),
    (
        name: "firebolt",
        description: "A bolt of fire hurled from a dar battlemage's hand.",
        look: (glyph: '*', color: (r: 255, g: 120, b: 40)),
        mode: Bolt(range: 7),
        cooldown: 400,
        effects: [(kind: "Harm", args: (kind: "fire", roll: "2d6"))],
    ),
    (
        name: "slowness",
        description: "A word that saps whoever it is spoken at.",
        look: (glyph: '*', color: (r: 150, g: 160, b: 200)),
        mode: Bolt(range: 8),
        cooldown: 800,
        effects: [(kind: "Inflict", args: (status: "slowed", turns: 5))],
    ),
    // A goblin conjurer's and, through the same staff, the adventurer's
    // own: blades on the caster's own side, never always the
    // adventurer's. `aim: SelfOnly` and `mode: Own` since nothing is
    // pointed; a caster reaches for it only with an enemy in sight, which
    // is when conjuring anything is worth the turn.
    (
        name: "conjure blades",
        description: "Calls up spectral blades to fight on your own side.",
        look: (glyph: '*', color: (r: 185, g: 220, b: 255)),
        aim: SelfOnly,
        mode: Own,
        cooldown: 1200,
        effects: [(kind: "Conjure", args: (blades: 2, turns: 12))],
    ),
    // A necromancer's: the nearest body in sight and within reach stands
    // up on the caster's own side. `aim: SelfOnly` and `mode: Own` for the
    // same reason `conjure blades` is: what it raises is found by
    // `RaiseDead` itself, not pointed by whoever casts it.
    (
        name: "raise dead",
        description: "Stands the nearest body in sight back up as your ally.",
        look: (glyph: '*', color: (r: 150, g: 200, b: 150)),
        aim: SelfOnly,
        mode: Own,
        cooldown: 1000,
        effects: [(kind: "RaiseDead")],
    ),
    // The five mini-bosses. Grubnak's war cry needs nowhere pointed,
    // the same reason `conjure blades` and `raise dead` take none: its own
    // sight is who it hits, not a cursor.
    (
        name: "war cry",
        description: "A roar that hastens every ally in sight for a while.",
        look: (glyph: '*', color: (r: 255, g: 210, b: 80)),
        aim: SelfOnly,
        mode: Own,
        cooldown: 2000,
        effects: [(kind: "Rally", args: (turns: 4))],
    ),
    // The Drowned Abbess's venomous spit, at range rather than a bite.
    (
        name: "spit",
        description: "A gout of venom spat from afar.",
        look: (glyph: '*', color: (r: 140, g: 200, b: 120)),
        mode: Bolt(range: 6),
        cooldown: 600,
        effects: [(kind: "Inflict", args: (status: "poisoned", turns: 4))],
    ),
    // The Drowned Abbess's: thralls stand up out of whatever water is
    // within her reach, not pointed at one, as `raise dead` is not.
    (
        name: "call the drowned",
        description: "Calls drowned thralls up out of the water within reach.",
        look: (glyph: '*', color: (r: 100, g: 150, b: 170)),
        aim: SelfOnly,
        mode: Own,
        cooldown: 2000,
        effects: [(kind: "CallDrowned", args: (count: 1, range: 6))],
    ),
]
