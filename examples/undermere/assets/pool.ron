// The run's pool: every piece a run may hold, how often, where, how many,
// and the budget each floor draws against. `rl_rules::pool::load` reads
// this file; `Pool::plan_run` draws a whole run's picks once, at run
// start, from a stream of the seed (`dungeon.rs` keeps it beside the
// lair draw); a floor's attempts then vary its layout and never its
// picks. `rl_mapgen::StampPicks` places the inside picks once a floor is
// surveyed; `Dress` lays the dressed ones and then every area nothing
// else took, from the biome's own list (`dungeon/biomes.rs::district_dressings`).
//
// Every field:
//   weights: [(name, weight)], how often an entry is drawn, by a name
//            the entries use; "withheld" is nought and never drawn, the
//            documented way to keep an entry out of a run until its
//            mechanism exists (`rl_rules::pool::load`'s own error for a
//            limit of nought says so): `Hidden Cache` is withheld here,
//            since nothing walls a secret over yet (`HideOpenings` is a
//            later task), so `Prefer::Hidden` would never find an area
//            and the floor would fail every attempt
//   tags:    every place tag an entry may name in `where` or `not`: the
//            twelve biomes, by the bare name `dungeon/biomes.rs` draws
//   budgets: how many picks of a kind a floor gets, one row a band
//     floors:   (first, last), the floors it covers
//     kind:     "flavor" | "risk_reward" | "reward"
//     count:    (fewest, most), drawn evenly for each floor
//     required: optional, false if left out; true fails a place that
//               cannot fit a pick of this kind, false drops the pick.
//               Flavor is never required (a flavor pick that fits
//               nowhere is dropped); risk-and-reward and reward both are
//               (a run never quietly loses a vault)
//   entries: what a place may be given
//     name:      the entry's name, from the spec's own tables
//     kind:      "flavor" | "risk_reward" | "reward"
//     piece:     the prefab it lays, for Grown and Inside
//     dressing:  the dressing it lays, for Dressed; one of piece and
//                dressing, never both
//     floors:    (first, last), the floors it may stand on
//     where:     optional, any if left out: biome tags of which a place
//                must carry one
//     not:       optional, none if left out: biome tags a place must
//                carry none of
//     weight:    a name from weights
//     per_place: optional, 1 if left out: the most of it on one floor
//     per_run:   optional, 1 if left out: the most of it in one run; 2
//                for a flavor entry shared across every biome, the
//                spec's own run limit for those, and for the risk,
//                reward and flavor entries the spec's tables mark
//                "(run 2)" or "(run 3)"
//     placed:    how it is laid, one of
//       Grown(join)       grown as an area of its own, joined by one of
//                         Door, Arch, Mouth(n), Locked("tag"), Sealed
//       Inside([shape])   stamped inside an area of one of the named
//                         shapes; any area if the list is empty
//       Dressed           a dressing laid over an area of any size
//     prefer:    optional, Anywhere if left out, and only Anywhere for a
//                grown piece: Secluded | DeadEnd | Hidden | Junction |
//                Anywhere
//
// Risk-and-reward and reward pieces whose mechanism (a trap, a lock's
// key, a lever, a causeway) is a later task's own stand here as minimal
// placeholder prefabs under `assets/prefabs/risk/` and
// `assets/prefabs/reward/`: a small room or a grown shell with nothing
// but its entry, so the pool loads, the draw is exercised end to end
// now, and the placeholder is filled in, not replaced, once its
// mechanism exists.
#![enable(implicit_some)]
(
    weights: [("rare", 5), ("uncommon", 20), ("common", 50), ("frequent", 100), ("withheld", 0)],
    tags: [
        "Upper Halls", "Cellars", "Watch Barracks", "Fungal Deeps", "Spider Warrens", "Old Mines",
        "Catacombs", "Sunken Library", "Drowned Cathedral", "Underlake", "Forge of Embers", "Ashen Galleries",
    ],
    budgets: [
        (floors: (1, 2), kind: "flavor", count: (3, 5)),
        (floors: (3, 6), kind: "flavor", count: (3, 5)),
        (floors: (7, 9), kind: "flavor", count: (2, 4)),
        (floors: (10, 10), kind: "flavor", count: (1, 2)),
        (floors: (1, 2), kind: "risk_reward", count: (1, 1), required: true),
        (floors: (3, 6), kind: "risk_reward", count: (1, 2), required: true),
        (floors: (7, 9), kind: "risk_reward", count: (2, 2), required: true),
        (floors: (1, 2), kind: "reward", count: (1, 2), required: true),
        (floors: (3, 6), kind: "reward", count: (1, 2), required: true),
        (floors: (7, 9), kind: "reward", count: (1, 1), required: true),
    ],
    entries: [
