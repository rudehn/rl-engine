// Where Undermere's bestiary turns up: on which floors, how often, and in what
// numbers. What each kind is and does is `monsters.ron`; this is only where.
//
// Every field, read by the engine's `load_spawns`:
//   monster: a name from `monsters.ron`
//   bands:   (first, last), the floors the row applies on, both included
//   weight:  how often it is drawn against every other row that applies on a floor;
//            only the ratio matters
//   group:   optional; (fewest, most) that come together when it is drawn, one when
//            left out
//
// A kind may have several rows, so its groups can grow with depth; a kind with no
// row never turns up on a floor by itself. The Drowned King and his knights have
// none: the throne's piece stands them at its slots on floor ten, and a row would
// put a second king on a floor, or his court out walking it. Rows are drawn in the
// order they are written, so moving one changes what a seed builds.
[
    (monster: "rat",             bands: (1, 3),   weight: 60, group: (1, 3)),
    (monster: "jackal",          bands: (1, 3),   weight: 30, group: (2, 4)),
    // Down to four, so the Old Mines, which favor them, hold them on both
    // their floors.
    (monster: "kobold",          bands: (1, 4),   weight: 50, group: (1, 2)),
    (monster: "goblin",          bands: (1, 2),   weight: 40, group: (1, 1)),
    (monster: "goblin",          bands: (3, 5),   weight: 50, group: (1, 3)),
    (monster: "monkey",          bands: (2, 4),   weight: 30, group: (1, 2)),
    (monster: "cave spider",     bands: (3, 5),   weight: 40, group: (1, 1)),
    (monster: "goblin archer",   bands: (3, 6),   weight: 20, group: (1, 1)),
    (monster: "goblin conjurer", bands: (3, 6),   weight: 20, group: (1, 1)),
    (monster: "goblin mystic",   bands: (3, 6),   weight: 20, group: (1, 1)),
    (monster: "myconid",         bands: (3, 4),   weight: 40, group: (1, 3)),
    (monster: "pink jelly",      bands: (4, 6),   weight: 25, group: (1, 1)),
    (monster: "vampire bat",     bands: (4, 6),   weight: 30, group: (1, 2)),
    // The goblins' brute, not before their band is big enough to keep one,
    // and on the throne's floor with the drowned and the wights, the few
    // groups that stand between the stairs and the court.
    (monster: "ogre",            bands: (4, 4),   weight: 10, group: (1, 1)),
    (monster: "ogre",            bands: (5, 10),  weight: 20, group: (1, 1)),
    (monster: "skeleton",        bands: (5, 7),   weight: 40, group: (1, 2)),
    (monster: "ghoul",           bands: (5, 8),   weight: 30, group: (1, 2)),
    (monster: "necromancer",     bands: (5, 7),   weight: 15, group: (1, 1)),
    // From five, so the Sunken Library, which favors both, holds them on
    // both its floors.
    (monster: "wraith",          bands: (5, 8),   weight: 20, group: (1, 1)),
    (monster: "will-o'-wisp",    bands: (5, 8),   weight: 15, group: (1, 1)),
    (monster: "drowned thrall",  bands: (7, 8),   weight: 60, group: (1, 2)),
    (monster: "drowned thrall",  bands: (10, 10), weight: 40, group: (1, 1)),
    (monster: "wight",           bands: (7, 10),  weight: 30, group: (1, 1)),
    (monster: "troll",           bands: (7, 9),   weight: 15, group: (1, 1)),
    // The forge's imps come one or two together rather than three, and a
    // little less often: swift, shooting fire that armor does not turn, in
    // threes they were a third of every death under the lake, and the forge
    // a wall rather than a floor.
    (monster: "fire imp",        bands: (9, 9),   weight: 40, group: (1, 2)),
    (monster: "salamander",      bands: (9, 9),   weight: 30, group: (1, 1)),
    // The deepest culture under the lake, and the one golem that still
    // stands guard. The dar also come as the trio the design means,
    // `population.rs`'s own band, the blademaster leading; these rows are
    // the dar met apart from it, one at a time.
    (monster: "golem",           bands: (8, 9),   weight: 10, group: (1, 1)),
    (monster: "dar blademaster", bands: (8, 9),   weight: 15, group: (1, 1)),
    (monster: "dar priestess",   bands: (8, 9),   weight: 10, group: (1, 1)),
    (monster: "dar battlemage",  bands: (8, 9),   weight: 10, group: (1, 1)),
    // The lived-in dungeon's small life: never a fight, so a low weight
    // and a small group are the whole of how they are tuned.
    (monster: "moth",            bands: (1, 9),   weight: 8,  group: (1, 2)),
    (monster: "blind cave rat",  bands: (3, 9),   weight: 8,  group: (1, 2)),
]
