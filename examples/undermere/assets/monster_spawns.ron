// Where Undermere's bestiary turns up: on which floors, how often, and in what
// numbers. What each kind is and does is `monsters.ron`; this is only where.
//
// Every field, read by the engine's `load_spawns`:
//   monster: a name from `monsters.ron`
//   bands:   (first, last), the floors the row applies on, both included
//   weight:  how often it is drawn against every other row that applies on a floor;
//            only the ratio matters
//   group:   optional; (fewest, most) that come together when it is drawn, one when
//            left out
//
// A kind may have several rows, so its groups can grow with depth; a kind with no
// row never turns up on a floor by itself. The Drowned King and his knights have
// none: the throne's piece stands them at its slots on floor ten, and a row would
// put a second king on a floor, or his court out walking it. Rows are drawn in the
// order they are written, so moving one changes what a seed builds.
//
// A kind lives where the biome that favors it does (`assets/biomes.ron`), and every
// biome of floors one to nine must have three kinds it favors with a row on each of
// its floors, which `dungeon::biomes::check_favored` holds at load. The strata
// moved the themes, not the curve: a kind moved up to the palace floors comes as a
// weaker early form, and one moved down to floors five and six as a stronger one,
// so how hard a floor is stays what parts three and four tuned it to.
[
    // The Drowned Town: vermin, and the smallest of the goblins.
    (monster: "rat",             bands: (1, 2),   weight: 60, group: (1, 3)),
    (monster: "jackal",          bands: (1, 2),   weight: 30, group: (2, 4)),
    (monster: "kobold",          bands: (1, 2),   weight: 50, group: (1, 2)),
    (monster: "goblin",          bands: (1, 2),   weight: 40, group: (1, 1)),
    (monster: "monkey",          bands: (2, 4),   weight: 30, group: (1, 2)),
    // The Palace and its Grounds: the cathedral's drowned and the library's
    // dead, each the early form of a kind that lives deeper, and the guard
    // drowned at its posts, the palace floors' brute. The acolytes are the
    // palace's killer, as the cave spider was on these floors before the
    // strata, so they come fewer on the first of them and more often and in
    // bigger groups on the second, where the guard comes too, as the ogre
    // did: floor four is the harder of the two, as it was.
    (monster: "drowned pilgrim", bands: (3, 4),   weight: 50, group: (1, 3)),
    (monster: "drowned acolyte", bands: (3, 3),   weight: 35, group: (1, 2)),
    (monster: "drowned acolyte", bands: (4, 4),   weight: 80, group: (1, 3)),
    (monster: "pale scribe",     bands: (3, 4),   weight: 40, group: (1, 1)),
    (monster: "will-o'-wisp",    bands: (3, 4),   weight: 25, group: (1, 1)),
    (monster: "drowned guard",   bands: (4, 4),   weight: 30, group: (1, 1)),
    // The Palace grounds' first wave: the wood's hounds and its hart, the
    // gardens' adders and the menagerie's apes. Each comes rarely on its own
    // and three times as often where its own biome favors it, so the library
    // and the cathedral keep their dead; the hounds run in bigger packs and
    // the apes come oftener on floor four, the harder of the two.
    (monster: "pale hound",      bands: (3, 3),   weight: 15, group: (2, 3)),
    (monster: "pale hound",      bands: (4, 4),   weight: 20, group: (2, 4)),
    (monster: "white hart",      bands: (3, 4),   weight: 10, group: (1, 1)),
    (monster: "hedge adder",     bands: (3, 4),   weight: 15, group: (1, 2)),
    (monster: "pale ape",        bands: (3, 3),   weight: 8,  group: (1, 1)),
    (monster: "pale ape",        bands: (4, 4),   weight: 15, group: (1, 1)),
    // Beneath the Kingdom: the mines' goblins, the fungal caves, the warrens
    // and the crypts. The goblins' casters keep their old weight, now two
    // floors down with the mines they serve; the plain goblin, the spiders
    // and, below, the crypts' dead and the wraith come a little less often
    // than they did, for the three mini-bosses, a war band whatever was
    // drawn and two feeders all stand on these two floors now.
    (monster: "kobold",          bands: (5, 6),   weight: 30, group: (1, 2)),
    (monster: "goblin",          bands: (5, 6),   weight: 30, group: (1, 3)),
    (monster: "goblin archer",   bands: (5, 6),   weight: 20, group: (1, 1)),
    (monster: "goblin conjurer", bands: (5, 6),   weight: 20, group: (1, 1)),
    (monster: "goblin mystic",   bands: (5, 6),   weight: 20, group: (1, 1)),
    (monster: "myconid",         bands: (5, 6),   weight: 30, group: (1, 3)),
    (monster: "myconid elder",   bands: (5, 6),   weight: 25, group: (1, 2)),
    (monster: "cave spider",     bands: (5, 6),   weight: 15, group: (1, 1)),
    (monster: "giant spider",    bands: (5, 6),   weight: 15, group: (1, 1)),
    (monster: "spiderling",      bands: (5, 6),   weight: 25, group: (2, 4)),
    // Jellies and bats are the floors' own, wherever it is damp or dark.
    (monster: "pink jelly",      bands: (3, 6),   weight: 25, group: (1, 1)),
    (monster: "vampire bat",     bands: (3, 6),   weight: 30, group: (1, 2)),
    // The goblins' brute, not before their band is big enough to keep one,
    // and on the throne's floor with the drowned and the wights, the few
    // groups that stand between the stairs and the court.
    (monster: "ogre",            bands: (5, 10),  weight: 20, group: (1, 1)),
    (monster: "skeleton",        bands: (5, 7),   weight: 30, group: (1, 2)),
    (monster: "ghoul",           bands: (5, 8),   weight: 25, group: (1, 2)),
    (monster: "necromancer",     bands: (5, 7),   weight: 15, group: (1, 1)),
    (monster: "wraith",          bands: (5, 8),   weight: 15, group: (1, 1)),
    (monster: "will-o'-wisp",    bands: (5, 8),   weight: 15, group: (1, 1)),
    // Before the Kingdom and the Oldest Deep: the drowned of the deep water,
    // the forge's fire, and the first of the deep culture at the bottom.
    (monster: "drowned thrall",  bands: (7, 8),   weight: 50, group: (1, 2)),
    (monster: "drowned thrall",  bands: (10, 10), weight: 40, group: (1, 1)),
    (monster: "wight",           bands: (7, 8),   weight: 20, group: (1, 1)),
    (monster: "wight",           bands: (9, 10),  weight: 30, group: (1, 1)),
    // Floor nine's two biomes each favor three of the troll, the imp, the
    // salamander and the golem where before the strata each favored one, so
    // their rows there are cut, the imp's and the salamander's by a third and
    // the troll's and the golem's by half: the floor draws each about as
    // often as it did, and the forge is not a wall. The wight's row on
    // the Underlake's floors is cut the same way, for that biome now stands
    // on both of them.
    (monster: "troll",           bands: (7, 8),   weight: 15, group: (1, 1)),
    (monster: "troll",           bands: (9, 9),   weight: 8,  group: (1, 1)),
    // The forge's imps come one or two together rather than three, and a
    // little less often: swift, shooting fire that armor does not turn, in
    // threes they were a third of every death under the lake, and the forge
    // a wall rather than a floor.
    (monster: "fire imp",        bands: (9, 9),   weight: 27, group: (1, 2)),
    (monster: "salamander",      bands: (9, 9),   weight: 20, group: (1, 1)),
    // The deepest culture under the lake, and the one golem that still
    // stands guard. The dar also come as the trio the design means,
    // `population.rs`'s own band, the blademaster leading; these rows are
    // the dar met apart from it, one at a time.
    (monster: "golem",           bands: (8, 8),   weight: 10, group: (1, 1)),
    (monster: "golem",           bands: (9, 9),   weight: 5,  group: (1, 1)),
    (monster: "dar blademaster", bands: (8, 9),   weight: 15, group: (1, 1)),
    (monster: "dar priestess",   bands: (8, 9),   weight: 10, group: (1, 1)),
    (monster: "dar battlemage",  bands: (8, 9),   weight: 10, group: (1, 1)),
    // The lived-in dungeon's small life: never a fight, so a low weight
    // and a small group are the whole of how they are tuned.
    (monster: "moth",            bands: (1, 9),   weight: 8,  group: (1, 2)),
    (monster: "blind cave rat",  bands: (3, 9),   weight: 8,  group: (1, 2)),
]
