// Undermere's traits: what a monster is besides its core. A monster in
// `monsters.ron` lists the traits it has, an item in `items.ron` lends some to
// whoever wears it, and each is written here once.
//
// Every field (all but name may be left out, and one left out says nothing):
//   name:       unique; what a monster's `traits` and an item's `lends` name it by
//   says:       the examine panel's words for it
//   wits:       "mindless" | "animal" | "sapient", or a list as in the engine's Wits:
//               "flees" | "searches" | "opens_doors" | "picks_up" | "equips" | "throws" |
//               "uses" | "travels" | "wary", which may name a preset too; a monster's wits are
//               every wit its traits name together, and one whose traits name none is mindless
//   speed:      percent of normal: 100 normal, 150 half as fast again, 70 slow;
//               absent from all its traits, a monster moves at 100
//   perception: how far it sees, in tiles, through the light; absent from all its traits, 8
//   dark_sight: tiles it sees with no light at all; absent, only what it touches
//   flee_at:    percent health at or below which it runs from what it can see, if its wits
//               let it run; 0 never runs, and neither does a monster none of whose traits sets it
//   notice:     how it notices a quiet adventurer, as (certain: tiles it is sure within,
//               chance_pct: percent a turn beyond that, lit_bonus: tiles added to certain
//               while the adventurer stands in light, may be left out, 0, memory: turns it
//               keeps looking, may be left out, 6); absent, the engine's: sure only of what
//               is adjacent, 25 percent a turn beyond
//   hearing:    how it hears, as (threshold: steps of loudness a sound must still have when
//               it arrives, memory: turns it goes looking, may be left out, 6); absent, deaf
//   light:      the light it sheds, as (radius: tiles, color: (r, g, b) in 0..=1, flicker:
//               0..=1, 0 steady, may be left out)
//   resists:    [(damage kind, percent removed)]: "slash" | "pierce" | "crush" | "fire" |
//               "cold" | "poison"; 100 immune, negative a weakness
//   armor:      flat armor, added to the monster's own
//   abilities:  names from `abilities.ron`: "fire breath" | "drowning grasp" | "spit web" |
//               "blink" | "ward ally" | "mend ally" | "firebolt" | "slowness" | "conjure blades" |
//               "raise dead" | "war cry" | "spit" | "call the drowned" | "wyrm breath"
//   statuses:   held for life: "poisoned" | "scorched" | "mending" | "regenerating" | "chilled" |
//               "webbed" | "warded" | "weakened" | "asleep"
//   triggers:   what it does at its own moments: [(on: "hit" | "struck" | "died", area: Here |
//               Burst(radius: n), effects: [(kind:, chance:, args:)])], the engine's
//               Harm(kind:, roll:), Mend(roll:), Inflict(status:, turns:), Cleanse(status:),
//               Emit(gas:, amount:); or part 3's own, Wither(turns:), `weakened` capped at three
//               stacks, and Steal, a landed blow's own trick; landed through the engine's actor
//               triggers
//   keeps_away: (how far it lets an enemy get before it closes, how close it lets one get
//               before it backs away), both in tiles
//   trick:      whether this is a trick: unknown of a kind until the adventurer has seen it
//               land (a bite that poisons, a jelly that splits), rather than known on sight
//               (its look, its speed, whether it flies); absent, false, a plain trait
//
// Lists add up across a monster's traits: wits, resists, abilities, statuses and triggers.
// Every other field may be set by one of a monster's traits only, and a monster
// with two traits setting the same one is refused at load, naming both.
#![enable(implicit_some)]
[
    // What a mind can do, the three presets every monster starts from.
    (name: "mindless", says: "acts without thought", wits: "mindless"),
    (name: "animal", says: "a beast", wits: "animal"),
    (name: "sapient", says: "thinks, opens doors, uses what it finds", wits: "sapient"),
    // Running is a wit as well as a threshold, so a coward runs whatever
    // else its wits are, and the panel's words for it are never a lie.
    (name: "cowardly", says: "runs when hurt", wits: ["flees"], flee_at: 50),
    // A hundred rather than `cowardly`'s fifty: it runs the moment it is
    // seen, never waiting to be hurt first, which a thing this small
    // never survives being.
    (name: "timid", says: "flees before it is ever touched", wits: ["flees"], flee_at: 100),
    // Says what it is rather than changing anything: the small life's
    // own attack is already a flat nought in `monsters.ron`, and its
    // faction already fights nobody; this is the examine panel's word
    // for why.
    (name: "harmless", says: "means nothing by it, and nothing it does can hurt you"),
    (name: "swift", says: "fast", speed: 150),
    (name: "slow", says: "slow", speed: 70),
    (name: "keen-nosed", says: "hard to sneak past", perception: 10, notice: (certain: 4, chance_pct: 50)),
    (name: "sees in the dark", says: "sees without light", dark_sight: 6),
    // Setting `flee_at` is what makes a deathless coward a load error,
    // which is right: nothing can be both.
    (name: "deathless", says: "no blood, no breath: poison does nothing, and it never runs", resists: [("poison", 100)], flee_at: 0),
    (name: "thick-hided", says: "a hide that turns blows", armor: 2),
    (name: "armored", says: "plated", armor: 4),
    (name: "fire-blooded", says: "fire cannot hurt it; cold bites deep", resists: [("fire", 100), ("cold", -50)]),
    (name: "fungal glow", says: "glows a soft green", light: (radius: 4, color: (0.35, 1.0, 0.8), flicker: 0.0)),
    (name: "ember glow", says: "smoulders, lighting the dark", light: (radius: 4, color: (1.0, 0.55, 0.2), flicker: 0.3)),
    (name: "grave light", says: "lit by a cold, drowned light", light: (radius: 5, color: (0.55, 0.75, 1.0), flicker: 0.1)),
    (name: "regenerates", says: "its wounds close as you watch", statuses: ["regenerating"]),
    (name: "fire breath", says: "breathes fire", abilities: ["fire breath"], trick: true),
    (name: "drowning grasp", says: "drags the living down with a grip of cold water", abilities: ["drowning grasp"], trick: true),
    (name: "keen-eared", says: "hears every step", hearing: (threshold: 0, memory: 8)),
    // Part 3's bestiary: a bite that poisons, a spit that holds, a burst
    // where it dies, bones blades glance off, a touch that freezes, a
    // touch that saps strength, a step through the air, a ward for an
    // ally, a hand that mends one, two words a dar battlemage knows,
    // a thing that keeps its distance and glows, and the two that never
    // share a floor's sleep the same way as the rest.
    (name: "venomous", says: "its bite is venomous", trick: true,
     triggers: [(on: "hit", effects: [(kind: "Inflict", args: (status: "poisoned", turns: 4))])]),
    (name: "webbing", says: "spits webs that hold", abilities: ["spit web"], trick: true),
    (name: "spore-burst", says: "bursts into spores when it dies", trick: true,
     triggers: [(on: "died", area: Burst(radius: 1), effects: [(kind: "Emit", args: (gas: "confusing", amount: 200))])]),
    (name: "brittle", says: "bones that blades glance off and hammers break",
     resists: [("slash", 33), ("pierce", 33), ("crush", -50)]),
    (name: "paralysing", says: "a touch that freezes", trick: true,
     triggers: [(on: "hit", effects: [(kind: "Inflict", chance: 15, args: (status: "paralysed", turns: 2))])]),
    // `Wither` rather than the plain `Inflict` every other hit trigger
    // uses: `Stacking::Stack` has no maximum of its own, and the sheet
    // caps this one at three.
    (name: "withering", says: "saps strength", trick: true,
     triggers: [(on: "hit", effects: [(kind: "Wither", args: (turns: 20))])]),
    (name: "blinking", says: "blinks from place to place", abilities: ["blink"], trick: true),
    (name: "warding", says: "shields its allies", abilities: ["ward ally"], trick: true),
    (name: "mends allies", says: "mends its allies", abilities: ["mend ally"], trick: true),
    (name: "firebolt", says: "hurls fire from a word", abilities: ["firebolt"], trick: true),
    (name: "slowness", says: "saps your speed with a word", abilities: ["slowness"], trick: true),
    (name: "burns-badly", says: "burns, and stops healing while it does", resists: [("fire", -100)]),
    // Its glow is the light a kind that lures already carries for another
    // reason, a will-o'-wisp's grave light: `light` is a single value, so
    // a second trait setting it on the same kind would clash, and every
    // kind that lures in this bestiary already glows some other way.
    (name: "luring", says: "keeps away, and glows", keeps_away: (5, 3)),
    (name: "wakeful", says: "never sleeps", notice: (certain: 2, chance_pct: 35, lit_bonus: 4, memory: 8)),
    (name: "sleepy", says: "sleeps deeply"),
    // Part 3's own game systems (6b): a trait no field here can carry,
    // read by name once at load into `Tricks` and carried out in
    // `tricks.rs`, over `DamageDealt`, `Stepped` or a lit cell rather than
    // the trait model's own fold. `says` is still every one of their
    // words for the examine panel.
    (name: "splitting", says: "splits when struck", trick: true),
    // `travels` so `stealing`'s own flight always finds the floor's way
    // out to run for, through the engine's `Ways` sense, the moment
    // something is actually taken; `Steal` is the hit trigger that takes
    // it and marks the taker to run.
    (name: "stealing", says: "steals, then runs", wits: ["travels"], trick: true,
     triggers: [(on: "hit", effects: [(kind: "Steal")])]),
    // Plain rather than a trick: this is whether it is seen, the same
    // kind of thing `notice`, `hearing` and `sees in the dark` already
    // are, not an effect that lands. Out of the light and not beside the
    // adventurer, it is not on the map at all.
    (name: "shrouded", says: "unseen out of the light"),
    // Plain: an erratic step is seen the moment it is watched move, the
    // same kind of thing `swift` and `slow` already are.
    (name: "flitting", says: "flits erratically"),
    (name: "fire-trail", says: "leaves fire behind it", trick: true),
    (name: "reflecting", says: "turns magic back", trick: true),
    // Plain: travelling with its own kind, or keeping station on a
    // leader, is seen at a glance, nothing an effect lands to reveal.
    (name: "packing", says: "hunts in packs"),
    (name: "led", says: "follows its chief"),
    (name: "conjuring", says: "conjures blades from the air", abilities: ["conjure blades"], trick: true),
    (name: "raising", says: "raises the dead to fight for it", abilities: ["raise dead"], trick: true),
    // 6a's report moved this here too: nothing yet knew what a bite
    // "dealt" at the moment the engine's own `hit` fires, which is before
    // a blow's damage is resolved, so `judge_draining` reads `DamageDealt`
    // in `TurnSet::React` instead of a trigger.
    (name: "draining", says: "drinks what it wounds", trick: true),
    // A mini-boss's tricks and its entourage's. `war-cry`,
    // `spit` and `calling the drowned` each grant an ability, so they are
    // tricks as every other ability-granting trait is; `singing` is
    // plain, the same reasoning `regenerates` already is, since what it
    // grants its choir is a status held while it is near, not a discrete
    // thing that lands and could be watched landing.
    (name: "war-cry", says: "rallies its band", abilities: ["war cry"], trick: true),
    (name: "singing", says: "its song mends the dead that follow it"),
    (name: "spit", says: "spits poison from afar", abilities: ["spit"], trick: true),
    (name: "calling the drowned", says: "calls the drowned up out of the water", abilities: ["call the drowned"], trick: true),
    // The floor ten boss, drawn from three. `spawning` and
    // `welling` are game systems, read in `tricks.rs` exactly as
    // `splitting` and the rest of the game's own tricks are, never an ability or
    // a trigger; `wyrm breath` is the Ember Wyrm's own larger breath, a
    // new ability since its numbers are not the salamander's `fire
    // breath`.
    (name: "spawning", says: "spawns its young from the walls", trick: true),
    (name: "welling", says: "a drowned thrall rises from the black pool to join him", trick: true),
    (name: "wyrm breath", says: "breathes fire", abilities: ["wyrm breath"], trick: true),
    // A sword for hire: thinks, wears and uses what it carries as the
    // adventurer does, and runs at a quarter of its health rather than
    // dying for a fee.
    (name: "mercenary", says: "a sword for hire", wits: ["sapient", "uses", "equips"], flee_at: 25),
]
