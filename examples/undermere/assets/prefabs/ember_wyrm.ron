// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for. The chain that builds a place in `src/dungeon.rs` asks for it by
// name and says where it goes; the engine fills its slots on the arrival that
// built the place.
//
// Every field: see `throne.ron`'s own comment, which this repeats nothing of.
//
// One of the three floor ten bosses a run may draw, the Ember
// Wyrm alone in a hall of pillars over lava pools, the floor scorched to ash.
// 'O' is forge wall standing free as a pillar, exactly the trick `throne.ron`
// already plays with its own 'O'. Grown exactly as the throne is, an area
// of its own through the one entry at the foot of the drawing.
(
    name: "the Ember Wyrm",
    ground: "ash",
    turn: Quarter,
    mirror: Both,
    rows: [
        "===================",
        "=~~.............~~=",
        "=....O.......O....=",
        "=........D........=",
        "=.................=",
        "=....O.......O....=",
        "=.................=",
        "=.................=",
        "=~...............~=",
        "=~~~...........~~~=",
        "=.................=",
        "=.................=",
        "=========E=========",
    ],
    legend: {
        '=': Tile("forge wall"),
        'O': Tile("forge wall"),
        '.': Tile("ash"),
        '~': Tile("lava"),
        'D': Monster(monster: "the Ember Wyrm"),
        'E': Entry,
    },
)
