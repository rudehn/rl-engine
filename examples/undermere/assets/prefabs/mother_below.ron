// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for. The chain that builds a place in `src/dungeon.rs` asks for it by
// name and says where it goes; the engine fills its slots on the arrival that
// built the place.
//
// Every field: see `throne.ron`'s own comment, which this repeats nothing of.
//
// One of the three floor ten bosses a run may draw, the Mother
// Below alone in a vast, round cave, its walls pocked with burrows, the
// bones of what she fed on underfoot, and glowcaps, the Fungal Deeps' own
// light, growing in clumps in the dark where nothing has trodden them. Her
// own `spawning` tears fresh burrows while she lives. No court, no
// furniture: what she carries is herself. Grown exactly as the throne is,
// an area of its own through the one entry at the foot of the drawing.
(
    name: "the Mother Below",
    ground: "moss",
    rows: [
        "===================",
        "====.====.====.====",
        "===...\"\"...,....===",
        "=.,......M.....\"..=",
        "=..\"\"...........,.=",
        "==..............\"\"=",
        "=,..\".............=",
        "=................,=",
        "==..,..........\"..=",
        "=\"\"...............=",
        "==.\"......,.....===",
        "===..............==",
        "=========E=========",
    ],
    legend: {
        '=': Tile("cave wall"),
        '.': Tile("moss"),
        '"': Tile("glowcaps"),
        ',': Tile("bones"),
        'M': Monster(monster: "the Mother Below"),
        'E': Entry,
    },
)
