// Task 8a's own: the Choirmaster's crypt nave, drawn on one floor of his
// own 5-7. An organ of bones at its head, candles either side, and his
// four skeletons, `led` over him as his band comes together, mended
// while they stand near him by his own `singing`.
(
    name: "the Choirmaster",
    ground: "crypt floor",
    rows: [
        "###############",
        "#.............#",
        "#..c.......c..#",
        "#.............#",
        "#......n......#",
        "#......N......#",
        "#..z.......z..#",
        "#.............#",
        "#..z.......z..#",
        "#.............#",
        "###############",
    ],
    legend: {
        '#': Tile("crypt wall"),
        '.': Tile("crypt floor"),
        'c': Prop("candelabra"),
        'n': Prop("bone organ"),
        'N': Monster(monster: "the Choirmaster"),
        'z': Monster(monster: "skeleton"),
    },
)
