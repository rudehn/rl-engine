// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A cubby cut into a corridor's own wall, a ring caught by the light as it
// is passed.
(
    name: "Jeweller's Niche",
    ground: "hall floor",
    rows: [
        "###",
        "#R#",
        "#E#",
    ],
    legend: {
        '#': Tile("hall wall"),
        'R': Item(tag: "ring", count: 1),
        'E': Entry,
    },
)
