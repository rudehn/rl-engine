// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A scholar's corner: shelves of books, a desk and its lamp, and a staff
// left leaning where it was set down.
(
    name: "Wizard's Study",
    ground: "hall floor",
    turn: Quarter,
    mirror: Both,
    rows: [
        "=d=",
        "lS ",
    ],
    legend: {
        '=': Prop("shelf"),
        'd': Prop("desk"),
        'l': Prop("reading lamp"),
        'S': Item(tag: "staff", count: 1),
    },
)
