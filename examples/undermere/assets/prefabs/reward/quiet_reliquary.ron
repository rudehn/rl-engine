// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A candlelit chapel, one thing three floors deeper waiting on a pedestal
// at its heart.
(
    name: "Quiet Reliquary",
    ground: "hall floor",
    rows: [
        "#######",
        "#i...i#",
        "#.....#",
        "#..A..#",
        "#.....#",
        "###E###",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'i': Prop("candelabra"),
        'A': Item(tag: "ring", count: 1, band: 3),
        'E': Entry,
    },
)
