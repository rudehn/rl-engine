//
// A cart on its side where it was dragged down and left, its crates burst
// and some of its coin still lying in the dirt.
(
    name: "Overturned Wagon",
    ground: "hall floor",
    rows: [
        "cW",
        " g",
    ],
    legend: {
        'c': Prop("spilled crate"),
        'W': Prop("overturned wagon"),
        'g': Item(item: "gold coin", count: 1),
    },
)
