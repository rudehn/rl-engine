// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// Remains with a full pack still on them: whoever they were did not leave.
(
    name: "A Fallen Adventurer",
    ground: "hall floor",
    rows: [
        "rw",
        "ia",
    ],
    legend: {
        'r': Prop("remains"),
        'w': Item(tag: "weapon", count: 1),
        'i': Item(tag: "potion", count: (1, 2)),
        'a': Item(tag: "armor", count: 1),
    },
)
