// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `../reward/treasure_room.ron` for the full field list.
//
// The Old Town's: a well in the lane, its bucket left on the kerb and its
// rope gone to nothing.
(
    name: "Town Well",
    ground: "lane cobbles",
    turn: Quarter,
    mirror: Both,
    rows: [
        " o ",
        "  u",
    ],
    legend: {
        'o': Prop("well"),
        'u': Prop("bucket"),
    },
)
