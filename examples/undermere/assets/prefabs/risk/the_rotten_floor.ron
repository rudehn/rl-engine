// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A chamber floored with rotten planks over a drop, a plinth teetering at
// its middle: lift what it holds and the planks give way under everyone on
// them, who fall through to the floor below, off its stairs
// (`src/vaults/lifts.rs`).
(
    name: "The Rotten Floor",
    ground: "rotten planks",
    turn: Quarter,
    mirror: Both,
    rows: [
        "#########",
        "#=======#",
        "#===|===#",
        "#=======#",
        "#=======#",
        "####E####",
    ],
    legend: {
        '#': Tile("hall wall"),
        '=': Tile("rotten planks"),
        '|': Prop("teetering plinth"),
        'E': Entry,
    },
)
