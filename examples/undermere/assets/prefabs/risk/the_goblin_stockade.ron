// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A palisaded camp open at its front, three goblins asleep round the fire
// inside it, each `G` laid asleep by `src/vaults.rs`, their plunder heaped
// by the fire, and one awake on watch at the mouth of the stakes.
(
    name: "The Goblin Stockade",
    ground: "hall floor",
    turn: Quarter,
    mirror: Both,
    rows: [
        "ppppp",
        "pGFGp",
        "p * p",
        "pG  p",
        " w   ",
    ],
    legend: {
        'p': Prop("palisade"),
        'G': Mark,
        '*': Prop("loot pile"),
        'F': Prop("fire"),
        'w': Monster(monster: "goblin"),
    },
)
