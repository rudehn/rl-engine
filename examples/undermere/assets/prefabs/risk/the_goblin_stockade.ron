// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A camp round a fire, bedrolls where sleepers lay, their loot pile and
// a watch standing over it: one monster slot, since a floor's own lair
// or another risk-and-reward piece beside it already counts toward the
// floor's own court and the population tests' own bound on it.
(
    name: "The Goblin Stockade",
    ground: "hall floor",
    rows: [
        "b.b",
        "oFo",
        "b.a",
    ],
    legend: {
        '.': Tile("hall floor"),
        'b': Prop("bedroll"),
        'a': Monster(monster: "goblin archer"),
        'F': Prop("brazier"),
        'o': Item(item: "gold coin", count: (1, 2)),
    },
)
