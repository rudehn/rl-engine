// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// Cocooned bodies to cut open for what they carried, spiders overhead.
(
    name: "The Spider's Larder",
    ground: "hall floor",
    rows: [
        "h.h",
        "cic",
    ],
    legend: {
        '.': Tile("hall floor"),
        'h': Monster(monster: "cave spider"),
        'c': Prop("cocooned husk"),
        'i': Item(tag: "potion", count: (1, 2)),
    },
)
