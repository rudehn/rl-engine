// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// The spiders' dead, cocooned in a corner of the cave and strung with web,
// with what they carried still inside, and the spiders that wrapped them
// waiting over them.
(
    name: "The Spider's Larder",
    ground: "hall floor",
    rows: [
        "&w&",
        "wsw",
        "&ws",
    ],
    legend: {
        '&': Prop("cocooned body"),
        'w': Tile("web"),
        's': Monster(monster: "cave spider"),
    },
)
