// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// An ogre asleep across the one narrow way into a room, `Z`, laid asleep by
// `src/vaults.rs`, and the room's chest and gold behind him.
(
    name: "The Sleeping Giant",
    ground: "hall floor",
    rows: [
        "#######",
        "#.....#",
        "#.h.g.#",
        "#.....#",
        "###.###",
        "###Z###",
        "###.###",
        "###E###",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'h': Prop("chest"),
        'g': Item(item: "gold coin", count: 1),
        'Z': Mark,
        'E': Entry,
    },
)
