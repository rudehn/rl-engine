// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// An ogre asleep across a narrow way, the prize behind him: stands awake
// rather than dozing, since a piece's own monster slots always do (see
// the task's report).
(
    name: "The Sleeping Giant",
    ground: "hall floor",
    rows: [
        "#######",
        "#.....#",
        "#..O..#",
        "#..P..#",
        "###E###",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'O': Monster(monster: "ogre"),
        'P': Item(tag: "armor", count: 1),
        'E': Entry,
    },
)
