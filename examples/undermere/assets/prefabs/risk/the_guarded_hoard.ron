// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// Gold and a chest with a band of the floor's own asleep round it: each `z`
// a sleeper of the floor's own, drawn from its table and laid asleep by
// `src/vaults.rs`.
(
    name: "The Guarded Hoard",
    ground: "hall floor",
    turn: Quarter,
    mirror: Both,
    rows: [
        "zg ",
        " h ",
        " gz",
    ],
    legend: {
        'z': Mark,
        'g': Item(item: "gold coin", count: 1),
        'h': Prop("chest"),
    },
)
