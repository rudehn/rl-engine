// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A hidden plate in the doorway vents caustic gas into the room: the
// `props.ron` "caustic vent", a cell past the door.
(
    name: "The Gas Chamber",
    ground: "hall floor",
    rows: [
        "#######",
        "#..V..#",
        "#.....#",
        "#..P..#",
        "###E###",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'V': Prop("caustic vent"),
        'P': Item(tag: "armor", count: 1),
        'E': Entry,
    },
)
