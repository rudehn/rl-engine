// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A gallery of cracked lintels and fallen stone running round a block of
// rock, its two ways meeting again at a plinth in an alcove, the short way
// and the long: lift what the plinth holds and the lintel over the short way
// falls, the way most come, so the way out is the long one
// (`src/vaults/lifts.rs`).
(
    name: "The Collapsing Gallery",
    ground: "hall floor",
    rows: [
        "#############",
        "###|#########",
        "#...,.......#",
        "#.#########.#",
        "#.#########,#",
        "#.#########.#",
        "#..,.n.n....#",
        "######E######",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        '|': Prop("keystone plinth"),
        'n': Prop("cracked lintel"),
        ',': Tile("rubble"),
        'E': Entry,
    },
)
