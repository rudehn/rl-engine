//
// Two of the floor's own shackled to the wall, and their gaoler dozing
// between them: each `C` a captive drawn and shackled by `src/vaults.rs` as
// part 3's run captive is, freed the same way to follow, and `z` a sleeper
// of the floor's own.
(
    name: "Captives in Chains",
    ground: "hall floor",
    turn: Quarter,
    mirror: Both,
    rows: [
        "C C",
        " z ",
    ],
    legend: {
        'C': Mark,
        'z': Mark,
    },
)
