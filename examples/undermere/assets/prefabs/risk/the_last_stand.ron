// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// An adventurer's remains, pack still full, among the hidden plates that
// brought them down, and their killers asleep beside them.
(
    name: "The Last Stand",
    ground: "hall floor",
    rows: [
        "zd ",
        "d%d",
        " dz",
    ],
    legend: {
        'z': Mark,
        'd': Prop("dart plate"),
        '%': Prop("adventurer's remains"),
    },
)
