// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A narrow vestibule before a chamber where the dead wait asleep round a
// chest: a vent hidden in the vestibule breathes a paralysing gas over
// whoever passes and rouses what waits beyond, by `Rouse`, so they wake
// while the entrant is held fast.
(
    name: "The Paralysis Vestibule",
    ground: "hall floor",
    rows: [
        "#########",
        "#z.....z#",
        "#...h...#",
        "#..z.P..#",
        "####.####",
        "####v####",
        "####.####",
        "####E####",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'z': Mark,
        'h': Prop("chest"),
        'P': Item(tag: "armor", count: 1, band: 2),
        'v': Prop("paralysis vent"),
        'E': Entry,
    },
)
