// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A hidden vent in the vestibule holds the entrant fast while what waits
// within wakes: the `props.ron` "paralysis vent" in the doorway, one of
// the floor's own beyond it (one monster slot, since a floor's own lair
// or another risk-and-reward piece beside it already counts toward the
// floor's own court and the population tests' own bound on it).
(
    name: "The Paralysis Vestibule",
    ground: "hall floor",
    rows: [
        "#######",
        "#..g..#",
        "#..P..#",
        "#..V..#",
        "###E###",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'g': Monster(monster: "ghoul"),
        'V': Prop("paralysis vent"),
        'P': Item(tag: "ring", count: 1),
        'E': Entry,
    },
)
