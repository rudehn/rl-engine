// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A treasury behind an iron-bound door no hand opens: its key lies somewhere
// else on the floor, dropped by `src/vaults.rs` where the floor must be
// searched for it, and opens this vault and no other.
(
    name: "The Locked Vault",
    ground: "hall floor",
    turn: Quarter,
    mirror: Both,
    rows: [
        "#########",
        "#g..h..g#",
        "#.......#",
        "#i..P..i#",
        "####E####",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'g': Item(item: "gold coin", count: 1),
        'h': Prop("coin chest"),
        'P': Item(tag: "armor", count: 1, band: 2),
        'i': Prop("candelabra"),
        'E': Entry,
    },
)
