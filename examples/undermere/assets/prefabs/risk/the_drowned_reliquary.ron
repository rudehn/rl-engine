// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A reliquary on an island, reached over flooded floor: a causeway seen
// rather than one that must be spotted (`HideOpenings` is a later task's).
(
    name: "The Drowned Reliquary",
    ground: "hall floor",
    rows: [
        "#######",
        "#~~~~~#",
        "#~~A~~#",
        "#~~~~~#",
        "###E###",
    ],
    legend: {
        '#': Tile("hall wall"),
        '~': Tile("flooded floor"),
        'A': Item(tag: "wand", count: 1),
        'E': Entry,
    },
)
