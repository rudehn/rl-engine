// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A reliquary on an island in black water, reached by a causeway just under
// the surface: each `c` hidden by `src/vaults.rs` as the deep water round
// it, until it is spotted.
(
    name: "The Drowned Reliquary",
    ground: "hall floor",
    rows: [
        "#########",
        "#WWWWWWW#",
        "#WW...WW#",
        "#WW.R.WW#",
        "#WW...WW#",
        "#WWWcWWW#",
        "#WWWcWWW#",
        "#.......#",
        "####E####",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'W': Tile("deep water"),
        'R': Prop("reliquary"),
        'c': Mark,
        'E': Entry,
    },
)
