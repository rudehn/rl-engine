// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// Dry straw strewn over the floor of a dead end, a lit brazier at its edge
// and something left in the middle of it all: an ember plate hidden in the
// straw, and whatever catches burns the room and what lies in it.
(
    name: "The Tinder Room",
    ground: "straw",
    turn: Quarter,
    mirror: Both,
    rows: [
        "s&s",
        "sPs",
        "s^s",
    ],
    legend: {
        's': Tile("straw"),
        'P': Item(tag: "scroll", count: 1, band: 1),
        '^': Prop("ember plate"),
        '&': Prop("brazier"),
    },
)
