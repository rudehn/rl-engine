// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// Dry straw over the floor, a lit brazier by the door, the prize at the
// back: an ember caught underfoot is `props.ron`'s own "ember trap".
(
    name: "The Tinder Room",
    ground: "hall floor",
    rows: [
        "F.",
        "ex",
        "xP",
    ],
    legend: {
        '.': Tile("hall floor"),
        'F': Prop("brazier"),
        'x': Prop("dry straw"),
        'e': Prop("ember trap"),
        'P': Item(tag: "scroll", count: 1),
    },
)
