// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A narrow way of hidden plates to a room that holds the prize, someone's
// remains just inside as the tell: plates staggered across both lanes, so a
// walk straight up either is struck twice, and plates once spotted can be
// wound between.
(
    name: "The Trapped Corridor",
    ground: "hall floor",
    rows: [
        "######",
        "#....#",
        "#.P..#",
        "#....#",
        "##d.##",
        "##.d##",
        "##d.##",
        "##.d##",
        "##.r##",
        "##E###",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'P': Item(tag: "weapon", count: 1, band: 1),
        'd': Prop("dart plate"),
        'r': Prop("remains"),
        'E': Entry,
    },
)
