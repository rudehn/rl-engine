// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A corridor of hidden plates to a room that holds the prize: every plate
// its own `props.ron` "hidden dart plate", spotted or sprung.
(
    name: "The Trapped Corridor",
    ground: "hall floor",
    rows: [
        "#########",
        "#.......#",
        "#.d.d.d.#",
        "#.......#",
        "#...P...#",
        "####E####",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'd': Prop("hidden dart plate"),
        'P': Item(tag: "weapon", count: 1, band: 1),
        'E': Entry,
    },
)
