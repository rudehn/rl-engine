// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A long hall between two rows of statues, its prize at the far end, and
// hidden plates down its middle that loose darts from the statues on whoever
// treads on them.
(
    name: "Gallery of Darts",
    ground: "hall floor",
    turn: Quarter,
    mirror: Both,
    rows: [
        "###########",
        "#&.&.&.&..#",
        "E.d..d..dP#",
        "E..d..d...#",
        "#&.&.&.&..#",
        "###########",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        '&': Prop("guardian statue"),
        'd': Prop("dart plate"),
        'P': Item(tag: "armor", count: 1, band: 1),
        'E': Entry,
    },
)
