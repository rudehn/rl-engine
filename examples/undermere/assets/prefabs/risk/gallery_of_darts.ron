// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// Statues flank a hall and hidden plates fire darts from them: the tell
// is the statues themselves, carved where the floor's others never are.
(
    name: "Gallery of Darts",
    ground: "hall floor",
    rows: [
        "#########",
        "E..s...s#",
        "E.d..d..#",
        "#..sP..s#",
        "#########",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        's': Prop("guardian statue"),
        'd': Prop("hidden dart plate"),
        'P': Item(tag: "weapon", count: 1),
        'E': Entry,
    },
)
