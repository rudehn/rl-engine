// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// An altar in a room floored with grates, water already seeping round them:
// lift what the altar holds and the mere pours up through the grates,
// wading-deep at once and too deep to cross at the far wall within a few
// turns (`src/vaults/lifts.rs`).
(
    name: "The Flooding Vault",
    ground: "hall floor",
    turn: Quarter,
    mirror: Both,
    rows: [
        "#########",
        "#x~...~x#",
        "#.......#",
        "#...A...#",
        "#.......#",
        "#x.....x#",
        "####E####",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'x': Prop("iron grate"),
        '~': Tile("flooded floor"),
        'A': Prop("drowned altar"),
        'E': Entry,
    },
)
