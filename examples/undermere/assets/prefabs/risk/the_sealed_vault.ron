// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A stone gate; a concealed lever elsewhere on the floor raises it:
// `src/vaults.rs`'s own `place_vault_fixtures` drops the lever there, and
// `answer_pull_lever` lifts this very seal, the one `WorldMap::lock` with
// no key.
(
    name: "The Sealed Vault",
    ground: "hall floor",
    rows: [
        "#######",
        "#.....#",
        "#..A..#",
        "#..s..#",
        "###E###",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'A': Item(tag: "ring", count: 1, band: 1),
        's': Prop("stone pedestal"),
        'E': Entry,
    },
)
