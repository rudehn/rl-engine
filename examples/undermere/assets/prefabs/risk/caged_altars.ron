// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A candlelit shrine of three altars, each caged, each holding a thing seen
// through its bars: a blade, a staff, a ring. Open one and the other two
// slam shut on what they hold, so the choice of three is a choice of one
// (`src/vaults/lifts.rs`).
(
    name: "Caged Altars",
    ground: "hall floor",
    rows: [
        "###########",
        "#i.1.2.3.i#",
        "#.........#",
        "#.........#",
        "#####E#####",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'i': Prop("candelabra"),
        '1': Prop("caged blade"),
        '2': Prop("caged staff"),
        '3': Prop("caged ring"),
        'E': Entry,
    },
)
