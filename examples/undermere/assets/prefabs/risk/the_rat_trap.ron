// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// A thing left on a gnawed plinth in a room of gnawed bones, and holes at
// the foot of its walls: lift it and the vermin behind the walls pour out of
// every hole (`src/vaults/lifts.rs`).
(
    name: "The Rat Trap",
    ground: "hall floor",
    rows: [
        "#######",
        "#o.,.o#",
        "#.....#",
        "#..|..#",
        "#.,...#",
        "#o...,#",
        "###E###",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'o': Prop("rat hole"),
        ',': Tile("bones"),
        '|': Prop("gnawed plinth"),
        'E': Entry,
    },
)
