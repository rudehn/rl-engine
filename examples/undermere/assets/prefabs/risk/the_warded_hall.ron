// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// Warding glyphs that cry out when crossed, waking the floor; an altar
// beyond: `effects/minds.rs`'s own `WakeFloor`, carved where it is seen
// and understood rather than hidden.
(
    name: "The Warded Hall",
    ground: "hall floor",
    rows: [
        "#######",
        "#.....#",
        "#..g..#",
        "#..A..#",
        "###E###",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'g': Prop("warding glyph"),
        'A': Item(tag: "staff", count: 1, band: 1),
        'E': Entry,
    },
)
