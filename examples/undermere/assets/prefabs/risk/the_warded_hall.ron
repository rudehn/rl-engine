// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for; see `treasure_room.ron` for the full field list.
//
// An altar at the head of a candlelit hall, and a line of warding glyphs
// across it in plain sight: cross them and they cry out, and every sleeper
// on the floor wakes knowing where the crosser stands, by `WakeFloor`.
(
    name: "The Warded Hall",
    ground: "hall floor",
    rows: [
        "#########",
        "#...A...#",
        "#i.....i#",
        "#:::::::#",
        "#.......#",
        "#.......#",
        "####E####",
    ],
    legend: {
        '#': Tile("hall wall"),
        '.': Tile("hall floor"),
        'A': Prop("offering altar"),
        'i': Prop("candelabra"),
        ':': Prop("warding glyph"),
        'E': Entry,
    },
)
