// A mini-boss's lair: the Widow's den, drawn on one floor of her own 4-6. A
// cave choked with web (slow to cross, burns away to the moss under it),
// and her egg sacs either side of her, which hatch two cave spiders when
// struck or stepped beside (`src/tricks.rs`'s `hatch_beside`, and
// `effects/bodies.rs`'s `Hatch` for a sac a blow instead breaks). Grown as
// an area of its own, through the one entry at the foot of the den.
(
    name: "the Widow",
    ground: "moss",
    turn: Quarter,
    mirror: Both,
    rows: [
        "###############",
        "#.............#",
        "#..\"...\"...\"..#",
        "#.............#",
        "#..e.......e..#",
        "#......W......#",
        "#..e.......e..#",
        "#.............#",
        "#..\"...\"...\"..#",
        "#.............#",
        "#######E#######",
    ],
    legend: {
        '#': Tile("cave wall"),
        '.': Tile("moss"),
        '"': Tile("web"),
        'e': Prop("egg sac"),
        'W': Monster(monster: "the Widow"),
        'E': Entry,
    },
)
