// A mini-boss's lair: the Forgemaster's forge, drawn on one floor of his own
// 7-9. An anvil at its heart, racks either side, lava channels crossing
// it, and his three fire imps, `led` over him as his band comes together.
// Grown as an area of its own, through the one entry at the foot of the
// forge.
(
    name: "the Forgemaster",
    ground: "ash",
    rows: [
        "#################",
        "#.......i.......#",
        "#..k.........k..#",
        "#LLLLL.....LLLLL#",
        "#...............#",
        "#.......a.......#",
        "#.......F.......#",
        "#...............#",
        "#..i.........i..#",
        "#...............#",
        "#########E#######",
    ],
    legend: {
        '#': Tile("forge wall"),
        '.': Tile("ash"),
        'L': Tile("lava"),
        'k': Prop("rack"),
        'a': Prop("anvil"),
        'F': Monster(monster: "the Forgemaster"),
        'i': Monster(monster: "fire imp"),
        'E': Entry,
    },
)
