// A prefab: a piece of a place, drawn as rows of glyphs, and what each glyph
// stands for. The chain that builds a place in `src/dungeon.rs` asks for it by
// name and says where it goes; the engine fills its slots on the arrival that
// built the place.
//
// Every field:
//   name:   the piece's name, which a chain asks for
//   ground: the tile painted under every slot; required when the legend has any
//           slot, and it must be a tile a monster can stand on. The chain then
//           stands each slot on the floor drawn round it (`dungeon::Underfoot`),
//           so a table stands on the planks of its room and a lamp post on the
//           grass of its verge
//   rows:   the piece, one string per row, all the same width; a space is left as
//           the map had it, and every other glyph must be in the legend. A row is
//           a raw string fenced with ten `#`, one more than the longest run of
//           wall after a tuft of grass, so the grass's `"` needs no escaping and
//           the picture stays as drawn
//   legend: glyph to what it stands for, one of
//     Tile("name")                          a tile: "grass" | "cobbles" | "road" |
//                                           "planks" | "garden" | "timber wall" |
//                                           "stone wall" | "lit window" | "tree" |
//                                           "shallows" | "lake" | "standing stone" |
//                                           "gate" | "door" | "open door", and each
//                                           band's tiles, as `assets/tiles.ron` lists
//     Prop("name")                          a prop from props.ron
//     Item(item: "item", count: 1)          that item from items.ron; count is 1 or
//                                           a range, count: (fewest, most)
//     Item(tag: "tag", count: 1, band: 0)   drawn from item_spawns.ron by tag at the
//                                           place's band plus band; count is
//                                           separate draws
//     Monster(monster: "monster")           that monster from monsters.ron
//     Monster(role: "role", band: 0)        drawn for a role; Undermere has no
//                                           roles yet, so none is written
//     Mark                                  a position the game finds by this glyph
//                                           and fills itself
//   A monster at a slot holds that cell as its post.
//
// Mereholt, the whole town: the map it stands on is this piece and nothing else,
// so a run always comes to the same town. The square at its middle, with the
// well, and round it the tavern, the smithy, the apothecary, the temple, the
// curio shop and the houses, each with a door that opens and shuts and nothing
// inside to meet yet; gardens and a lane to the west, the north road out, and
// the shore of the black lake to the south. A causeway runs out over the water
// to the island, where a ring of standing stones holds the Drowned Gate.
//
// `@` is where a run arrives, a mark on the cobbles south of the well. Every
// other mark is where one of the town's people stands on the first arrival,
// found by the post `townsfolk.ron` gives them. The keepers: `S` the smith beside
// the anvil, `Y` the apothecary in the west building and `D` the curio dealer in
// the south-east one, each on the door's side of their counter, `P` the priest
// beside the altar, and `I` the innkeeper beside the tavern's counter. An offer
// is taken up from beside its actor, so each stands where the floor reaches them,
// never behind a counter. The townsfolk: `U` the drunk at the tavern door, `G`
// the gatewarden at the causeway's head, `N` the fishwife on the shore, `R` the
// gravedigger in the gardens, and where the two who walk set out from, `M` the
// lamplighter beside a lamp post and `C` the child on the square. The three `x`
// in the tavern, one beside each of its tables, are where the swords for hire
// wait, three new ones on every arrival, stood there by `src/mercenaries/`.
// The houses stay empty. The gate is a tile, `*`, and the town's one: the chain reports it as the
// town's way on, and the ways through stand the gate there on the first arrival.
// Lit windows and lamp posts are what the dusk is lit by, and `light.rs` lights
// them.
(
    name: "Mereholt",
    ground: "cobbles",
    rows: [
        r##########"TTTTT""TTTTTT"TTTT"T"TTTTT"T""T,,,TTT"TT"TTTTTTT"TTT"TT"TTTTTTTT"##########,
        r##########"TTT"T""T""T"TT""""TT"""""""T""T,,,"T"TT"""TT"T""""""""""T""T"""T"##########,
        r##########"T"###w#####"""""""###w#####w###,,,"""""""===w===w===""""""""""TT"##########,
        r##########"TT#h_____t#"""""""#bBBB__x___H#,,,"""""""=FF______s=""###w###"TT"##########,
        r##########"TT#_______#"""""""#bBI___t__tx#,,,"""""""=____aS___=""#h____#""T"##########,
        r##########"TT#_____b_#"""""""#_______t___#,,,"""""""=________b=""#_____#"TT"##########,
        r##########"T"###+#####"""""""#_______x___#,,,"""""""====+======""#____b#"TT"##########,
        r##########"T"""",""""""""""""#w####+####w#,,,""""""L"""",""""""""###+###""T"##########,
        r##########"TT""",,,,,,,,,,,,,,,,,"",U""""",,,""""""""""",""",,,,,,,,,""""TT"##########,
        r##########"T"%%%%%%%%"""%%%%%%%","L.......................L"T""""""""""""TT"##########,
        r##########"TT"""""""""""%%%R%%%""..M........................"""====w====="T"##########,
        r##########"T"####w#####""""""""""..........................."""=_____c__=TT"##########,
        r##########"TT#s_____k_#""L"""""""........C....W............."""=__p___P_=TT"##########,
        r##########"T"#s___BBY_+,,,,,,,,,,...........................,,,+______A_="T"##########,
        r##########"T"#s_______#"""""""""".............@............."""=__p_____=TT"##########,
        r##########"TT####w#####""""""""""..........................."""=_____c__="T"##########,
        r##########"T""""""""""""""""""""""L.......................L""""====w====="T"##########,
        r##########"TT"""""""""""""""""""""""","""""""",,,,,,,,,""""""""""""""""""TT"##########,
        r##########"T""""""""""""""T""""""####+#w##"""",""""""",#####w#####"""""""TT"##########,
        r##########"T"""""""""""""""""""""#h______#"""",""""""",#________s#"""""T""T"##########,
        r##########"TT""T"""""""""""""""""#______t#"""L,""""""",+__DBB___s#"""""""TT"##########,
        r##########"T"""""""""""""""""""""#########"""",""T"""""#________s#""""""""T"##########,
        r##########"T"""""""""T"""""""""""""""""""""""",""""""""#####w#####"""""""TT"##########,
        r##########"TT"""""""""""""""""T""---"""""""""","""""""""""""""""-"""T""""TT"##########,
        r##########"T"""""""""""""""""""-------""""""""..G""""""""""""-------"""""TT"##########,
        r##########"-"""""-------""-------~~~----------..---""N"""-------~----------"##########,
        r##########"--------------------~~~~~~~--------..-------------~~~~~~~-------"##########,
        r##########"~-----~~~~~~~--~~~~~~~~~~~~~~~~~~~~..~~~------~~~~~~~~~~~~~~~~~~"##########,
        r##########"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~..~~~~~~~~~~~~~~~~~~~~~~~~~~~"##########,
        r##########"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~---"""---~~~~~~~~~~~~~~~~~~~~~~~"##########,
        r##########"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-"0"".."""0"-~~~~~~~~~~~~~~~~~~~~~"##########,
        r##########"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-"""""""""""""-~~~~~~~~~~~~~~~~~~~~"##########,
        r##########"~~~~~~~~~~~~~~~~~~~~~~~~~~~~--"0""""*""""0"--~~~~~~~~~~~~~~~~~~~"##########,
        r##########"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-"""""""""""""-~~~~~~~~~~~~~~~~~~~~"##########,
        r##########"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-"0"""0"""0"-~~~~~~~~~~~~~~~~~~~~~"##########,
        r##########"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~---"""---~~~~~~~~~~~~~~~~~~~~~~~"##########,
    ],
    legend: {
        '"': Tile("grass"),
        '.': Tile("cobbles"),
        ',': Tile("road"),
        '_': Tile("planks"),
        '%': Tile("garden"),
        '#': Tile("timber wall"),
        '=': Tile("stone wall"),
        'w': Tile("lit window"),
        '+': Tile("door"),
        'T': Tile("tree"),
        '-': Tile("shallows"),
        '~': Tile("lake"),
        '0': Tile("standing stone"),
        '*': Tile("gate"),
        '@': Mark,
        'S': Mark,
        'Y': Mark,
        'D': Mark,
        'P': Mark,
        'I': Mark,
        'G': Mark,
        'U': Mark,
        'N': Mark,
        'R': Mark,
        'M': Mark,
        'C': Mark,
        'x': Mark,
        'W': Prop("well"),
        'L': Prop("lamp post"),
        'F': Prop("forge"),
        'a': Prop("anvil"),
        's': Prop("shelf"),
        'b': Prop("barrel"),
        't': Prop("table"),
        'B': Prop("counter"),
        'H': Prop("hearth"),
        'h': Prop("bed"),
        'k': Prop("candelabra"),
        'c': Prop("candelabra"),
        'A': Prop("altar"),
        'p': Prop("pew"),
    },
)
