// A landmark: the Palace Gardens' hedge maze, the floor's first piece, laid
// at the centre of the map before anything grows (`assets/pool.ron`'s
// `Seeded([Center], Within('>'))`), the floor grown out from its three
// gaps in the outer hedge. The way down is at its heart, so every delve of a
// floor that holds it walks the maze: a court of flagstones lit by the pale
// blooms at its corners, two stone benches, and a ring someone left there.
// Two of its dead ends hold something for whoever takes the wrong turn: the
// remains of one who never found the heart, and what they carried.
//
// A prefab: see `assets/prefabs/reward/treasure_room.ron` for every field.
// Nothing in it has a right way up, so it may land in any facing.
(
    name: "The Hedge Maze",
    ground: "gravel",
    turn: Quarter,
    mirror: Both,
    rows: [
        "#######################",
        "#...#*#.....#.........#",
        "#.#.#.#.###.#.#.#####.#",
        "#.#...#.#...#.#...#...#",
        "#.###.#.#.###.###.#.###",
        "#...#.#.#...#..&#.#.#x#",
        "###.###.###.#####.#.#p#",
        "#...#...#*fff*#...#...#",
        "#.###.###fffff#.#.#####",
        "E...#...#ff>ff#.#*#...E",
        "#.#.###.#fbfbf#.###.#.#",
        "#.#...#.#*frf*#.....#.#",
        "#.###.#.#########.###.#",
        "#..*#.#.....#...#*#...#",
        "###.#.#####.#.#.###.#.#",
        "#&#.#.#.....#.#.....#.#",
        "#.#.#.#.#####.#######.#",
        "#...#.........#....*..#",
        "###########E###########",
    ],
    legend: {
        '#': Tile("hedge"),
        '.': Tile("gravel"),
        'f': Tile("flagstones"),
        '*': Tile("night blooms"),
        '>': Mark,
        'b': Prop("bench"),
        'r': Item(tag: "ring", count: 1),
        '&': Prop("broken statue"),
        'x': Prop("remains"),
        'p': Item(tag: "potion", count: 1, band: 1),
        'E': Entry,
    },
)
