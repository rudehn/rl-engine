// What stands in Mereholt and below it that is neither a monster nor a thing to
// carry: the town's furniture, the lights of the floors, the throne, and the
// chests found in the dungeon. Where each stands is a piece's in
// `assets/prefabs/`; what light it sheds is the game's, in `light.rs`, since
// the engine's props carry no light of their own.
//
// Every field (the ones marked "optional" may be left out):
//   name:      unique; the name the nearby rail and the look cursor show, and the
//              name a piece's `Prop("name")` asks for
//   glyph:     one character, and one the typeface in `assets/fonts/` has
//   color:     (r: 0..=255, g:, b:), the glyph's colour, as abilities.ron writes a look
//   layer:     optional; draw order among entities on one cell, default 1
//   blocks:    optional; whether it stands in the way, default false; nothing here
//              blocks sight, which the engine's props never do yet
//   health:    optional; what it takes to break it; absent, nothing can
//   offers:    optional; [(verb:, time:, needs:, effects: [...])]: verb is "open" or
//              "search", the engine's own, or "pull", "read" or "drink", Undermere's,
//              which `src/vaults.rs` answers; time is hundredths of a step; needs is a
//              tag the opener must carry
//   container: optional; (contents: [...], locked:, opened: (glyph:, color:)) where
//              contents is a list of rows, each either (item: "name", count:) for that
//              item, or (tag: "tag", count:, band:) for anything carrying the tag,
//              drawn from item_spawns.ron at the floor the container stands on plus
//              band (optional, 0 by default); count is n or (fewest, most), how many
//              of the item or how many draws of the tag; the tags are "weapon" |
//              "armor" | "potion" | "scroll" | "staff" | "wand" | "ring" | "gold" | "arrow" |
//              "light" | "thrown", as `items.ron` lists them, and a row asks only for a
//              tag something in item_spawns.ron carries; locked is the tag an
//              opener must carry; opened is the look once emptied
//   triggers:  optional; [(on:, area:, fires:, effects: [...], look:)], what it does at
//              the moments it answers: "entered" | "destroyed" or a moment a game
//              registers, written as in abilities.ron
//   hidden:    optional; (spot:) percent a turn to spot it while in sight
//
// Everything here but the containers, the egg sac, the triggered and hidden
// things and what offers to be pulled or read is scenery: it offers, holds and
// does nothing, so the engine leaves it off the list of what is nearby and the
// look cursor still names it.
#![enable(implicit_some)]
[
    // The town. A lamp post's lantern and a forge's fire are lit by `light.rs`.
    (name: "lamp post",  glyph: '|', color: (r: 240, g: 205, b: 130), blocks: true),
    (name: "well",       glyph: 'o', color: (r: 150, g: 155, b: 165), blocks: true),
    (name: "forge",      glyph: '&', color: (r: 255, g: 130, b: 50),  blocks: true),
    // The furniture blocks, in Mereholt's pieces and in the rooms
    // `assets/dressings.ron` dresses below, so a room is something to
    // fight round: `rl_mapgen::Dress` takes back any thing that would cut
    // a room or shut in a slot laid before it, so every cell a body can
    // stand on, and every item a dressing lays, stays reached.
    (name: "anvil",      glyph: 'n', color: (r: 125, g: 125, b: 135), blocks: true),
    (name: "shelf",      glyph: '=', color: (r: 150, g: 110, b: 70), blocks: true),
    (name: "barrel",     glyph: '0', color: (r: 165, g: 115, b: 60), blocks: true),
    (name: "table",      glyph: '-', color: (r: 170, g: 125, b: 80), blocks: true),
    (name: "counter",    glyph: '=', color: (r: 135, g: 95, b: 55),   blocks: true),
    (name: "hearth",     glyph: '&', color: (r: 255, g: 145, b: 60), blocks: true),
    (name: "bed",        glyph: '-', color: (r: 190, g: 170, b: 140), blocks: true),
    (name: "altar",      glyph: '_', color: (r: 235, g: 225, b: 190), blocks: true),
    (name: "pew",        glyph: '=', color: (r: 140, g: 100, b: 65), blocks: true),
    // Candles stand in the temple and in the crypts, and nothing trips on them.
    (name: "candelabra", glyph: 'i', color: (r: 255, g: 230, b: 160)),
    // A lantern hung from a hook or a prop of timber: the Cellars' few, and
    // the goblins' in the Old Mines.
    (name: "hanging lantern", glyph: 'i', color: (r: 230, g: 170, b: 90)),
    // A cold violet flame under glass, the Sunken Library's witchlight.
    (name: "witchlight", glyph: 'i', color: (r: 190, g: 150, b: 255)),

    // A brazier burns in the colour of the place it stands in, so its iron is
    // drawn near white and its own light colours it: orange in the halls,
    // blue-green before the throne.
    (name: "brazier",    glyph: '&', color: (r: 235, g: 225, b: 210), blocks: true),
    // A throne is a high-backed seat, not a block of wall: '#' read as a
    // piece of the hall's own wall left standing in the middle of it.
    (name: "throne",     glyph: 'Π', color: (r: 150, g: 195, b: 205), blocks: true),

    // A chest in the dungeon: a weapon, a piece of armor or both, maybe, and a
    // potion or two for certain, each drawn at the floor it stands on.
    (name: "chest", glyph: '=', color: (r: 190, g: 145, b: 70), blocks: true,
     container: (contents: [(tag: "weapon", count: (0, 1)), (tag: "armor", count: (0, 1)), (tag: "potion", count: (1, 2))],
                 opened: (glyph: '=', color: (r: 110, g: 85, b: 50))),
     offers: [(verb: "open", time: 100)]),

    // The five mini-bosses' lairs: Grubnak's banners, the Choirmaster's bone organ,
    // the Abbess's font, the Forgemaster's racks, and the Widow's egg sacs,
    // the one of these that is not scenery. One hit spends its one health,
    // and the `Hatch` effect its `destroyed` trigger lands is `effects/bodies.rs`'s
    // own; stepped beside rather than struck, `tricks::hatch_beside` lands
    // the same way, since a step beside it never breaks it.
    (name: "banner",     glyph: '|', color: (r: 210, g: 60, b: 50)),
    (name: "bone organ", glyph: 'n', color: (r: 220, g: 215, b: 195), blocks: true),
    (name: "font",       glyph: 'u', color: (r: 150, g: 195, b: 205), blocks: true),
    // Blocking, as the furniture above is: the Forgemaster's lair stands
    // its racks by hand, and the dressings stand them along walls.
    (name: "rack",       glyph: '=', color: (r: 110, g: 90, b: 70), blocks: true),
    (name: "egg sac", glyph: 'o', color: (r: 230, g: 230, b: 200), blocks: true, health: 1,
     triggers: [(on: "destroyed", effects: [(kind: "Hatch", args: (monster: "cave spider", count: 2))])]),

    // A lived-in dungeon. A camp's fire burns beside its
    // sleeping band, stood by `population::populate` rather than a piece,
    // so a game that spawns it directly, not through a slot, still shows
    // and lights nothing it was not given; shackles lie at a captive's
    // feet until it is freed, and are never taken off, since freeing
    // changes who the captive fights for rather than what is lying there.
    (name: "fire", glyph: '^', color: (r: 255, g: 120, b: 40), blocks: true),
    (name: "shackles", glyph: ',', color: (r: 150, g: 150, b: 160)),

    // The flavor pool's own fixed pieces, `assets/prefabs/flavor/`: a place
    // that says what it was, with nothing to take.
    (name: "cold firepit",  glyph: '^', color: (r: 110, g: 100, b: 95)),
    (name: "bedroll",       glyph: '-', color: (r: 130, g: 110, b: 85)),
    (name: "broken pot",    glyph: 'o', color: (r: 150, g: 110, b: 70)),
    (name: "remains",       glyph: '%', color: (r: 210, g: 205, b: 190)),
    (name: "broken statue", glyph: '&', color: (r: 150, g: 150, b: 155), blocks: true),
    (name: "shrine",        glyph: '_', color: (r: 190, g: 180, b: 150), blocks: true),
    (name: "offering bowl", glyph: 'o', color: (r: 190, g: 170, b: 110)),
    (name: "coal heap",     glyph: '^', color: (r: 40, g: 38, b: 36)),
    (name: "shovel",        glyph: '/', color: (r: 140, g: 120, b: 90)),
    (name: "ore cart",      glyph: '0', color: (r: 120, g: 95, b: 60), blocks: true),
    (name: "rail",          glyph: '=', color: (r: 110, g: 100, b: 95)),
    (name: "embalming slab", glyph: '-', color: (r: 170, g: 168, b: 175), blocks: true),
    (name: "jar",           glyph: 'o', color: (r: 165, g: 150, b: 120)),
    (name: "orrery",        glyph: '*', color: (r: 190, g: 150, b: 70), blocks: true),
    (name: "cracked bell",  glyph: 'n', color: (r: 140, g: 150, b: 150), blocks: true),
    (name: "fishing net",   glyph: '"', color: (r: 150, g: 140, b: 110)),
    (name: "creel",         glyph: 'o', color: (r: 150, g: 125, b: 85)),

    // The flavor dressings' own scenery, laid by `rl_mapgen::Dress` rather
    // than a fixed piece. The furniture among it blocks, as the town's
    // does: the drill yard's dummies and posts, a tomb row's sarcophagi, a
    // reading room's desks and a smithy's troughs. The rest is clutter on
    // the floor, walked over.
    (name: "chalk mark",    glyph: ':', color: (r: 220, g: 210, b: 180)),
    (name: "bench",         glyph: '-', color: (r: 150, g: 110, b: 70)),
    (name: "dice",          glyph: '.', color: (r: 220, g: 210, b: 190)),
    (name: "roots",         glyph: '"', color: (r: 110, g: 85, b: 55)),
    (name: "sack",          glyph: 'o', color: (r: 165, g: 140, b: 95)),
    (name: "footlocker",    glyph: '=', color: (r: 110, g: 90, b: 65)),
    (name: "straw dummy",   glyph: '&', color: (r: 190, g: 170, b: 110), blocks: true),
    (name: "practice post", glyph: '|', color: (r: 140, g: 115, b: 80), blocks: true),
    (name: "fungus stalk",  glyph: '!', color: (r: 90, g: 190, b: 160)),
    (name: "cocooned husk", glyph: '&', color: (r: 200, g: 195, b: 180)),
    (name: "empty egg case", glyph: 'o', color: (r: 210, g: 205, b: 180)),
    (name: "timber brace",  glyph: '|', color: (r: 140, g: 110, b: 75)),
    (name: "fallen beam",   glyph: '/', color: (r: 110, g: 85, b: 55)),
    (name: "ore vein",      glyph: '*', color: (r: 210, g: 180, b: 90)),
    (name: "skull",         glyph: 'o', color: (r: 215, g: 210, b: 195)),
    (name: "sarcophagus",   glyph: '=', color: (r: 170, g: 168, b: 175), blocks: true),
    (name: "desk",          glyph: '-', color: (r: 120, g: 95, b: 70), blocks: true),
    (name: "reading lamp",  glyph: 'i', color: (r: 180, g: 170, b: 140)),
    (name: "page drift",    glyph: '"', color: (r: 200, g: 195, b: 175)),
    (name: "ruined screen", glyph: '|', color: (r: 140, g: 150, b: 155)),
    (name: "shell heap",    glyph: 'o', color: (r: 200, g: 190, b: 170)),
    (name: "quench trough", glyph: '=', color: (r: 90, g: 90, b: 95), blocks: true),
    (name: "slag heap",     glyph: '^', color: (r: 90, g: 60, b: 45)),
    (name: "obsidian spire", glyph: '^', color: (r: 60, g: 50, b: 70)),
    (name: "midden",        glyph: '%', color: (r: 140, g: 125, b: 90)),

    // The reward pool's own dressed entries, `assets/dressings.ron`.
    (name: "lectern",       glyph: 'n', color: (r: 120, g: 95, b: 70)),

    // The reward pieces', `assets/prefabs/reward/`. A coin chest, a cache chest and a
    // spilled wagon hold what they say; a spring is drunk from once, its
    // draught a full mend, and a frost-rimed anvil tempers and a moonwell
    // tells of one thing, once, offered by `src/vaults/wells.rs` since each
    // chooses the thing first; each stands spent after; a reliquary and an
    // enchanter's altar hold their one thing; a chronicle and a dead
    // adventurer's scratched words are read, by `src/vaults.rs`.
    (name: "coin chest", glyph: '=', color: (r: 205, g: 175, b: 80), blocks: true,
     container: (contents: [(item: "gold coin", count: (3, 5))], opened: (glyph: '=', color: (r: 110, g: 95, b: 50))),
     offers: [(verb: "open", time: 100)]),
    // A hidden cache's chest: the dungeon's chest, its things two floors deeper.
    (name: "cache chest", glyph: '=', color: (r: 215, g: 170, b: 95), blocks: true,
     container: (contents: [(tag: "weapon", count: (0, 1), band: 2), (tag: "armor", count: (0, 1), band: 2), (tag: "potion", count: (1, 2), band: 2)],
                 opened: (glyph: '=', color: (r: 115, g: 90, b: 55))),
     offers: [(verb: "open", time: 100)]),
    (name: "overturned wagon", glyph: '&', color: (r: 140, g: 100, b: 60), blocks: true,
     container: (contents: [(tag: "weapon", count: 1, band: 1), (item: "gold coin", count: (1, 2))],
                 opened: (glyph: '&', color: (r: 90, g: 66, b: 42))),
     offers: [(verb: "open", time: 150)]),
    (name: "spilled crate", glyph: '=', color: (r: 150, g: 115, b: 70)),
    (name: "spring", glyph: '~', color: (r: 140, g: 215, b: 235), blocks: true,
     offers: [(verb: "drink", time: 100, effects: [(kind: "Mend", args: (roll: "12d10+120"))])]),
    (name: "dry spring", glyph: '~', color: (r: 70, g: 100, b: 110), blocks: true),
    (name: "frost-rimed anvil", glyph: 'n', color: (r: 175, g: 210, b: 230), blocks: true),
    (name: "cold anvil", glyph: 'n', color: (r: 110, g: 115, b: 125), blocks: true),
    (name: "moonwell", glyph: 'o', color: (r: 185, g: 185, b: 245), blocks: true),
    (name: "darkened moonwell", glyph: 'o', color: (r: 90, g: 90, b: 120), blocks: true),
    (name: "reliquary", glyph: '|', color: (r: 235, g: 205, b: 120), blocks: true,
     container: (contents: [(tag: "weapon", count: 1, band: 3)], opened: (glyph: '|', color: (r: 130, g: 115, b: 80))),
     offers: [(verb: "open", time: 100)]),
    (name: "enchanter's altar", glyph: '_', color: (r: 200, g: 160, b: 255), blocks: true,
     container: (contents: [(item: "scroll of enchanting", count: 1)], opened: (glyph: '_', color: (r: 110, g: 95, b: 135))),
     offers: [(verb: "open", time: 100)]),
    (name: "chronicle", glyph: 'b', color: (r: 190, g: 150, b: 95), blocks: true, offers: [(verb: "read", time: 100)]),
    (name: "scratched words", glyph: ':', color: (r: 200, g: 195, b: 180), offers: [(verb: "read", time: 100)]),
    // `src/decor.rs`'s own: a wall worth reading, carved by hands the
    // place no longer has, laid by the survey rather than any piece.
    (name: "wall inscription", glyph: '"', color: (r: 175, g: 170, b: 150), offers: [(verb: "read", time: 100)]),
    (name: "adventurer's remains", glyph: '%', color: (r: 225, g: 215, b: 190),
     container: (contents: [(tag: "potion", count: (1, 2)), (tag: "scroll", count: 1), (item: "gold coin", count: 1)],
                 opened: (glyph: '%', color: (r: 140, g: 132, b: 118))),
     offers: [(verb: "open", time: 150)]),

    // The risk-and-reward pieces', `assets/prefabs/risk/`. What a prize is
    // held in says what lifting it sets off, and `src/vaults/lifts.rs`
    // answers each by its name: the other cages shut, the rats pour from
    // their holes, the water rises through the grates, the planks give
    // way, the lintel nearer the way in falls. Each is stood down as a
    // shut or empty cage or a bare plinth once it has been answered.
    // A full cage is drawn as the kind of thing in it, a blade, a staff
    // or a ring, never as the wall's '#' it read as beside a wall; a shut
    // one keeps the bars.
    (name: "caged blade", glyph: ')', color: (r: 205, g: 210, b: 225), blocks: true,
     container: (contents: [(tag: "weapon", count: 1, band: 2)], opened: (glyph: '_', color: (r: 120, g: 120, b: 130))),
     offers: [(verb: "open", time: 100)]),
    (name: "caged staff", glyph: '/', color: (r: 205, g: 210, b: 225), blocks: true,
     container: (contents: [(tag: "staff", count: 1, band: 1)], opened: (glyph: '_', color: (r: 120, g: 120, b: 130))),
     offers: [(verb: "open", time: 100)]),
    (name: "caged ring", glyph: '=', color: (r: 205, g: 210, b: 225), blocks: true,
     container: (contents: [(tag: "ring", count: 1, band: 1)], opened: (glyph: '_', color: (r: 120, g: 120, b: 130))),
     offers: [(verb: "open", time: 100)]),
    (name: "shut cage", glyph: '#', color: (r: 105, g: 100, b: 110), blocks: true),
    (name: "empty cage", glyph: '_', color: (r: 120, g: 120, b: 130), blocks: true),
    (name: "gnawed plinth", glyph: '|', color: (r: 200, g: 175, b: 130), blocks: true,
     container: (contents: [(tag: "wand", count: 1, band: 1)], opened: (glyph: '|', color: (r: 110, g: 100, b: 85))),
     offers: [(verb: "open", time: 100)]),
    (name: "rat hole", glyph: 'o', color: (r: 95, g: 80, b: 70)),
    (name: "drowned altar", glyph: '_', color: (r: 120, g: 190, b: 200), blocks: true,
     container: (contents: [(tag: "armor", count: 1, band: 2)], opened: (glyph: '_', color: (r: 70, g: 100, b: 110))),
     offers: [(verb: "open", time: 100)]),
    (name: "iron grate", glyph: '≡', color: (r: 120, g: 125, b: 135)),
    (name: "teetering plinth", glyph: '|', color: (r: 175, g: 130, b: 90), blocks: true,
     container: (contents: [(tag: "staff", count: 1, band: 2)], opened: (glyph: '|', color: (r: 100, g: 80, b: 60))),
     offers: [(verb: "open", time: 100)]),
    (name: "keystone plinth", glyph: '|', color: (r: 215, g: 205, b: 180), blocks: true,
     container: (contents: [(tag: "ring", count: 1, band: 2)], opened: (glyph: '|', color: (r: 120, g: 115, b: 100))),
     offers: [(verb: "open", time: 100)]),
    (name: "cracked lintel", glyph: '∩', color: (r: 165, g: 150, b: 130)),
    (name: "bare plinth", glyph: '|', color: (r: 110, g: 105, b: 95), blocks: true),
    (name: "bare altar", glyph: '_', color: (r: 85, g: 105, b: 110), blocks: true),
    // A goblin stockade's palisade and the plunder heaped inside it.
    (name: "palisade", glyph: '#', color: (r: 140, g: 100, b: 55), blocks: true),
    (name: "loot pile", glyph: '*', color: (r: 225, g: 190, b: 90), blocks: true,
     container: (contents: [(item: "gold coin", count: (2, 3)), (tag: "weapon", count: 1), (tag: "potion", count: 1)],
                 opened: (glyph: '*', color: (r: 120, g: 100, b: 60))),
     offers: [(verb: "open", time: 150)]),
    // A spider's larder: the dead it wrapped, and what they carried.
    (name: "cocooned body", glyph: '&', color: (r: 225, g: 225, b: 210), blocks: true,
     container: (contents: [(tag: "potion", count: 1), (item: "gold coin", count: 1)], opened: (glyph: '%', color: (r: 150, g: 145, b: 130))),
     offers: [(verb: "open", time: 200)]),
    // A bone circle's ring: the dead who rise once any cell of it is
    // stepped on, every one of them at once, and the sigils between them.
    (name: "circle bones", glyph: '%', color: (r: 230, g: 225, b: 205),
     triggers: [(on: "entered", fires: 1, effects: [(kind: "Rise", args: (prop: "circle bones", monster: "skeleton", radius: 2))])]),
    (name: "grave sigil", glyph: ':', color: (r: 165, g: 100, b: 175),
     triggers: [(on: "entered", fires: 1, effects: [(kind: "Rise", args: (prop: "circle bones", monster: "skeleton", radius: 2))])]),
    // A warded hall's glyphs, in plain sight: crossed, they cry out and the
    // whole floor wakes and knows where the crosser stands.
    (name: "warding glyph", glyph: ':', color: (r: 235, g: 160, b: 60),
     triggers: [(on: "entered", fires: 1, effects: [(kind: "WakeFloor")])]),
    // Hidden plates: darts from the statues of a gallery, a vent of caustic
    // gas in a chamber's doorway, a vent of paralysing gas in a vestibule
    // that rouses what waits beyond, and embers under a tinder room's straw.
    // The dart plate and the two vents are also three of the seven traps
    // `assets/hidden.ron` lays on a floor's corridors and doorways; the
    // other four follow. Every trap fires once and stays sprung, and every
    // one is drawn '^' in its own colour, the one mark a player reads as a
    // trap: a net drawn '"' was lost among the glowcaps and the grass.
    (name: "dart plate", glyph: '^', color: (r: 160, g: 150, b: 140), hidden: (spot: 20),
     triggers: [(on: "entered", fires: 1, effects: [(kind: "Harm", args: (kind: "pierce", roll: "2d4"))])]),
    (name: "caustic vent", glyph: '^', color: (r: 130, g: 185, b: 95), hidden: (spot: 12),
     triggers: [(on: "entered", fires: 1, area: Burst(radius: 1), effects: [(kind: "Emit", args: (gas: "caustic", amount: 300))])]),
    (name: "paralysis vent", glyph: '^', color: (r: 200, g: 150, b: 200), hidden: (spot: 8),
     triggers: [(on: "entered", fires: 1, effects: [(kind: "Emit", args: (gas: "paralytic", amount: 200)), (kind: "Rouse", args: (radius: 10))])]),
    (name: "ember plate", glyph: '^', color: (r: 230, g: 130, b: 55), hidden: (spot: 15),
     triggers: [(on: "entered", fires: 1, area: Burst(radius: 1), effects: [(kind: "Ignite", args: (turns: 4))])]),
    // The floor's own traps besides: a glyph that cries out and wakes the
    // floor, a net that holds whoever is caught in it, a trapdoor to the
    // floor below (`src/effects/moving.rs`'s one fall), and a jet of fire.
    (name: "alarm glyph", glyph: '^', color: (r: 220, g: 120, b: 70), hidden: (spot: 16),
     triggers: [(on: "entered", fires: 1, effects: [(kind: "WakeFloor")])]),
    (name: "net trap", glyph: '^', color: (r: 175, g: 160, b: 120), hidden: (spot: 14),
     triggers: [(on: "entered", fires: 1, effects: [(kind: "Inflict", args: (status: "webbed", turns: 4))])]),
    (name: "trapdoor", glyph: '^', color: (r: 120, g: 95, b: 70), hidden: (spot: 12),
     triggers: [(on: "entered", fires: 1, effects: [(kind: "Fall")])]),
    (name: "fire jet", glyph: '^', color: (r: 255, g: 110, b: 40), hidden: (spot: 10),
     triggers: [(on: "entered", fires: 1, effects: [(kind: "Harm", args: (kind: "fire", roll: "3d4"))])]),
    // A loose flagstone with something put by under it, found and lifted:
    // "open", since a container is opened, where "search" is a body's. A coin
    // at least, so one found and lifted is never found for nothing.
    (name: "loose flagstone", glyph: ',', color: (r: 165, g: 155, b: 140), hidden: (spot: 10),
     container: (contents: [(item: "gold coin", count: (1, 2)), (tag: "potion", count: (0, 1))], opened: (glyph: ',', color: (r: 110, g: 105, b: 95))),
     offers: [(verb: "open", time: 100)]),
    // A sealed vault's lever, set in a wall somewhere else on its floor and
    // hidden until it is spotted; pulled, it raises the vault's gate.
    (name: "concealed lever", glyph: '/', color: (r: 175, g: 160, b: 125), hidden: (spot: 20), offers: [(verb: "pull", time: 100)]),
    (name: "pulled lever", glyph: '\\', color: (r: 140, g: 130, b: 105)),
    // A warded hall's altar, and what it holds.
    (name: "offering altar", glyph: '_', color: (r: 240, g: 215, b: 150), blocks: true,
     container: (contents: [(tag: "staff", count: 1, band: 1), (item: "gold coin", count: 1)], opened: (glyph: '_', color: (r: 130, g: 115, b: 85))),
     offers: [(verb: "open", time: 100)]),
    // A gallery's statues, flanking the hall its plates fire from.
    (name: "guardian statue", glyph: '&', color: (r: 150, g: 150, b: 165), blocks: true),

    // Where the adventurer last knelt with a waystone, which the Drowned Gate
    // leads back to: one in the whole run, moved by every call, stood by
    // `src/waystone.rs` rather than a piece, lit the gate's violet by
    // `light.rs` and drawn from memory once seen, as every prop is, so the map
    // shows where the gate will bring the adventurer back.
    (name: "gate mark", glyph: '◊', color: (r: 205, g: 150, b: 255)),
]
