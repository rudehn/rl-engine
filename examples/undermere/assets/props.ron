// What stands in Mereholt and below it that is neither a monster nor a thing to
// carry: the town's furniture, the lights of the floors, the throne, and the
// chests found in the dungeon. Where each stands is a piece's in
// `assets/prefabs/`; what light it sheds is the game's, in `light.rs`, since
// the engine's props carry no light of their own.
//
// Every field (the ones marked "optional" may be left out):
//   name:      unique; the name the nearby rail and the look cursor show, and the
//              name a piece's `Prop("name")` asks for
//   glyph:     one character, and one the typeface in `assets/fonts/` has
//   color:     (r: 0..=255, g:, b:), the glyph's colour, as abilities.ron writes a look
//   layer:     optional; draw order among entities on one cell, default 1
//   blocks:    optional; whether it stands in the way, default false; nothing here
//              blocks sight, which the engine's props never do yet
//   health:    optional; what it takes to break it; absent, nothing can
//   offers:    optional; [(verb:, time:, needs:, effects: [...])]: verb is "open" or
//              "search", the engine's own; time is hundredths of a step; needs is a
//              tag the opener must carry
//   container: optional; (contents: [...], locked:, opened: (glyph:, color:)) where
//              contents is a list of rows, each either (item: "name", count:) for that
//              item, or (tag: "tag", count:, band:) for anything carrying the tag,
//              drawn from item_spawns.ron at the floor the container stands on plus
//              band (optional, 0 by default); count is n or (fewest, most), how many
//              of the item or how many draws of the tag; the tags are "weapon" |
//              "armor" | "potion" | "scroll" | "staff" | "wand" | "ring" | "gold" | "arrow" |
//              "light" | "thrown", as `items.ron` lists them, and a row asks only for a
//              tag something in item_spawns.ron carries; locked is the tag an
//              opener must carry; opened is the look once emptied
//   triggers:  optional; [(on:, area:, fires:, effects: [...], look:)], what it does at
//              the moments it answers: "entered" | "destroyed" or a moment a game
//              registers, written as in abilities.ron
//   hidden:    optional; (spot:) percent a turn to spot it while in sight
//
// Everything here but the chest and the egg sac is scenery: it offers, holds
// and does nothing, so the engine leaves it off the list of what is nearby
// and the look cursor still names it.
#![enable(implicit_some)]
[
    // The town. A lamp post's lantern and a forge's fire are lit by `light.rs`.
    (name: "lamp post",  glyph: '|', color: (r: 240, g: 205, b: 130), blocks: true),
    (name: "well",       glyph: 'o', color: (r: 150, g: 155, b: 165), blocks: true),
    (name: "forge",      glyph: '&', color: (r: 255, g: 130, b: 50),  blocks: true),
    (name: "anvil",      glyph: 'n', color: (r: 125, g: 125, b: 135), blocks: true),
    (name: "shelf",      glyph: '=', color: (r: 150, g: 110, b: 70),  blocks: true),
    (name: "barrel",     glyph: '0', color: (r: 165, g: 115, b: 60),  blocks: true),
    (name: "table",      glyph: '-', color: (r: 170, g: 125, b: 80),  blocks: true),
    (name: "counter",    glyph: '=', color: (r: 135, g: 95, b: 55),   blocks: true),
    (name: "hearth",     glyph: '&', color: (r: 255, g: 145, b: 60),  blocks: true),
    (name: "bed",        glyph: '-', color: (r: 190, g: 170, b: 140), blocks: true),
    (name: "altar",      glyph: '_', color: (r: 235, g: 225, b: 190), blocks: true),
    (name: "pew",        glyph: '=', color: (r: 140, g: 100, b: 65),  blocks: true),
    // Candles stand in the temple and in the crypts, and nothing trips on them.
    (name: "candelabra", glyph: 'i', color: (r: 255, g: 230, b: 160)),

    // A brazier burns in the colour of the place it stands in, so its iron is
    // drawn near white and its own light colours it: orange in the halls,
    // blue-green before the throne.
    (name: "brazier",    glyph: '&', color: (r: 235, g: 225, b: 210), blocks: true),
    // A throne is a high-backed seat, not a block of wall: '#' read as a
    // piece of the hall's own wall left standing in the middle of it.
    (name: "throne",     glyph: 'Π', color: (r: 150, g: 195, b: 205), blocks: true),

    // A chest in the dungeon: a weapon, a piece of armor or both, maybe, and a
    // potion or two for certain, each drawn at the floor it stands on.
    (name: "chest", glyph: '=', color: (r: 190, g: 145, b: 70), blocks: true,
     container: (contents: [(tag: "weapon", count: (0, 1)), (tag: "armor", count: (0, 1)), (tag: "potion", count: (1, 2))],
                 opened: (glyph: '=', color: (r: 110, g: 85, b: 50))),
     offers: [(verb: "open", time: 100)]),

    // The five mini-bosses' lairs: Grubnak's banners, the Choirmaster's bone organ,
    // the Abbess's font, the Forgemaster's racks, and the Widow's egg sacs,
    // the one of these that is not scenery. One hit spends its one health,
    // and the `Hatch` effect its `destroyed` trigger lands is `effects/bodies.rs`'s
    // own; stepped beside rather than struck, `tricks::hatch_beside` lands
    // the same way, since a step beside it never breaks it.
    (name: "banner",     glyph: '|', color: (r: 210, g: 60, b: 50)),
    (name: "bone organ", glyph: 'n', color: (r: 220, g: 215, b: 195), blocks: true),
    (name: "font",       glyph: 'u', color: (r: 150, g: 195, b: 205), blocks: true),
    (name: "rack",       glyph: '=', color: (r: 110, g: 90, b: 70), blocks: true),
    (name: "egg sac", glyph: 'o', color: (r: 230, g: 230, b: 200), blocks: true, health: 1,
     triggers: [(on: "destroyed", effects: [(kind: "Hatch", args: (monster: "cave spider", count: 2))])]),

    // A lived-in dungeon. A camp's fire burns beside its
    // sleeping band, stood by `population::populate` rather than a piece,
    // so a game that spawns it directly, not through a slot, still shows
    // and lights nothing it was not given; shackles lie at a captive's
    // feet until it is freed, and are never taken off, since freeing
    // changes who the captive fights for rather than what is lying there.
    (name: "fire", glyph: '^', color: (r: 255, g: 120, b: 40), blocks: true),
    (name: "shackles", glyph: ',', color: (r: 150, g: 150, b: 160)),

    // The flavor pool's own fixed pieces, `assets/prefabs/flavor/`: a place
    // that says what it was, with nothing to take.
    (name: "cold firepit",  glyph: '^', color: (r: 110, g: 100, b: 95)),
    (name: "bedroll",       glyph: '-', color: (r: 130, g: 110, b: 85)),
    (name: "broken pot",    glyph: 'o', color: (r: 150, g: 110, b: 70)),
    (name: "remains",       glyph: '%', color: (r: 210, g: 205, b: 190)),
    (name: "broken statue", glyph: '&', color: (r: 150, g: 150, b: 155), blocks: true),
    (name: "shrine",        glyph: '_', color: (r: 190, g: 180, b: 150), blocks: true),
    (name: "offering bowl", glyph: 'o', color: (r: 190, g: 170, b: 110)),
    (name: "coal heap",     glyph: '^', color: (r: 40, g: 38, b: 36)),
    (name: "shovel",        glyph: '/', color: (r: 140, g: 120, b: 90)),
    (name: "ore cart",      glyph: '0', color: (r: 120, g: 95, b: 60), blocks: true),
    (name: "rail",          glyph: '=', color: (r: 110, g: 100, b: 95)),
    (name: "embalming slab", glyph: '-', color: (r: 170, g: 168, b: 175), blocks: true),
    (name: "jar",           glyph: 'o', color: (r: 165, g: 150, b: 120)),
    (name: "orrery",        glyph: '*', color: (r: 190, g: 150, b: 70), blocks: true),
    (name: "cracked bell",  glyph: 'n', color: (r: 140, g: 150, b: 150), blocks: true),
    (name: "fishing net",   glyph: '"', color: (r: 150, g: 140, b: 110)),
    (name: "creel",         glyph: 'o', color: (r: 150, g: 125, b: 85)),

    // The flavor dressings' own scenery, laid by `rl_mapgen::Dress` rather
    // than a fixed piece.
    (name: "chalk mark",    glyph: ':', color: (r: 220, g: 210, b: 180)),
    (name: "bench",         glyph: '-', color: (r: 150, g: 110, b: 70), blocks: true),
    (name: "dice",          glyph: '.', color: (r: 220, g: 210, b: 190)),
    (name: "roots",         glyph: '"', color: (r: 110, g: 85, b: 55)),
    (name: "sack",          glyph: 'o', color: (r: 165, g: 140, b: 95)),
    (name: "footlocker",    glyph: '=', color: (r: 110, g: 90, b: 65), blocks: true),
    (name: "straw dummy",   glyph: '&', color: (r: 190, g: 170, b: 110)),
    (name: "practice post", glyph: '|', color: (r: 140, g: 115, b: 80)),
    (name: "fungus stalk",  glyph: '!', color: (r: 90, g: 190, b: 160)),
    (name: "cocooned husk", glyph: '&', color: (r: 200, g: 195, b: 180)),
    (name: "empty egg case", glyph: 'o', color: (r: 210, g: 205, b: 180)),
    (name: "timber brace",  glyph: '|', color: (r: 140, g: 110, b: 75)),
    (name: "fallen beam",   glyph: '/', color: (r: 110, g: 85, b: 55), blocks: true),
    (name: "ore vein",      glyph: '*', color: (r: 210, g: 180, b: 90)),
    (name: "skull",         glyph: 'o', color: (r: 215, g: 210, b: 195)),
    (name: "sarcophagus",   glyph: '=', color: (r: 170, g: 168, b: 175), blocks: true),
    (name: "desk",          glyph: '-', color: (r: 120, g: 95, b: 70), blocks: true),
    (name: "reading lamp",  glyph: 'i', color: (r: 180, g: 170, b: 140)),
    (name: "page drift",    glyph: '"', color: (r: 200, g: 195, b: 175)),
    (name: "ruined screen", glyph: '|', color: (r: 140, g: 150, b: 155), blocks: true),
    (name: "shell heap",    glyph: 'o', color: (r: 200, g: 190, b: 170)),
    (name: "quench trough", glyph: '=', color: (r: 90, g: 90, b: 95), blocks: true),
    (name: "slag heap",     glyph: '^', color: (r: 90, g: 60, b: 45)),
    (name: "obsidian spire", glyph: '^', color: (r: 60, g: 50, b: 70), blocks: true),
    (name: "midden",        glyph: '%', color: (r: 140, g: 125, b: 90)),
]
