// What Mereholt's keepers may stock, and how a stocking is drawn. What a ware costs is
// its `price:` in `items.ron`; this file says only what is on a shelf.
//
// Every field:
//   levels:   the one level table every keeper's wares are rolled from, as the engine's
//             `LevelTable` reads it: [(bands: (shallowest, deepest), levels: [(level, weight)])],
//             the bands being tiers, no two rows sharing one, every level at or above nought.
//             Only a thing that takes levels rolls one, and what it rolls is added to the
//             least a found one of its kind is at uncursed: nought for a weapon or armor, a
//             ring's one, a staff's two, a wand's lowest `found_at`
//   keepers:  [(name:, buys:, always:, draws:, parts:)], one per keeper:
//     name:   "smith" | "apothecary" | "curio" | "temple"; who stands behind the counter,
//             the name `src/shops.rs` finds the keeper by
//     buys:   Anything | Tags([tag]), the kinds the keeper buys, always things with a price:
//             Anything buys whatever has one, Tags only things carrying one of the tags
//             from `items.ron`'s list, and Tags([]) nothing; a keeper stocks only what it buys
//     always: optional; [(item:, count:)] on every shelf of every stocking, that many
//     draws:  optional; how many of `parts` are drawn by weight a stocking, nought when
//             left out
//     parts:  optional; [(item:, bands:, weight:, chance:, group:, most:)], each drawn as
//             the engine's `LootTable` draws at a band, the band being the tier:
//       item:   a name in `items.ron`, with a price, so never gold, and never an artifact,
//               a scroll of aggravate monsters or one of summon monsters; one part a keeper
//       bands:  (first tier, last tier), both included, tiers running 1 to 5
//       weight: optional; how often against every other drawn part that applies at the
//               tier; required on a part without a chance, refused on one with
//       chance: optional; percent of the stockings at its tiers the part is on the shelf,
//               rolled on its own as a drop is, on top of the draws and never among them
//       group:  optional; (fewest, most) of it on the shelf when it is drawn; one when left out
//       most:   optional; the most times a weighted part is drawn in one stocking; no cap
//               when left out
(
    levels: [
        (bands: (1, 1), levels: [(0, 1)]),
        (bands: (2, 3), levels: [(0, 4), (1, 1)]),
        (bands: (4, 5), levels: [(0, 6), (1, 3), (2, 1)]),
    ],
    keepers: [
        // The smithy: six drawn, and arrows always.
        (name: "smith", buys: Tags(["weapon", "armor", "thrown"]), always: [(item: "arrow", count: 10)], draws: 6, parts: [
            (item: "dart", bands: (1, 5), weight: 1, group: (8, 8)),
            (item: "javelin", bands: (1, 5), weight: 1, group: (4, 4)),
            (item: "dagger", bands: (1, 5), weight: 1),
            (item: "sword", bands: (1, 5), weight: 1),
            (item: "spear", bands: (1, 5), weight: 1),
            (item: "mace", bands: (1, 5), weight: 1),
            (item: "axe", bands: (1, 5), weight: 1),
            (item: "bow", bands: (1, 5), weight: 1),
            (item: "leather armor", bands: (1, 5), weight: 1),
            (item: "helm", bands: (1, 5), weight: 1),
            (item: "shield", bands: (1, 5), weight: 1),
            (item: "scale mail", bands: (1, 5), weight: 1),
            (item: "broadsword", bands: (2, 5), weight: 1),
            (item: "war pike", bands: (2, 5), weight: 1),
            (item: "war hammer", bands: (2, 5), weight: 1),
            (item: "war axe", bands: (2, 5), weight: 1),
            (item: "chain mail", bands: (2, 5), weight: 1),
            (item: "banded mail", bands: (3, 5), weight: 1),
            (item: "splint mail", bands: (3, 5), weight: 1),
            (item: "plate armor", bands: (4, 5), weight: 1),
        ]),
        // The apothecary: potions of healing always, then four drawn.
        (name: "apothecary", buys: Tags(["potion", "scroll"]), always: [(item: "potion of healing", count: 3)], draws: 4, parts: [
            (item: "scroll of identify", bands: (1, 5), weight: 1),
            (item: "potion of darkness", bands: (1, 5), weight: 1),
            (item: "potion of confusion", bands: (1, 5), weight: 1),
            (item: "potion of incineration", bands: (1, 5), weight: 1),
            (item: "potion of paralysis", bands: (1, 5), weight: 1),
            (item: "scroll of remove curse", bands: (1, 5), weight: 1),
            (item: "potion of descent", bands: (1, 5), weight: 1),
            (item: "potion of fire immunity", bands: (1, 5), weight: 1),
            (item: "scroll of teleportation", bands: (1, 5), weight: 1),
            (item: "potion of haste", bands: (2, 5), weight: 1),
            (item: "scroll of magic mapping", bands: (2, 5), weight: 1),
            (item: "scroll of discord", bands: (2, 5), weight: 1),
            (item: "potion of extra healing", bands: (2, 5), weight: 1),
            (item: "scroll of recharging", bands: (3, 5), weight: 1),
        ]),
        // The curio shop: four drawn, rare and dear, and in a quarter of the deepest
        // stockings a potion of life besides.
        (name: "curio", buys: Anything, draws: 4, parts: [
            (item: "wand of plenty", bands: (1, 5), weight: 1),
            (item: "wand of beckoning", bands: (1, 5), weight: 1),
            (item: "wand of teleport other", bands: (2, 5), weight: 1),
            (item: "wand of polymorph", bands: (2, 5), weight: 1),
            (item: "staff of slowness", bands: (1, 5), weight: 1),
            (item: "staff of poison", bands: (1, 5), weight: 1),
            (item: "staff of blinking", bands: (2, 5), weight: 1),
            (item: "staff of conjuration", bands: (2, 5), weight: 1),
            (item: "staff of firebolt", bands: (2, 5), weight: 1),
            (item: "staff of lightning", bands: (2, 5), weight: 1),
            (item: "ring of light", bands: (2, 5), weight: 1),
            (item: "ring of stealth", bands: (2, 5), weight: 1),
            (item: "ring of wisdom", bands: (2, 5), weight: 1),
            (item: "ring of awareness", bands: (2, 5), weight: 1),
            (item: "ring of regeneration", bands: (3, 5), weight: 1),
            (item: "ring of reaping", bands: (3, 5), weight: 1),
            (item: "wand of domination", bands: (3, 5), weight: 1),
            (item: "scroll of enchanting", bands: (2, 5), weight: 1, most: 1),
            (item: "potion of strength", bands: (3, 5), weight: 1, most: 1),
            (item: "potion of life", bands: (5, 5), chance: 25),
        ]),
        // The temple of the Still Water: its rites are offerings, not wares, and its
        // waystones are stocked by a later part.
        (name: "temple", buys: Tags([])),
    ],
)
