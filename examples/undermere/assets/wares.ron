// What Mereholt's keepers may stock, and how a stocking is drawn. What a ware costs is
// its `price:` in `items.ron`; this file says only what is on a shelf.
//
// Every field:
//   levels:   the one level table every keeper's wares are rolled from, as the engine's
//             `LevelTable` reads it: [(bands: (shallowest, deepest), levels: [(level, weight)])],
//             the bands being tiers, no two rows sharing one, every level at or above nought.
//             Only a thing that takes levels rolls one, and what it rolls is added to the
//             least a found one of its kind is at uncursed: nought for a weapon or armor, a
//             ring's one, a staff's two, a wand's lowest `found_at`
//   keepers:  [(name:, buys:, purse:, always:, draws:, parts:)], one per keeper:
//     name:   "smith" | "apothecary" | "curio" | "temple"; who stands behind the counter,
//             the name `src/shops.rs` finds the keeper by
//     buys:   Anything | Tags([tag]), the kinds the keeper buys, always things with a price:
//             Anything buys whatever has one, Tags only things carrying one of the tags
//             from `items.ron`'s list, and Tags([]) nothing; a keeper stocks only what it buys
//     purse:  the gold the keeper holds for each tier, set afresh at each stocking and never
//             added to, so it holds this times the tier; gold paid to the keeper goes into
//             it and is gone at the next stocking; above nought unless it buys nothing
//     always: optional; [(item:, count:)] on every shelf of every stocking, that many
//     draws:  optional; how many of `parts` are drawn by weight a stocking, nought when
//             left out
//     parts:  optional; [(item: or tag:, bands:, weight:, chance:, group:)], each drawn as
//             the engine's `LootTable` draws at a band, the band being the tier, and never
//             one already on the shelf, so no item is on one shelf twice:
//       item:   a name in `items.ron`, with a price, so never gold, and never an artifact,
//               a scroll of aggravate monsters or one of summon monsters; one part a keeper,
//               and none of an item in `always`
//       tag:    instead of item: a tag some row of `item_spawns.ron` carries, drawn as a
//               chest's row for it is, by `LootTable::pick_tagged` over that table's rows
//               at the tier, among the items the keeper buys and may stock, so a shelf
//               holds whatever the dungeon can; drawn by weight, never on a chance; one
//               part a keeper for a tag; what it draws rolls its own level
//       bands:  (first tier, last tier), both included, tiers running 1 to 5
//       weight: optional; how often against every other drawn part that applies at the
//               tier; required on a part without a chance, refused on one with
//       chance: optional; percent of the stockings at its tiers the part is on the shelf,
//               rolled on its own as a drop is, on top of the draws and never among them
//       group:  optional; (fewest, most) of it on the shelf when it is drawn; one when left out
(
    levels: [
        (bands: (1, 1), levels: [(0, 1)]),
        (bands: (2, 3), levels: [(0, 4), (1, 1)]),
        (bands: (4, 5), levels: [(0, 6), (1, 3), (2, 1)]),
    ],
    keepers: [
        // The smithy: six drawn, and arrows always. Most of the shelf is drawn by kind, from
        // everything the dungeon lays of it at the tier, as a chest's row is; darts and
        // javelins stay named for the size of the handful.
        (name: "smith", buys: Tags(["weapon", "armor", "arrow", "thrown"]), purse: 200, always: [(item: "arrow", count: 10)], draws: 6, parts: [
            (item: "dart", bands: (1, 5), weight: 1, group: (8, 8)),
            (item: "javelin", bands: (1, 5), weight: 1, group: (4, 4)),
            (tag: "weapon", bands: (1, 5), weight: 6),
            (tag: "armor", bands: (1, 5), weight: 4),
            // Plate is laid from the sixth floor only, so it is named to be sold sooner.
            (item: "plate armor", bands: (4, 5), weight: 1),
        ]),
        // The apothecary: potions of healing always, then four drawn from every potion and
        // scroll the dungeon holds.
        (name: "apothecary", buys: Tags(["potion", "scroll"]), purse: 200, always: [(item: "potion of healing", count: 3)], draws: 4, parts: [
            (tag: "potion", bands: (1, 5), weight: 5),
            (tag: "scroll", bands: (1, 5), weight: 5),
        ]),
        // The curio shop: four drawn, rare and dear, and in a quarter of the deepest
        // stockings a potion of life besides. It buys the rare, so its purse is twice
        // the others', enough for an artifact's 400 from the first tier.
        (name: "curio", buys: Anything, purse: 400, draws: 4, parts: [
            (tag: "staff", bands: (1, 5), weight: 3),
            (tag: "wand", bands: (1, 5), weight: 3),
            (tag: "ring", bands: (1, 5), weight: 3),
            (item: "scroll of enchanting", bands: (2, 5), weight: 1),
            (item: "potion of strength", bands: (3, 5), weight: 1),
            (item: "potion of life", bands: (5, 5), chance: 25),
        ]),
        // The temple of the Still Water: its rites are offerings, not wares; its wares
        // are waystones, three on every shelf, and waystones are all it buys.
        (name: "temple", buys: Tags(["waystone"]), purse: 200, always: [(item: "waystone", count: 3)]),
    ],
)
