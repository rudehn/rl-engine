// What lies about on Undermere's floors before anyone has dropped anything: on
// which floors, and how often. What each thing is and does is `items.ron`; this is
// only where. What a kill drops is its kind's `drops` in `monsters.ron`, and the
// gold a floor holds is laid besides its things, in `finds.rs`.
//
// A floor's things are drawn a kind at a time: a kind by the weight `finds.rs`
// gives it, potions and scrolls most, then one of the rows whose item carries that
// kind's tag, by these weights. A chest asking for a tag draws among the same rows.
// So a weight here is only ever against the other things of its kind: a sword
// against the other weapons, never against a potion.
//
// Every field (the ones marked "optional" may be left out):
//   item:   a name from `items.ron`
//   bands:  (first, last), the floors the row applies on, both included
//   weight: how often it is drawn against every other row of its kind that applies
//           on a floor; only the ratio matters
//   group:  optional; (fewest, most) lying together where it is found, one when left
//           out
//
// An item may have several rows; one with no row is never found lying about. The
// engine sorts the rows by item name before it draws, so the order they are written
// in here changes nothing; adding or removing one does.
[
    // Potions, by the content sheet's weights out of a hundred, all but
    // three: healing most of all, then the three better thrown. Healing and
    // extra healing are below the sheet's 25 and 12, at 18 and 9, since
    // nothing else under the lake heals but a ring: at the sheet's, a
    // careful delve came to every floor to the eighth at four fifths of its
    // health (`tests/soak.rs`), and now what heals runs down as it goes.
    // Strength is weighted above the sheet's four, at ten, so that about
    // four turn up over a run, chests and all, as the sheet also asks: at
    // four, one does. Life only from floor six, and strength from floor two.
    (item: "potion of healing",       bands: (1, 10), weight: 18),
    (item: "potion of extra healing", bands: (1, 10), weight: 9),
    (item: "potion of strength",      bands: (2, 10), weight: 10),
    (item: "potion of life",          bands: (6, 10), weight: 2),
    (item: "potion of haste",         bands: (1, 10), weight: 6),
    (item: "potion of fire immunity", bands: (1, 10), weight: 6),
    (item: "potion of darkness",      bands: (1, 10), weight: 7),
    (item: "potion of descent",       bands: (1, 10), weight: 5),
    (item: "potion of incineration",  bands: (1, 10), weight: 11),
    (item: "potion of paralysis",     bands: (1, 10), weight: 11),
    (item: "potion of confusion",     bands: (1, 10), weight: 11),
    // Scrolls, out of a hundred: enchanting the commonest, besides the one
    // laid on every floor.
    (item: "scroll of enchanting",         bands: (1, 10), weight: 20),
    (item: "scroll of identify",           bands: (1, 10), weight: 15),
    (item: "scroll of teleportation",      bands: (1, 10), weight: 10),
    (item: "scroll of remove curse",       bands: (1, 10), weight: 8),
    (item: "scroll of recharging",         bands: (1, 10), weight: 8),
    (item: "scroll of magic mapping",      bands: (1, 10), weight: 10),
    (item: "scroll of discord",            bands: (1, 10), weight: 9),
    (item: "scroll of aggravate monsters", bands: (1, 10), weight: 10),
    (item: "scroll of summon monsters",    bands: (1, 10), weight: 10),
    // Staffs, at any depth, by Brogue's weights among them: the bolts that
    // burn most, then a blink, poison and slowness, and conjuring least.
    (item: "staff of firebolt",    bands: (1, 10), weight: 15),
    (item: "staff of lightning",   bands: (1, 10), weight: 15),
    (item: "staff of blinking",    bands: (1, 10), weight: 11),
    (item: "staff of poison",      bands: (1, 10), weight: 10),
    (item: "staff of slowness",    bands: (1, 10), weight: 10),
    (item: "staff of conjuration", bands: (1, 10), weight: 8),
    // Wands, at any depth, domination the rarest and plenty nearly so.
    (item: "wand of teleport other", bands: (1, 10), weight: 3),
    (item: "wand of polymorph",      bands: (1, 10), weight: 3),
    (item: "wand of beckoning",      bands: (1, 10), weight: 3),
    (item: "wand of plenty",         bands: (1, 10), weight: 2),
    (item: "wand of domination",     bands: (1, 10), weight: 1),
    // Rings, each as likely as another, at any depth.
    (item: "ring of regeneration", bands: (1, 10), weight: 1),
    (item: "ring of stealth",      bands: (1, 10), weight: 1),
    (item: "ring of light",        bands: (1, 10), weight: 1),
    (item: "ring of wisdom",       bands: (1, 10), weight: 1),
    (item: "ring of reaping",      bands: (1, 10), weight: 1),
    (item: "ring of awareness",    bands: (1, 10), weight: 1),
    // The weapons grow heavier with the depth: a dagger and a sword are
    // shallow finds, a war hammer a deep one.
    (item: "dagger",     bands: (1, 4),  weight: 3),
    (item: "dagger",     bands: (5, 10), weight: 1),
    (item: "sword",      bands: (1, 6),  weight: 3),
    (item: "sword",      bands: (7, 10), weight: 2),
    (item: "axe",        bands: (1, 10), weight: 2),
    (item: "spear",      bands: (1, 10), weight: 2),
    (item: "mace",       bands: (2, 10), weight: 2),
    (item: "bow",        bands: (2, 10), weight: 2),
    (item: "broadsword", bands: (3, 10), weight: 2),
    (item: "war axe",    bands: (4, 10), weight: 2),
    (item: "war pike",   bands: (4, 10), weight: 2),
    (item: "war hammer", bands: (5, 10), weight: 2),
    // And the armor with them: leather near the top, plate from floor six.
    (item: "leather armor", bands: (1, 3),  weight: 3),
    (item: "leather armor", bands: (4, 6),  weight: 1),
    (item: "scale mail",    bands: (1, 5),  weight: 2),
    (item: "scale mail",    bands: (6, 10), weight: 1),
    (item: "chain mail",    bands: (2, 4),  weight: 1),
    (item: "chain mail",    bands: (5, 10), weight: 2),
    (item: "banded mail",   bands: (4, 10), weight: 2),
    (item: "splint mail",   bands: (5, 10), weight: 2),
    (item: "plate armor",   bands: (6, 7),  weight: 1),
    (item: "plate armor",   bands: (8, 10), weight: 2),
    (item: "shield",        bands: (1, 10), weight: 2),
    (item: "helm",          bands: (1, 10), weight: 2),
    // What is thrown, by the handful: arrows most, for the bow, then darts,
    // the heavier javelins from floor three, and a torch to light the dark.
    (item: "arrow",   bands: (1, 10), weight: 4, group: (6, 12)),
    (item: "dart",    bands: (1, 10), weight: 3, group: (4, 8)),
    (item: "javelin", bands: (3, 10), weight: 2, group: (2, 4)),
    (item: "torch",   bands: (1, 10), weight: 1),
]
