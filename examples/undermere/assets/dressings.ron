// Dressings: what fills an area of any size that the pool's picks did not
// take, a legend and the rules for where its things go rather than rows.
// `atglyph::rules::dressing::load` reads this file; `atglyph::rules::dressing::check_pool`
// and `check_districts` hold it to `assets/pool.ron` and `assets/layout.ron`
// at load, in `dungeon.rs`.
//
// A list of dressings, each with every field:
//   name:    the dressing's name, which a pool's Dressed entry and a
//            biome's own list (`dungeon/biomes.rs::district_dressings`)
//            name it by
//   legend:  glyph to what it stands for, as a prefab's legend says it:
//     Tile("name")                          a tile from `assets/tiles.ron`
//     Prop("name")                          a prop from `assets/props.ron`
//     Item(item: "item", count: 1)          that item; count is 1 or
//                                           (fewest, most)
//     Item(tag: "tag", count: 1, band: 0)   drawn by tag at the place's
//                                           band plus band
//     Monster(monster: "monster")           that monster
//     Monster(role: "role", band: 0)        drawn for the role at the
//                                           place's band plus band
//   place:   the rules, laid in this order, each
//     (glyph: 'c', at: Walls, density_pct: 30)
//   with at one of
//     Walls              a cell with a wall straight beside it
//     Corners            a cell with walls on two sides at a right angle
//     Center              the cells farthest from every wall
//     Rows(aisle: 1)      lines along the area's longer side, aisle cells
//                         clear between two lines; aisle is 1 or more
//     Scatter             any cell of the area
//   and density_pct the share in a hundred, 1 to 100, of the cells the
//   rule offers that it fills
//   repaint: optional; (tile, pct): this share in a hundred, 1 to 100, of
//            the area's floor left clear is repainted with the tile,
//            which must be one a body can stand on
//
// Thirty are the spec's flavor "D" entries (`assets/pool.ron` draws some
// of them once a run through its budget; a biome's own list in
// `dungeon/biomes.rs` draws the same names far more often, for every room
// the pool did not take); four are the reward pool's "dressed" entries
// (Armory, Apothecary's Shelves, Scriptorium, Quartermaster's Store); and
// four are the Drowned Town's first wave's own, the Old Town's and the
// Harbour's, laid only by their biomes' lists.
#![enable(implicit_some)]
[
    // Shared flavor dressings: any biome, any floor unless noted.
    (
        name: "Collapsed Ceiling",
        legend: { 'b': Prop("fallen beam") },
        place: [(glyph: 'b', at: Scatter, density_pct: 15)],
        repaint: ("rubble", 35),
    ),
    (
        name: "Bone Scatter",
        legend: { 's': Prop("skull") },
        place: [(glyph: 's', at: Scatter, density_pct: 10)],
        repaint: ("bones", 30),
    ),
    // Floors one to six.
    (
        name: "Rat Midden",
        legend: { 'm': Prop("midden") },
        place: [(glyph: 'm', at: Corners, density_pct: 60)],
    ),
    (
        name: "Web-Choked Corners",
        legend: { 'w': Tile("web") },
        place: [(glyph: 'w', at: Corners, density_pct: 100)],
    ),
    // Floors one to eight.
    (
        name: "Seep",
        legend: { 'p': Tile("flooded floor") },
        place: [(glyph: 'p', at: Corners, density_pct: 50)],
        repaint: ("moss", 20),
    ),
    (
        name: "Chalk Warnings",
        legend: { 'c': Prop("chalk mark") },
        place: [(glyph: 'c', at: Walls, density_pct: 20)],
    ),

    // Upper Halls.
    (
        name: "Feasting Hall",
        legend: { 't': Prop("table"), 'b': Prop("bench") },
        place: [(glyph: 't', at: Rows(aisle: 1), density_pct: 60), (glyph: 'b', at: Rows(aisle: 1), density_pct: 40)],
    ),
    (
        name: "Guard Room",
        legend: { 'r': Prop("rack"), 't': Prop("table"), 'd': Prop("dice") },
        place: [
            (glyph: 'r', at: Walls, density_pct: 50),
            (glyph: 't', at: Center, density_pct: 30),
            (glyph: 'd', at: Scatter, density_pct: 5),
        ],
    ),

    // Cellars.
    (
        name: "Wine Cellar",
        legend: { 'b': Prop("barrel") },
        place: [(glyph: 'b', at: Rows(aisle: 1), density_pct: 50)],
    ),
    (
        name: "Root Cellar",
        legend: { 'r': Prop("roots"), 's': Prop("sack") },
        place: [(glyph: 'r', at: Walls, density_pct: 60), (glyph: 's', at: Scatter, density_pct: 20)],
        repaint: ("earth", 30),
    ),

    // Watch Barracks.
    (
        name: "Bunk Room",
        legend: { 'b': Prop("bed"), 'f': Prop("footlocker") },
        place: [(glyph: 'b', at: Walls, density_pct: 60), (glyph: 'f', at: Walls, density_pct: 30)],
    ),
    (
        name: "Mess Hall",
        legend: { 't': Prop("table"), 'h': Prop("hearth") },
        place: [(glyph: 't', at: Rows(aisle: 1), density_pct: 50), (glyph: 'h', at: Walls, density_pct: 10)],
    ),
    (
        name: "Drill Yard",
        legend: { 'd': Prop("straw dummy"), 'p': Prop("practice post"), 'r': Prop("rack") },
        place: [
            (glyph: 'd', at: Scatter, density_pct: 20),
            (glyph: 'p', at: Scatter, density_pct: 15),
            (glyph: 'r', at: Walls, density_pct: 20),
        ],
    ),

    // Fungal Deeps.
    (
        name: "Puffball Grove",
        legend: { 'f': Prop("fungus stalk") },
        place: [(glyph: 'f', at: Scatter, density_pct: 35)],
    ),
    (
        name: "Moss Garden",
        legend: {},
        repaint: ("moss", 80),
    ),

    // Spider Warrens.
    (
        name: "Husk Gallery",
        legend: { 'h': Prop("cocooned husk") },
        place: [(glyph: 'h', at: Walls, density_pct: 50)],
    ),
    (
        name: "Silk Curtains",
        legend: { 'w': Tile("web") },
        place: [(glyph: 'w', at: Rows(aisle: 2), density_pct: 80)],
    ),
    (
        name: "Old Egg Cases",
        legend: { 'e': Prop("empty egg case") },
        place: [(glyph: 'e', at: Scatter, density_pct: 25)],
    ),

    // Old Mines.
    (
        name: "Shored Gallery",
        legend: { 't': Prop("timber brace"), 'b': Prop("fallen beam") },
        place: [(glyph: 't', at: Walls, density_pct: 60), (glyph: 'b', at: Scatter, density_pct: 10)],
    ),
    (
        name: "Ore Seam",
        legend: { 'v': Prop("ore vein") },
        place: [(glyph: 'v', at: Walls, density_pct: 40)],
    ),

    // Catacombs.
    (
        name: "Ossuary Wall",
        legend: { 's': Prop("skull") },
        place: [(glyph: 's', at: Walls, density_pct: 70)],
    ),
    (
        name: "Tomb Row",
        legend: { 's': Prop("sarcophagus") },
        place: [(glyph: 's', at: Rows(aisle: 1), density_pct: 60)],
    ),

    // Sunken Library.
    (
        name: "Reading Room",
        legend: { 'd': Prop("desk"), 'l': Prop("reading lamp") },
        place: [(glyph: 'd', at: Rows(aisle: 1), density_pct: 50), (glyph: 'l', at: Rows(aisle: 1), density_pct: 20)],
    ),
    (
        name: "Fallen Stacks",
        legend: { 's': Prop("shelf"), 'p': Prop("page drift") },
        place: [(glyph: 's', at: Walls, density_pct: 50), (glyph: 'p', at: Scatter, density_pct: 25)],
    ),

    // Drowned Cathedral.
    (
        name: "Choir Stalls",
        legend: { 'p': Prop("pew"), 's': Prop("ruined screen") },
        place: [(glyph: 'p', at: Rows(aisle: 1), density_pct: 60), (glyph: 's', at: Center, density_pct: 10)],
    ),

    // Underlake.
    (
        name: "Shell Midden",
        legend: { 's': Prop("shell heap") },
        place: [(glyph: 's', at: Scatter, density_pct: 30)],
    ),

    // Forge of Embers.
    (
        name: "Smithy",
        legend: { 'a': Prop("anvil"), 'q': Prop("quench trough") },
        place: [(glyph: 'a', at: Walls, density_pct: 30), (glyph: 'q', at: Walls, density_pct: 30)],
    ),
    (
        name: "Slag Heaps",
        legend: { 's': Prop("slag heap") },
        place: [(glyph: 's', at: Scatter, density_pct: 35)],
    ),

    // Ashen Galleries.
    (
        name: "Obsidian Spires",
        legend: { 's': Prop("obsidian spire") },
        place: [(glyph: 's', at: Center, density_pct: 20)],
    ),
    (
        name: "Cinder Drifts",
        legend: {},
        repaint: ("ash", 70),
    ),

    // The reward pool's own dressed entries.
    (
        name: "Armory",
        legend: { 'w': Item(tag: "weapon", count: 1, band: 1), 'a': Item(tag: "armor", count: 1, band: 1) },
        place: [(glyph: 'w', at: Walls, density_pct: 5), (glyph: 'a', at: Walls, density_pct: 5)],
    ),
    (
        name: "Apothecary's Shelves",
        legend: { 's': Prop("shelf"), 'p': Item(tag: "potion", count: 1) },
        place: [(glyph: 's', at: Walls, density_pct: 50), (glyph: 'p', at: Walls, density_pct: 6)],
    ),
    (
        name: "Scriptorium",
        legend: { 'l': Prop("lectern"), 's': Item(tag: "scroll", count: 1) },
        place: [(glyph: 'l', at: Rows(aisle: 1), density_pct: 50), (glyph: 's', at: Rows(aisle: 1), density_pct: 6)],
    ),
    (
        name: "Quartermaster's Store",
        legend: { 'a': Item(tag: "arrow", count: (2, 4)), 't': Item(tag: "thrown", count: (2, 4)), 'b': Item(item: "bow", count: 1) },
        place: [
            (glyph: 'a', at: Walls, density_pct: 6),
            (glyph: 't', at: Walls, density_pct: 6),
            (glyph: 'b', at: Scatter, density_pct: 4),
        ],
    ),

    // The Palace grounds' first wave. The Royal Wood: black trees fallen and
    // gone pale, moss glowing on them; and where the hunt once camped.
    (
        name: "Deadfall",
        legend: { 'l': Prop("fallen log") },
        place: [(glyph: 'l', at: Scatter, density_pct: 6)],
        repaint: ("glowmoss", 12),
    ),
    (
        name: "Hunters' Camp",
        legend: { 't': Prop("rotted tent"), 'f': Prop("cold firepit") },
        place: [(glyph: 'f', at: Center, density_pct: 10), (glyph: 't', at: Walls, density_pct: 12)],
    ),
    // The Palace Gardens: clipped trees in rows along a lawn, a fountain at
    // a lawn's middle with its water spilt round it, and the menagerie's
    // broken cages along the walls, the straw in them long rotted.
    (
        name: "Topiary Walk",
        legend: { 't': Prop("topiary") },
        place: [(glyph: 't', at: Rows(aisle: 2), density_pct: 30)],
    ),
    (
        name: "Fountain Court",
        legend: { 'f': Prop("fountain") },
        place: [(glyph: 'f', at: Center, density_pct: 20)],
        repaint: ("basin", 12),
    ),
    (
        name: "Broken Cages",
        legend: { 'c': Prop("broken cage") },
        place: [(glyph: 'c', at: Walls, density_pct: 40)],
        repaint: ("straw", 30),
    ),
    // The Drowned Town's first wave. The Old Town's houses, left as their
    // people left them, a cask in the corner and a table, and nothing in
    // it a lane or a square would not hold as well, since a biome's
    // dressings fall on any of its areas; its market's stalls in rows; the Harbour's net
    // lofts and its cargo, stacked on the quays for a ship that never came.
    (
        name: "Empty House",
        legend: { 't': Prop("table"), 'r': Prop("barrel"), 's': Prop("sack") },
        place: [(glyph: 'r', at: Corners, density_pct: 40), (glyph: 't', at: Center, density_pct: 10), (glyph: 's', at: Scatter, density_pct: 3)],
    ),
    (
        name: "Market Stalls",
        legend: { 's': Prop("market stall"), 'c': Prop("spilled crate") },
        place: [(glyph: 's', at: Rows(aisle: 2), density_pct: 35), (glyph: 'c', at: Scatter, density_pct: 4)],
    ),
    (
        name: "Net Loft",
        legend: { 'n': Prop("fishing net"), 'c': Prop("creel"), 'r': Prop("barrel") },
        place: [(glyph: 'n', at: Walls, density_pct: 40), (glyph: 'c', at: Scatter, density_pct: 8), (glyph: 'r', at: Corners, density_pct: 50)],
    ),
    (
        name: "Cargo Stacks",
        legend: { 's': Prop("stacked crates"), 'r': Prop("barrel") },
        place: [(glyph: 's', at: Rows(aisle: 1), density_pct: 30), (glyph: 'r', at: Scatter, density_pct: 5)],
        repaint: ("wrack", 10),
    ),
]
