// What a floor of the Undermere hides, and how hard each thing is to see:
// its secret doors and hidden rooms, walled over by `atglyph::mapgen::HideOpenings`
// in `dungeon.rs`'s chain, its traps and its loose flagstones, laid by
// `src/traps.rs`, which loads this file. Floors one to nine hide things;
// the throne's floor hides nothing, so its fight is the one in plain
// sight. Every chance is a percent a turn while the thing is
// in sight, before `plugin.rs`'s spotting rules: whole within two cells,
// half out to seven, tripled on a turn spent waiting, and a ring of
// awareness's fifteen a level added to every roll.
//
// Every field:
//   secret_doors: (from:, count:, spot:), a loop's opening walled over, so a
//                 shortcut and never the way on
//     from:   the first floor that has any
//     count:  (fewest, most), drawn evenly for each floor from `from` on;
//             fewer where the floor has fewer loops safe to hide
//     spot:   the chance a turn, 0 to 100
//   hidden_rooms: (count:, spot:), a dead-end room's one door walled over, a
//                 pocket; a floor whose pool picks ask for a hidden room
//                 (`assets/pool.ron`'s `prefer: Hidden`) has at least one
//                 for each such pick, raised past `count`'s fewest
//     count:  (fewest, most), drawn evenly for each floor
//     spot:   the chance a turn, 0 to 100
//   traps: (counts:, kinds:), hidden props with a trigger, laid on a
//          floor's corridors, its chokepoints and its doorways, never
//          within six cells of the way in nor beside the way down, and
//          never inside a piece; each fires once and stays sprung. How
//          hard each is to see is the prop's own `hidden: (spot:)` in
//          `assets/props.ron`
//     counts: [(floors: (first, last), count: (fewest, most))], how many
//             a floor of each band gets, drawn evenly; a floor no row
//             covers gets none
//     kinds:  [(prop:, from:, until:)], a prop from `assets/props.ron`
//             with a hidden `entered` trigger, laid from floor `from` on
//             and, optionally, no deeper than `until`; each trap is drawn
//             evenly among the kinds the floor has unlocked
//   flagstones: (prop:, count:), a hidden container laid in a room, a
//               hidden room nothing else stands in first
//     prop:   a prop from `assets/props.ron`
//     count:  (fewest, most), drawn evenly for each floor
#![enable(implicit_some)]
(
    secret_doors: (from: 2, count: (1, 3), spot: 6),
    // Eight to a door's six: a hidden room's door ends a dead end, which
    // is walked past far less than a loop is, and at five the soak found
    // one room in six against a third of the doors.
    hidden_rooms: (count: (0, 2), spot: 8),
    traps: (
        counts: [
            (floors: (1, 1), count: (0, 1)),
            (floors: (2, 3), count: (1, 2)),
            (floors: (4, 6), count: (2, 4)),
            (floors: (7, 9), count: (3, 5)),
        ],
        kinds: [
            (prop: "dart plate", from: 1),
            (prop: "alarm glyph", from: 2),
            (prop: "net trap", from: 3),
            // Never on floor nine, so the throne is entered by its stairs.
            (prop: "trapdoor", from: 3, until: 8),
            (prop: "caustic vent", from: 4),
            (prop: "fire jet", from: 5),
            (prop: "paralysis vent", from: 6),
        ],
    ),
    flagstones: (prop: "loose flagstone", count: (0, 2)),
)
