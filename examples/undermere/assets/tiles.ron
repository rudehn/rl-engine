// How Undermere's tiles look in full light: Mereholt's, the doors the town and
// the floors hang, and each band's own walls and floors. The light that lands
// on a cell colours its glyph and its fill alike and memory fades both, so a
// tile is written once, as a white lamp would show it, and the dusk, a brazier
// or a pool of lava does the rest.
//
// Every field (the ones marked "optional" may be left out):
//   tile:    the tile's registered name, from `dungeon::Undermere::new`; every
//            registered tile needs a line, and the load says which is missing
//   glyph:   one character, and one the typeface in `assets/fonts/` has
//   fg:      (r, g, b) in 0..=1, the glyph's colour
//   bg:      optional; (r, g, b), the cell's fill; black when left out
//   vary:    optional; (brightness, hue), how far each cell strays from the
//            authored colour, 0..=1 each; none when left out
//   shimmer: optional; brightness drifting over time, 0..=1; still when left out
//   light:   optional; the light every cell of it sheds by itself, as the engine
//            writes every light, colour in bytes as props.ron writes one:
//            (intensity: 0..=255, radius: tiles, color: (r:, g:, b:), flicker:
//            0..=255, may be left out, darkens: true for a darkness, may be left
//            out); every light here is at intensity 200. None when left out
//
// Every tile here writes both colours and a `vary`, so no floor reads as
// wallpaper; water, lava and the gate shimmer as well. A strewn tile (rubble,
// bones) keeps the fill of the floor it lies on, so it reads as something on
// that floor rather than a hole in it. A wall has a fill lighter than every
// floor it bounds but the ones that glow, as Brogue draws a wall, so the shape
// of a house, a room or a cave reads at a glance, lit and remembered alike.
// What stops a body, the lake, deep water and lava, is drawn `≈`, and the
// water a body wades through `~`, so which is which reads before a step is
// spent on it; trees are `♣` and the gate is `Ω`. `%` is a body's alone, so a garden
// is `ψ` and a heap of fallen rock `∴`, and a lit window, which is seen through and
// still not walked through, is `▒`, glass set in a wall of `#`.
[
    // Mereholt, at dusk.
    (tile: "grass",          glyph: '"',  fg: (0.42, 0.62, 0.32), bg: (0.11, 0.19, 0.09), vary: (0.18, 0.06)),
    (tile: "cobbles",        glyph: '.',  fg: (0.66, 0.62, 0.56), bg: (0.27, 0.25, 0.23), vary: (0.12, 0.03)),
    (tile: "road",           glyph: ',',  fg: (0.64, 0.52, 0.38), bg: (0.25, 0.19, 0.13), vary: (0.14, 0.04)),
    (tile: "planks",         glyph: '.',  fg: (0.68, 0.5, 0.32),  bg: (0.33, 0.22, 0.13), vary: (0.1, 0.03)),
    (tile: "garden",         glyph: 'ψ',  fg: (0.5, 0.68, 0.3),   bg: (0.2, 0.15, 0.08),  vary: (0.16, 0.06)),
    (tile: "timber wall",    glyph: '#',  fg: (0.78, 0.6, 0.42),  bg: (0.54, 0.4, 0.26),  vary: (0.1, 0.03)),
    (tile: "stone wall",     glyph: '#',  fg: (0.76, 0.76, 0.8),  bg: (0.46, 0.46, 0.5),  vary: (0.08, 0.02)),
    // Firelight through the glass, a little way into the street and the room
    // behind it.
    (tile: "lit window",     glyph: '▒',  fg: (1.0, 0.86, 0.56),  bg: (0.75, 0.5, 0.2),   vary: (0.06, 0.03), shimmer: 0.08,
     light: (intensity: 200, radius: 3, color: (r: 255, g: 194, b: 107), flicker: 26)),
    (tile: "tree",           glyph: '♣',  fg: (0.3, 0.58, 0.3),   bg: (0.07, 0.15, 0.08), vary: (0.15, 0.06)),
    (tile: "shallows",       glyph: '~',  fg: (0.5, 0.72, 0.86),  bg: (0.13, 0.25, 0.36), vary: (0.1, 0.03),  shimmer: 0.25),
    (tile: "lake",           glyph: '≈',  fg: (0.32, 0.5, 0.78),  bg: (0.05, 0.11, 0.24), vary: (0.1, 0.03),  shimmer: 0.3),
    (tile: "standing stone", glyph: '0',  fg: (0.82, 0.8, 0.88),  bg: (0.3, 0.3, 0.36),   vary: (0.08, 0.02)),
    // The Drowned Gate, on the island and again where it lets out on floor
    // one: the one tile that is a way through, and it glows violet.
    (tile: "gate",           glyph: 'Ω',  fg: (0.92, 0.66, 1.0),  bg: (0.42, 0.18, 0.55), vary: (0.08, 0.04), shimmer: 0.35,
     light: (intensity: 200, radius: 5, color: (r: 191, g: 107, b: 255), flicker: 38)),
    // The doors of the town's houses and of the halls and crypts below.
    // The only bright gold glyph on a dark fill: every wall is a lighter
    // fill than every floor, in browns, greys and blues, so a door reads
    // as neither by the reverse and by a colour no wall or floor wears.
    (tile: "door",           glyph: '+',  fg: (1.0, 0.78, 0.26),  bg: (0.3, 0.14, 0.05),   vary: (0.06, 0.02)),
    (tile: "open door",      glyph: '\'', fg: (1.0, 0.78, 0.26),  bg: (0.2, 0.1, 0.05),    vary: (0.06, 0.02)),
    (tile: "bridge",         glyph: '=',  fg: (0.66, 0.5, 0.34),  bg: (0.3, 0.21, 0.13),  vary: (0.1, 0.03)),
    (tile: "iron bridge",    glyph: '=',  fg: (0.62, 0.62, 0.64), bg: (0.2, 0.2, 0.22),   vary: (0.08, 0.02)),

    // The Upper Halls, floors one and two.
    (tile: "hall wall",      glyph: '#',  fg: (0.7, 0.64, 0.56),  bg: (0.46, 0.41, 0.35), vary: (0.1, 0.02)),
    (tile: "hall floor",     glyph: '.',  fg: (0.56, 0.52, 0.47), bg: (0.22, 0.2, 0.18),  vary: (0.12, 0.02)),
    (tile: "rubble",         glyph: ',',  fg: (0.62, 0.57, 0.5),  bg: (0.22, 0.2, 0.18),  vary: (0.15, 0.03)),
    // `decor::BloodTrail`'s own, on any floor: a strewn tile like rubble
    // and bones, so it keeps the fill of the floor it lies on.
    (tile: "blood",          glyph: ',',  fg: (0.55, 0.1, 0.12),  bg: (0.22, 0.2, 0.18),  vary: (0.12, 0.04)),

    // The Cellars, floors one and two's other biome.
    (tile: "cellar wall",    glyph: '#',  fg: (0.62, 0.54, 0.42), bg: (0.4, 0.33, 0.24),  vary: (0.1, 0.02)),
    (tile: "cellar floor",   glyph: '.',  fg: (0.48, 0.42, 0.32), bg: (0.18, 0.15, 0.11), vary: (0.12, 0.02)),
    (tile: "earth",          glyph: '.',  fg: (0.46, 0.37, 0.25), bg: (0.16, 0.12, 0.08), vary: (0.16, 0.03)),

    // The Watch Barracks, floors one and two's third biome.
    (tile: "barracks wall",  glyph: '#',  fg: (0.74, 0.58, 0.38), bg: (0.48, 0.35, 0.2),  vary: (0.1, 0.02)),
    (tile: "barracks floor", glyph: '.',  fg: (0.58, 0.46, 0.3),  bg: (0.24, 0.18, 0.1),  vary: (0.12, 0.02)),

    // The Fungal Deeps, floors five and six.
    (tile: "cave wall",      glyph: '#',  fg: (0.52, 0.65, 0.58), bg: (0.32, 0.42, 0.37), vary: (0.12, 0.04)),
    (tile: "moss",           glyph: '.',  fg: (0.38, 0.66, 0.5),  bg: (0.08, 0.18, 0.13), vary: (0.18, 0.06)),
    // A soft teal, a step or so round it, so a clump of them is a pool of light
    // and a lone one a mark in the dark.
    (tile: "glowcaps",       glyph: '"',  fg: (0.55, 1.0, 0.9),   bg: (0.1, 0.34, 0.29),  vary: (0.12, 0.05), shimmer: 0.15,
     light: (intensity: 200, radius: 2, color: (r: 102, g: 255, b: 217))),

    // The Spider Warrens, floors five and six's other biome: truly
    // dark, so pale rock rather than a colour of its own.
    (tile: "warren wall",    glyph: '#',  fg: (0.54, 0.52, 0.56), bg: (0.34, 0.32, 0.36), vary: (0.1, 0.03)),
    (tile: "warren floor",   glyph: '.',  fg: (0.4, 0.38, 0.42),  bg: (0.12, 0.11, 0.13), vary: (0.12, 0.03)),

    // The Old Mines, floors five and six's third biome.
    (tile: "mine wall",      glyph: '#',  fg: (0.68, 0.6, 0.4),   bg: (0.44, 0.38, 0.22), vary: (0.12, 0.03)),
    (tile: "mine floor",     glyph: '.',  fg: (0.5, 0.44, 0.28),  bg: (0.2, 0.17, 0.08),  vary: (0.14, 0.03)),

    // The Catacombs, floors five and six's first biome.
    (tile: "crypt wall",     glyph: '#',  fg: (0.63, 0.63, 0.71), bg: (0.38, 0.38, 0.46), vary: (0.08, 0.02)),
    (tile: "crypt floor",    glyph: '.',  fg: (0.56, 0.56, 0.64), bg: (0.16, 0.16, 0.21), vary: (0.1, 0.02)),
    (tile: "bones",          glyph: ',',  fg: (0.9, 0.88, 0.8),   bg: (0.16, 0.16, 0.21), vary: (0.12, 0.03)),

    // The Sunken Library, floors three and four.
    (tile: "library wall",   glyph: '#',  fg: (0.66, 0.6, 0.76),  bg: (0.42, 0.37, 0.52), vary: (0.08, 0.02)),
    (tile: "library floor",  glyph: '.',  fg: (0.52, 0.46, 0.64), bg: (0.2, 0.17, 0.3),   vary: (0.1, 0.02)),

    // The Drowned Cathedral, floors three and four's other biome.
    (tile: "cathedral wall", glyph: '#',  fg: (0.6, 0.74, 0.8),   bg: (0.36, 0.47, 0.53), vary: (0.08, 0.02)),
    (tile: "marble",         glyph: '.',  fg: (0.72, 0.78, 0.82), bg: (0.2, 0.23, 0.26),  vary: (0.08, 0.02)),
    (tile: "flooded floor",  glyph: '~',  fg: (0.48, 0.7, 0.84),  bg: (0.11, 0.22, 0.32), vary: (0.1, 0.03),  shimmer: 0.25),
    (tile: "deep water",     glyph: '≈',  fg: (0.3, 0.48, 0.74),  bg: (0.03, 0.08, 0.2),  vary: (0.1, 0.03),  shimmer: 0.3),
    // Marble under a shaft of the pale light that comes down through the lake.
    (tile: "moonlit marble", glyph: '.',  fg: (0.9, 0.94, 1.0),   bg: (0.34, 0.39, 0.46), vary: (0.05, 0.02), shimmer: 0.1,
     light: (intensity: 200, radius: 2, color: (r: 184, g: 214, b: 255))),

    // The Underlake, floors seven and eight.
    (tile: "underlake wall", glyph: '#',  fg: (0.46, 0.64, 0.68), bg: (0.26, 0.42, 0.46), vary: (0.1, 0.03)),
    (tile: "underlake floor", glyph: '.', fg: (0.34, 0.54, 0.58), bg: (0.08, 0.2, 0.23),  vary: (0.12, 0.03)),
    // Lit from below, a cold blue-green, and every cell of a pool sheds it.
    (tile: "glowing shallows", glyph: '~', fg: (0.6, 0.95, 0.95),  bg: (0.1, 0.32, 0.36),  vary: (0.1, 0.03),  shimmer: 0.3,
     light: (intensity: 200, radius: 2, color: (r: 115, g: 230, b: 255), flicker: 26)),

    // The Forge of Embers, floor nine.
    (tile: "forge wall",     glyph: '#',  fg: (0.78, 0.52, 0.43), bg: (0.52, 0.32, 0.25), vary: (0.1, 0.03)),
    (tile: "ash",            glyph: '.',  fg: (0.58, 0.51, 0.47), bg: (0.21, 0.17, 0.15), vary: (0.12, 0.03)),
    // Orange, and every cell of a pool sheds it, so a pool lights its shore.
    (tile: "lava",           glyph: '≈',  fg: (1.0, 0.7, 0.25),   bg: (0.75, 0.22, 0.02), vary: (0.12, 0.05), shimmer: 0.4,
     light: (intensity: 200, radius: 3, color: (r: 255, g: 133, b: 38), flicker: 77)),
    (tile: "flagstones",     glyph: '.',  fg: (0.6, 0.56, 0.52),  bg: (0.24, 0.2, 0.18),  vary: (0.1, 0.02)),

    // The Ashen Galleries, floor nine's other biome.
    (tile: "cinder wall",    glyph: '#',  fg: (0.6, 0.48, 0.44),  bg: (0.36, 0.26, 0.22), vary: (0.1, 0.03)),
    (tile: "cinder floor",   glyph: '.',  fg: (0.44, 0.35, 0.3),  bg: (0.14, 0.1, 0.08),  vary: (0.12, 0.03)),

    // The Throne, floor ten.
    (tile: "throne wall",    glyph: '#',  fg: (0.52, 0.68, 0.72), bg: (0.33, 0.44, 0.48), vary: (0.08, 0.02)),
    (tile: "throne floor",   glyph: '.',  fg: (0.6, 0.7, 0.74),   bg: (0.12, 0.17, 0.2),  vary: (0.08, 0.02)),
    (tile: "dais",           glyph: '-',  fg: (0.74, 0.82, 0.86), bg: (0.19, 0.25, 0.29), vary: (0.06, 0.02)),
    (tile: "black pool",     glyph: '~',  fg: (0.28, 0.5, 0.6),   bg: (0.02, 0.07, 0.11), vary: (0.08, 0.03), shimmer: 0.2),
    // The five mini-bosses' lairs. Four reuse their own host band's wall and
    // floor; only Grubnak's hall and the Widow's web are new, since no
    // band his own floors fall in is a hall, and no band has anything
    // like a web.
    (tile: "goblin hall wall",  glyph: '#', fg: (0.7, 0.55, 0.3),   bg: (0.35, 0.25, 0.12), vary: (0.08, 0.03)),
    (tile: "goblin hall floor", glyph: '.', fg: (0.55, 0.45, 0.25), bg: (0.22, 0.16, 0.08), vary: (0.1, 0.03)),
    (tile: "web",               glyph: '"', fg: (0.85, 0.85, 0.88), bg: (0.12, 0.14, 0.13),  vary: (0.06, 0.02)),
    // The risk-and-reward pieces', on any floor they stand on. A vault's door
    // is iron-bound and gilt where a plain door is bare wood, and a sealed
    // vault's gate is a slab of the stone round it, so each is seen as
    // something other than the floor's other doors before it is understood.
    (tile: "vault door",        glyph: '+', fg: (0.95, 0.78, 0.36), bg: (0.3, 0.24, 0.18),   vary: (0.06, 0.02)),
    (tile: "open vault door",   glyph: '\'', fg: (0.95, 0.78, 0.36), bg: (0.2, 0.16, 0.12), vary: (0.06, 0.02)),
    (tile: "carved door",       glyph: '+', fg: (0.88, 0.72, 0.5),  bg: (0.36, 0.2, 0.22),   vary: (0.08, 0.02)),
    (tile: "open carved door",  glyph: '\'', fg: (0.88, 0.72, 0.5), bg: (0.24, 0.14, 0.15), vary: (0.08, 0.02)),
    (tile: "stone gate",        glyph: '+', fg: (0.78, 0.78, 0.82), bg: (0.4, 0.4, 0.44),    vary: (0.06, 0.02)),
    (tile: "raised gate",       glyph: '\'', fg: (0.7, 0.7, 0.74),  bg: (0.18, 0.18, 0.2),  vary: (0.06, 0.02)),
    (tile: "straw",             glyph: '"', fg: (0.86, 0.74, 0.4),  bg: (0.24, 0.19, 0.1),   vary: (0.14, 0.04)),
    (tile: "rotten planks",     glyph: '=', fg: (0.58, 0.44, 0.3),  bg: (0.2, 0.14, 0.09),   vary: (0.16, 0.04)),
    (tile: "hole",              glyph: ':', fg: (0.22, 0.2, 0.22),  bg: (0.0, 0.0, 0.0),     vary: (0.1, 0.02)),
    (tile: "sunken causeway",   glyph: '~', fg: (0.5, 0.66, 0.74),  bg: (0.12, 0.2, 0.26),   vary: (0.1, 0.03),  shimmer: 0.2),
    (tile: "fallen rock",       glyph: '∴', fg: (0.72, 0.68, 0.62), bg: (0.4, 0.37, 0.33),   vary: (0.14, 0.03)),

    // The Palace grounds' first wave: the Royal Wood and the Palace Gardens,
    // floors three and four beside the library and the cathedral.
    //
    // The Royal Wood: the kings' hunting forest, an age under the lake. Its
    // trees are black and their leaves have gone pale, so a tree is drawn as
    // its black limbs over the pale mass of its leaves, lighter than the black
    // loam under it as any wall is. Undergrowth is seen into but not through,
    // and the moss on the fallen wood glows.
    (tile: "black tree",     glyph: '♣',  fg: (0.07, 0.08, 0.08), bg: (0.34, 0.38, 0.34), vary: (0.1, 0.03)),
    (tile: "forest floor",   glyph: '.',  fg: (0.36, 0.38, 0.32), bg: (0.06, 0.07, 0.06), vary: (0.16, 0.04)),
    (tile: "pale grass",     glyph: '"',  fg: (0.62, 0.68, 0.58), bg: (0.08, 0.1, 0.08),  vary: (0.16, 0.04)),
    (tile: "game trail",     glyph: '.',  fg: (0.46, 0.4, 0.3),   bg: (0.11, 0.09, 0.06), vary: (0.14, 0.03)),
    (tile: "undergrowth",    glyph: '♠',  fg: (0.56, 0.72, 0.5),   bg: (0.07, 0.09, 0.07), vary: (0.18, 0.05)),
    // A pale green-white, a step or so round it: a log furred with it is a
    // pool of cold light among the trees.
    (tile: "glowmoss",       glyph: ',',  fg: (0.78, 1.0, 0.84),  bg: (0.1, 0.24, 0.16),  vary: (0.12, 0.04), shimmer: 0.12,
     light: (intensity: 200, radius: 2, color: (r: 190, g: 255, b: 210))),

    // The Palace Gardens: hedges grown wild round lawns and gravel walks, the
    // beds gone to pale flowers that glow, fountains still full, and the
    // menagerie's cages broken open. A hedge is a wall of leaves, green and
    // lighter than the lawn it bounds.
    (tile: "hedge",          glyph: '#',  fg: (0.42, 0.6, 0.36),  bg: (0.24, 0.34, 0.22), vary: (0.12, 0.04)),
    (tile: "lawn",           glyph: '"',  fg: (0.3, 0.42, 0.28),  bg: (0.07, 0.1, 0.06),  vary: (0.16, 0.05)),
    (tile: "gravel",         glyph: '.',  fg: (0.58, 0.57, 0.52), bg: (0.12, 0.12, 0.1),  vary: (0.12, 0.02)),
    // Pale rose, a little way round each bloom: a bed of them is the
    // light a garden is seen by.
    (tile: "night blooms",   glyph: '✿',  fg: (1.0, 0.82, 0.92),   bg: (0.17, 0.11, 0.14),  vary: (0.1, 0.04), shimmer: 0.1,
     light: (intensity: 200, radius: 2, color: (r: 255, g: 205, b: 232))),
    // A fountain's water, waded, and lit faintly from the basin's floor.
    (tile: "basin",          glyph: '~',  fg: (0.45, 0.85, 0.8),    bg: (0.1, 0.22, 0.3),   vary: (0.1, 0.03), shimmer: 0.25,
     light: (intensity: 200, radius: 1, color: (r: 150, g: 210, b: 240), flicker: 20)),
    // A cage's bars: seen and shot through, never walked through.
    (tile: "cage bars",      glyph: '║',  fg: (0.62, 0.62, 0.66), bg: (0.12, 0.12, 0.12), vary: (0.08, 0.02)),

    // The Drowned Town's first wave, floors one and two: the Old Town's
    // lanes and houses, the Harbour's quays and water, and the two
    // landmarks' own. What stops a body is drawn `≈` and what is waded `~`,
    // as everywhere; a moored boat and a ship's hull stop a body and are
    // seen over, so they are dark tarred wood on the water's own fill.
    (tile: "house wall",     glyph: '#',  fg: (0.68, 0.7, 0.62),  bg: (0.43, 0.45, 0.39), vary: (0.1, 0.03)),
    (tile: "lane cobbles",   glyph: '.',  fg: (0.58, 0.6, 0.53),  bg: (0.2, 0.21, 0.18),  vary: (0.14, 0.03)),
    (tile: "rotted boards",  glyph: '.',  fg: (0.56, 0.45, 0.32), bg: (0.21, 0.16, 0.11), vary: (0.14, 0.03)),
    (tile: "quay wall",      glyph: '#',  fg: (0.58, 0.66, 0.64), bg: (0.36, 0.43, 0.42), vary: (0.1, 0.03)),
    (tile: "quay",           glyph: '.',  fg: (0.36, 0.42, 0.38), bg: (0.16, 0.2, 0.2),   vary: (0.12, 0.03)),
    // Weed and wrack left on the quays, strewn: the quay's own fill.
    (tile: "wrack",          glyph: ',',  fg: (0.36, 0.52, 0.3),  bg: (0.16, 0.2, 0.2),   vary: (0.16, 0.05)),
    (tile: "harbour water",  glyph: '≈',  fg: (0.28, 0.5, 0.56),  bg: (0.03, 0.1, 0.13),  vary: (0.1, 0.03),  shimmer: 0.25),
    (tile: "harbour shallows", glyph: '~', fg: (0.3, 0.62, 0.66), bg: (0.1, 0.2, 0.21),  vary: (0.1, 0.03),  shimmer: 0.2),
    (tile: "moored boat",    glyph: '∪',  fg: (0.62, 0.42, 0.24), bg: (0.03, 0.1, 0.13),  vary: (0.1, 0.03)),
    (tile: "hull",           glyph: '#',  fg: (0.6, 0.42, 0.26),  bg: (0.24, 0.15, 0.09), vary: (0.12, 0.03)),
    // A deck gone under: planks seen through a hand of water, waded.
    (tile: "sunken deck",    glyph: '~',  fg: (0.44, 0.4, 0.3),   bg: (0.15, 0.16, 0.13), vary: (0.1, 0.03),  shimmer: 0.2),
    // The gatehouse's curtain: great pale blocks, older and finer than the
    // barracks it stands among.
    (tile: "curtain wall",   glyph: '#',  fg: (0.84, 0.8, 0.7),   bg: (0.58, 0.54, 0.46), vary: (0.06, 0.02)),
]
