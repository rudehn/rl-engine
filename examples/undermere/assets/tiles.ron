// How Undermere's tiles look in full light: Mereholt's, the doors the town and
// the floors hang, and each band's own walls and floors. The light that lands
// on a cell colours its glyph and its fill alike and memory fades both, so a
// tile is written once, as a white lamp would show it, and the dusk, a brazier
// or a pool of lava does the rest.
//
// Every field (the ones marked "optional" may be left out):
//   tile:    the tile's registered name, from `dungeon::Undermere::new`; every
//            registered tile needs a line, and the load says which is missing
//   glyph:   one character
//   fg:      (r, g, b) in 0..=1, the glyph's colour
//   bg:      optional; (r, g, b), the cell's fill; black when left out
//   vary:    optional; (brightness, hue), how far each cell strays from the
//            authored colour, 0..=1 each; none when left out
//   shimmer: optional; brightness drifting over time, 0..=1; still when left out
//
// Every tile here writes both colours and a `vary`, so no floor reads as
// wallpaper; water, lava and the gate shimmer as well. A strewn tile (rubble,
// bones) keeps the fill of the floor it lies on, so it reads as something on
// that floor rather than a hole in it.
[
    // Mereholt, at dusk.
    (tile: "grass",          glyph: '"',  fg: (0.32, 0.5, 0.26),  bg: (0.05, 0.1, 0.05),   vary: (0.18, 0.06)),
    (tile: "cobbles",        glyph: '.',  fg: (0.56, 0.52, 0.47), bg: (0.15, 0.14, 0.13),  vary: (0.12, 0.03)),
    (tile: "road",           glyph: ',',  fg: (0.52, 0.42, 0.3),  bg: (0.13, 0.1, 0.07),   vary: (0.14, 0.04)),
    (tile: "planks",         glyph: '.',  fg: (0.55, 0.4, 0.25),  bg: (0.2, 0.13, 0.08),   vary: (0.1, 0.03)),
    (tile: "garden",         glyph: '%',  fg: (0.4, 0.55, 0.25),  bg: (0.1, 0.08, 0.04),   vary: (0.16, 0.06)),
    (tile: "timber wall",    glyph: '#',  fg: (0.5, 0.36, 0.22),  bg: (0.24, 0.16, 0.09),  vary: (0.1, 0.03)),
    (tile: "stone wall",     glyph: '#',  fg: (0.62, 0.62, 0.66), bg: (0.3, 0.3, 0.33),    vary: (0.08, 0.02)),
    (tile: "lit window",     glyph: '#',  fg: (1.0, 0.82, 0.5),   bg: (0.55, 0.36, 0.14),  vary: (0.06, 0.03), shimmer: 0.08),
    (tile: "tree",           glyph: 'T',  fg: (0.2, 0.42, 0.22),  bg: (0.03, 0.08, 0.04),  vary: (0.15, 0.06)),
    (tile: "shallows",       glyph: '~',  fg: (0.4, 0.6, 0.75),   bg: (0.06, 0.14, 0.22),  vary: (0.1, 0.03),  shimmer: 0.25),
    (tile: "lake",           glyph: '~',  fg: (0.25, 0.42, 0.68), bg: (0.02, 0.05, 0.13),  vary: (0.1, 0.03),  shimmer: 0.3),
    (tile: "standing stone", glyph: '0',  fg: (0.7, 0.68, 0.76),  bg: (0.18, 0.18, 0.22),  vary: (0.08, 0.02)),
    // The Drowned Gate, on the island and again where it lets out on floor
    // one: the one tile that is a way through, and it glows violet.
    (tile: "gate",           glyph: '*',  fg: (0.85, 0.55, 1.0),  bg: (0.28, 0.1, 0.38),   vary: (0.08, 0.04), shimmer: 0.35),
    // The doors of the town's houses and of the halls and crypts below.
    (tile: "door",           glyph: '+',  fg: (0.72, 0.52, 0.3),  bg: (0.3, 0.2, 0.1),     vary: (0.1, 0.03)),
    (tile: "open door",      glyph: '\'', fg: (0.72, 0.52, 0.3),  bg: (0.16, 0.12, 0.08),  vary: (0.1, 0.03)),

    // The Upper Halls, floors one and two.
    (tile: "hall wall",      glyph: '#',  fg: (0.58, 0.53, 0.47), bg: (0.26, 0.23, 0.2),   vary: (0.1, 0.02)),
    (tile: "hall floor",     glyph: '.',  fg: (0.46, 0.43, 0.39), bg: (0.1, 0.09, 0.08),   vary: (0.12, 0.02)),
    (tile: "rubble",         glyph: ',',  fg: (0.5, 0.46, 0.4),   bg: (0.1, 0.09, 0.08),   vary: (0.15, 0.03)),

    // The Fungal Deeps, floors three and four.
    (tile: "cave wall",      glyph: '#',  fg: (0.36, 0.46, 0.42), bg: (0.11, 0.17, 0.15),  vary: (0.12, 0.04)),
    (tile: "moss",           glyph: '.',  fg: (0.3, 0.55, 0.42),  bg: (0.03, 0.09, 0.06),  vary: (0.18, 0.06)),
    (tile: "glowcaps",       glyph: '"',  fg: (0.4, 1.0, 0.85),   bg: (0.04, 0.2, 0.17),   vary: (0.12, 0.05), shimmer: 0.15),

    // The Catacombs, floors five and six.
    (tile: "crypt wall",     glyph: '#',  fg: (0.62, 0.62, 0.7),  bg: (0.19, 0.19, 0.25),  vary: (0.08, 0.02)),
    (tile: "crypt floor",    glyph: '.',  fg: (0.46, 0.46, 0.53), bg: (0.07, 0.07, 0.1),   vary: (0.1, 0.02)),
    (tile: "bones",          glyph: ',',  fg: (0.8, 0.78, 0.7),   bg: (0.07, 0.07, 0.1),   vary: (0.12, 0.03)),

    // The Drowned Cathedral, floors seven and eight.
    (tile: "cathedral wall", glyph: '#',  fg: (0.5, 0.62, 0.68),  bg: (0.14, 0.21, 0.26),  vary: (0.08, 0.02)),
    (tile: "marble",         glyph: '.',  fg: (0.6, 0.66, 0.7),   bg: (0.1, 0.12, 0.14),   vary: (0.08, 0.02)),
    (tile: "flooded floor",  glyph: '~',  fg: (0.38, 0.58, 0.72), bg: (0.05, 0.12, 0.2),   vary: (0.1, 0.03),  shimmer: 0.25),
    (tile: "deep water",     glyph: '~',  fg: (0.22, 0.38, 0.62), bg: (0.01, 0.04, 0.11),  vary: (0.1, 0.03),  shimmer: 0.3),
    // Marble under a shaft of the pale light that comes down through the lake.
    (tile: "moonlit marble", glyph: '.',  fg: (0.82, 0.88, 0.95), bg: (0.2, 0.24, 0.3),    vary: (0.05, 0.02), shimmer: 0.1),

    // The Forge of Embers, floor nine.
    (tile: "forge wall",     glyph: '#',  fg: (0.58, 0.36, 0.3),  bg: (0.24, 0.11, 0.09),  vary: (0.1, 0.03)),
    (tile: "ash",            glyph: '.',  fg: (0.47, 0.41, 0.38), bg: (0.11, 0.09, 0.08),  vary: (0.12, 0.03)),
    (tile: "lava",           glyph: '~',  fg: (1.0, 0.62, 0.2),   bg: (0.62, 0.16, 0.0),   vary: (0.12, 0.05), shimmer: 0.4),

    // The Throne, floor ten.
    (tile: "throne wall",    glyph: '#',  fg: (0.4, 0.55, 0.6),   bg: (0.08, 0.13, 0.16),  vary: (0.08, 0.02)),
    (tile: "throne floor",   glyph: '.',  fg: (0.5, 0.6, 0.64),   bg: (0.06, 0.09, 0.11),  vary: (0.08, 0.02)),
    (tile: "dais",           glyph: '-',  fg: (0.62, 0.7, 0.74),  bg: (0.12, 0.16, 0.19),  vary: (0.06, 0.02)),
    (tile: "black pool",     glyph: '~',  fg: (0.2, 0.4, 0.5),    bg: (0.01, 0.04, 0.07),  vary: (0.08, 0.03), shimmer: 0.2),
]
