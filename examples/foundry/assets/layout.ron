// How a deck is grown: the shapes it is built from, the districts that
// favor some of them, and the recipes `src/decks.rs` names for each deck.
// A piece's body is carved from "deck", and a Door opens as a "hatch".
//
// Every field:
//   shapes: every shape a district may draw
//     name: the shape's name; an area remembers it, and nothing in the
//           engine reads a meaning into it
//     kind: one of
//       Rectangle(w: (fewest, most), h: (fewest, most))
//       Cross(long: (fewest, most), short: (fewest, most))
//                         two bars overlapped on their centers; the most
//                         of short is less than the fewest of long
//       Passage(width: (fewest, most), length: (fewest, most), bend_pct: 0)
//                         bend_pct is the chance in a hundred of a second
//                         leg at a right angle; a passage is not a room,
//                         and nothing is stamped in it
//     join: how a piece of it is joined to what it is attached to, one of
//       Door              one cell of the door tile
//       Arch              one cell of floor
//       Mouth(n)          floor up to n cells wide, n at least 1
//   districts: a region's taste in shapes
//     name:   the district's name; an area remembers it
//     shapes: [(shape, weight)], at least one weight more than nought
//   recipes: what a deck names to be built
//     name:              the recipe's name
//     size:              (width, height) in cells
//     open_pct:          the share of the map to open, 1 to 100
//     patience:          attempts in a row that may fail before growth
//                        gives up, more than nought
//     districts_per_10k: district seeds per ten thousand cells, rounded,
//                        never fewer than one seed
//     districts:         [(district, weight)], at least one weight more
//                        than nought
//     loops:             (min_detour, max): the shortest detour in steps
//                        worth a hatch, and the most hatches
//     require:           what the built deck must meet or be built again
//       open_pct:     (at least, at most)
//       areas:        [(shape, fewest)], each a shape some district of
//                     this recipe draws
//       loops:        fewest
//       dead_end_pct: the largest share of areas with one way in, 0 to 100
//       route:        fewest steps from the way in to the way out
(
    shapes: [
        // A room no smaller than seven a side: every piece in
        // assets/prefabs is laid with a cell of floor all round it, and
        // the largest is five, so a smaller room could hold no reactor.
        (name: "cell", kind: Rectangle(w: (7, 10), h: (7, 9)), join: Door),
        (name: "hall", kind: Rectangle(w: (12, 18), h: (9, 12)), join: Mouth(3)),
        (name: "cross", kind: Cross(long: (13, 17), short: (7, 9)), join: Door),
        (name: "service", kind: Passage(width: (1, 2), length: (5, 12), bend_pct: 35), join: Arch),
        (name: "gangway", kind: Passage(width: (3, 3), length: (8, 16), bend_pct: 15), join: Arch),
    ],
    districts: [
        (name: "halls", shapes: [("hall", 5), ("cell", 2), ("gangway", 2)]),
        (name: "cells", shapes: [("cell", 6), ("cross", 2), ("service", 2)]),
        (name: "service", shapes: [("service", 5), ("cell", 3), ("gangway", 1)]),
    ],
    recipes: [
        (
            name: "assembly", size: (84, 48), open_pct: 40, patience: 300, districts_per_10k: 7,
            districts: [("halls", 3), ("cells", 2), ("service", 1)],
            loops: (min_detour: 24, max: 6),
            require: (open_pct: (36, 62), areas: [("hall", 1), ("cell", 4)], loops: 2, dead_end_pct: 55, route: 40),
        ),
        (
            name: "warren", size: (84, 48), open_pct: 38, patience: 300, districts_per_10k: 9,
            districts: [("cells", 3), ("service", 3), ("halls", 1)],
            loops: (min_detour: 24, max: 8),
            require: (open_pct: (34, 62), areas: [("cell", 6)], loops: 3, dead_end_pct: 55, route: 40),
        ),
    ],
)
