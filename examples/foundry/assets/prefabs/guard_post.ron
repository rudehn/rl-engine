// A prefab: a piece of a deck, drawn as rows of glyphs, and what each
// glyph stands for. The deck's chain in `src/decks.rs` asks for it by name
// and chooses where it goes and which way it faces; the engine fills its
// slots the first time the deck is entered.
//
// Every field:
//   name:   the prefab's name, which a mapgen chain asks for
//   ground: the tile painted under every slot; required when the legend
//           has any slot, and whenever it is given, slots or none, it
//           must be a tile a monster can stand on
//   rows:   the piece, one string per row, all the same width; a space is
//           left as the map had it, and every other glyph must be in the
//           legend
//   legend: glyph to what it stands for, one of
//     Tile("name")                          a tile: "hull" | "deck" |
//                                           "grating" | "bulkhead" |
//                                           "hatch" | "console" | "lamp"
//     Prop("name")                          a prop from props.ron
//     Item(item: "item", count: 1)          that item from items.ron;
//                                           count is 1 or a range,
//                                           count: (fewest, most),
//                                           default 1
//     Item(tag: "tag", count: 1, band: 0)   drawn from item_spawns.ron by
//                                           tag at the deck plus band;
//                                           count is separate draws; the
//                                           tags are "weapon" | "armor" |
//                                           "slug" | "med" | "keycard"
//     Monster(monster: "monster")           that monster from monsters.ron
//     Monster(role: "role", band: 0)        drawn from monster_spawns.ron
//                                           among the role's monsters in
//                                           roles.ron, at the deck plus band
//     Mark                                  a position Foundry finds by
//                                           this glyph and fills itself
//   A monster at a slot holds that cell as its post.
//
// The guard post, on decks two, four, five, seven and eight: a locker
// and a weapon two decks ahead of the deck, flanked by two sentries a
// deck ahead and held at the mouth by a brute two ahead, each drawn from
// roles.ron at whatever deck the post is stamped on. Five by five, so any
// room that takes a reactor takes it.
//
// The mouth is three wide, not a one-cell door: a sentry that went out
// after the commando walks home past the brute, where a door the brute
// stood in would shut it out of its own post for good.
// ANCHOR: post
(
    name: "guard post",
    ground: "deck",
    rows: [
        "#####",
        "#sAs#",
        "#.w.#",
        "#.b.#",
        "#...#",
    ],
    legend: {
        '#': Tile("bulkhead"),
        '.': Tile("deck"),
        'A': Prop("armory locker"),
        'w': Item(tag: "weapon", band: 2),
        's': Monster(role: "sentry", band: 1),
        'b': Monster(role: "brute", band: 2),
    },
)
// ANCHOR_END: post
