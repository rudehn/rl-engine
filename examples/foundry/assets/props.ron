// What stands on Foundry's decks that is neither a droid nor a thing to
// carry: the crates, the consoles, the loose cable, and what a droid
// leaves when it stops working.
//
// Every field (the ones marked "optional" may be left out):
//   name:      unique; the name the nearby rail and the look cursor show
//   glyph:     one character
//   color:     (r, g, b) in bytes, as abilities.ron writes a look
//   layer:     optional; draw order among entities on one cell, default 1
//   blocks:    optional; whether it stands in the way, default false
//   health:    optional; what it takes to break it; absent, nothing can
//   offers:    optional; [(verb:, time:, needs:, effects: [...])]
//              verb is registered: "open" and "search" are the engine's,
//              and Foundry adds "charge"; time is hundredths of a step
//   container: optional; (contents: [...], locked:, opened: (glyph:, color:)) where
//              contents is a list of rows, each either (item: "name", count:) for that
//              item, or (tag: "tag", count:, band:) for anything carrying the tag, drawn
//              from item_spawns.ron at the deck the container stands on plus band
//              (optional, 0 by default; 2 is a thing from two decks down); count is n
//              or (fewest, most), how many of the item or how many draws of the tag;
//              the tags are "weapon" | "armor" | "slug" | "med" | "keycard"; locked is
//              the tag an opener must carry; opened is the look once emptied
//   triggers:  optional; [(on:, area:, fires:, effects: [...], look:)], what it does at the moments
//              it answers: on is "entered" | "destroyed" or a moment the game registers;
//              area is Here (default) | Burst(radius:), where the effects land around it;
//              fires is how many times it may go off, every time when left out; effects
//              are written as in abilities.ron; look is optional, (glyph:, color: (r:, g:, b:))
//              shown over every cell it lands on, and a trap meant to be unseen has none
//   hidden:    optional; (spot:) percent a turn to spot it while in sight
#![enable(implicit_some)]
[
    // Supply crates stand in the stores. Two turns to lever open, and
    // slugs are what a commando runs out of first.
    (name: "supply crate", glyph: '&', color: (r: 190, g: 165, b: 115), blocks: true, health: 6,
     container: (contents: [(tag: "slug", count: (4, 9)), (tag: "med", count: (0, 1))], opened: (glyph: '"', color: (r: 120, g: 105, b: 75))),
     offers: [(verb: "open", time: 200)]),

    // ANCHOR: locker
    // An armory locker: better than a crate, and shut. A keycard opens
    // it, and `props::spend_the_keycard` takes the card doing it, so a
    // card found is a locker opened and no more. What is in it is drawn
    // at the deck it stands on, so a locker on deck eight holds a deck
    // eight weapon.
    (name: "armory locker", glyph: '&', color: (r: 205, g: 210, b: 220), blocks: true, health: 8,
     container: (contents: [(tag: "slug", count: (4, 9)), (tag: "weapon", count: 1), (tag: "armor", count: (0, 1)), (tag: "med", count: (0, 1))],
                 locked: "keycard", opened: (glyph: '"', color: (r: 130, g: 135, b: 145))),
     offers: [(verb: "open", time: 300)]),
    // ANCHOR_END: locker

    // The reactor console: three turns to set the charge, and Foundry
    // answers the verb itself, since no effect can report a fact.
    (name: "reactor console", glyph: 'R', color: (r: 242, g: 166, b: 64), blocks: true,
     offers: [(verb: "charge", time: 300)]),

    // The same console once its charge is set: no offer, and it reads as
    // done at a glance.
    (name: "spent reactor console", glyph: 'R', color: (r: 120, g: 95, b: 55), blocks: true),

    // A cable nobody made safe. Unseen until it is spotted, and it does
    // not care whether it was: the trigger is the ground, not the eye.
    // Electricity, which plate conducts rather than stops.
    (name: "live cable", glyph: '/', color: (r: 140, g: 200, b: 255), hidden: (spot: 35),
     triggers: [(on: "entered", fires: 3, effects: [(kind: "Harm", args: (kind: "electricity", roll: "1d4"))])]),

    // What a droid leaves. Named by the remains template, so this name is
    // only what a wreck nobody died into would be called; stripping one is
    // opening it, and what is in it is whatever the droid had left.
    (name: "wreckage", glyph: '%', color: (r: 130, g: 130, b: 140),
     container: (contents: [(item: "slug", count: (0, 2))]),
     offers: [(verb: "open", time: 100)]),
]
