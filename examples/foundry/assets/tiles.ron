// How the foundry's tiles look in full light. The lights-out overlay and
// memory shading do the rest; the renderer works out darkness and memory
// from the two colours.
//
// Every field (the ones marked "optional" may be left out):
//   tile:    the tile's registered name, from `Foundry::new`; every registered
//            tile needs a line, and the load says which is missing
//   glyph:   one character
//   fg:      (r, g, b) in 0..=1, the glyph's colour
//   bg:      optional; (r, g, b), the cell's fill; black when left out
//   vary:    optional; (brightness, hue), how far each cell strays from the
//            authored colour, 0..=1 each; none when left out
//   shimmer: optional; brightness drifting over time, 0..=1
[
    (tile: "hull",     glyph: '#', fg: (0.55, 0.58, 0.62), bg: (0.16, 0.17, 0.19), vary: (0.12, 0.02)),
    (tile: "deck",     glyph: '.', fg: (0.62, 0.64, 0.66), bg: (0.22, 0.22, 0.24), vary: (0.12, 0.02)),
    (tile: "grating",  glyph: ':', fg: (0.6, 0.66, 0.68),  bg: (0.18, 0.2, 0.21),  vary: (0.15, 0.03)),
    (tile: "bulkhead", glyph: '#', fg: (0.7, 0.72, 0.75),  bg: (0.28, 0.29, 0.31), vary: (0.1, 0.02)),
    (tile: "hatch",    glyph: '+', fg: (0.85, 0.68, 0.25), bg: (0.3, 0.24, 0.09),  vary: (0.1, 0.02)),
    (tile: "console",  glyph: '%', fg: (0.35, 0.85, 0.9),  bg: (0.08, 0.22, 0.24), vary: (0.1, 0.05), shimmer: 0.3),
    (tile: "lamp",     glyph: '*', fg: (1.0, 0.92, 0.55),  bg: (0.35, 0.3, 0.1),   vary: (0.1, 0.04),  shimmer: 0.4),
]
