// What lies about on Foundry's decks before anyone has dropped anything:
// on which decks, and how often. What each thing is and does is
// `items.ron`; this is only where. What a kill drops is its kind's `drops`
// in `monsters.ron`, and what is in a crate is the crate's in `props.ron`.
//
// The engine's loot reads it: what a deck scatters on its floor when it is
// first entered, and what a crate or a locker draws when it asks for a tag.
//
// Every field (the ones marked "optional" may be left out):
//   item:   a name from `items.ron`
//   bands:  (first, last), the decks the row applies on, both included
//   weight: how often it is drawn against every other row that applies on a
//           deck; only the ratio matters
//   group:  optional; (fewest, most) lying together where it is found on the
//           floor, one when left out; a container counts its own draws
//
// An item may have several rows; one with no row is never found lying
// about. The engine sorts the rows by item name before it draws, so the
// order they are written in here changes nothing; adding or removing one
// does.
[
    (item: "monoblade",          bands: (1, 10), weight: 3),
    (item: "mono-axe",           bands: (2, 10), weight: 2),
    (item: "hand blaster",       bands: (2, 10), weight: 3),
    (item: "blaster carbine",    bands: (3, 10), weight: 2),
    (item: "ion pistol",         bands: (2, 10), weight: 2),
    // The one gun on deck one, at about two decks in five.
    (item: "slug pistol",        bands: (1, 10), weight: 1),
    (item: "slug rifle",         bands: (4, 10), weight: 2),
    (item: "heavy repeater",     bands: (7, 10), weight: 2),
    (item: "slug",               bands: (1, 10), weight: 4, group: (2, 5)),
    (item: "keycard",            bands: (1, 10), weight: 2),
    (item: "stim",               bands: (1, 10), weight: 4),
    (item: "medkit",             bands: (2, 10), weight: 2),
    // No grenade lies on deck one, which is fought with bare hands.
    (item: "frag grenade",       bands: (2, 10), weight: 2),
    (item: "smoke grenade",      bands: (2, 10), weight: 2),
    (item: "ion grenade",        bands: (3, 10), weight: 2),
    (item: "incendiary grenade", bands: (4, 10), weight: 1),
    (item: "commando helmet",    bands: (1, 10), weight: 2),
    (item: "rangefinder helmet", bands: (2, 10), weight: 1),
    (item: "scrap plate",        bands: (1, 10), weight: 3),
    (item: "composite plate",    bands: (2, 10), weight: 2),
    (item: "combat gauntlets",   bands: (1, 10), weight: 2),
    (item: "armored greaves",    bands: (1, 10), weight: 2),
]
