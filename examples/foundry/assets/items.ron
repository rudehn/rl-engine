// Foundry's gear: what lies on the decks and what the dead leave behind.
//
// Every field (the ones marked "optional" may be left out):
//   name:      unique; spawn tables and drops refer to it; one of it, singular, since the engine
//              says a stack as "12 slugs"
//   glyph:     one character
//   color:     (r, g, b) in 0..=1
//   slot:      optional; where it is worn: "main hand" | "off hand" | "head" | "torso" | "arms" | "legs"
//   either:    optional; true for a one-handed weapon that fits either hand, so two can be dual wielded
//   also:      optional; slots it also claims when worn, for two-handers
//   tags:      optional; "weapon" | "armor" | "slug" | "keycard"
//   grants:    optional; abilities from `abilities.ron` the carrier may use while it is in the
//              bag, which is how a medical item works: using the item is using what it lends,
//              and an ability that costs Charge(1) takes one off the stack to do it
//   armor:     optional; flat armor while worn
//   resists:   optional; [(damage kind, percent removed)] while worn: "kinetic" | "energy" | "ion"
//   melee:     optional; (roll:, kind:, look:) while wielded, roll as "NdS+B"; look is optional,
//              (glyph:, color: (r:, g:, b:)) in bytes as in abilities.ron, and a blow bursts on
//              its target in its colour; absent, a blow shows nothing
//   ranged:    optional; (range:, roll:, kind:, look:) while wielded; look is optional, the same
//              shape, and is what a shot flies as; absent, a shot lands unseen
//   throw:     optional; (range, roll, kind) when thrown; absent, it cannot be thrown
//   cost:      optional; what one blow or shot costs, in hundredths of a step; absent is 100
//   heat:      optional; (per shot, vent per quiet turn); the weapon locks at 100 until it cools to 0
//   ammo:      optional; the tag of what one shot spends, as "slug"
//   dark_sight: optional; tiles seen without light while worn
//   stack:     optional; whether copies merge into one counted entry
//   spawn:     optional; (min deck, max deck, weight) for lying on a deck
#![enable(implicit_some)]
[
    (name: "monoblade", glyph: '/', color: (0.8, 0.85, 0.9), slot: "main hand", either: true, tags: ["weapon"], melee: (roll: "1d6+1", kind: "kinetic"), throw: (4, "1d6", "kinetic"), cost: 100, spawn: (1, 10, 3)),
    (name: "mono-axe", glyph: '/', color: (0.7, 0.75, 0.8), slot: "main hand", also: ["off hand"], tags: ["weapon"], melee: (roll: "2d6+1", kind: "kinetic"), cost: 140, spawn: (2, 10, 2)),
    (name: "hand blaster", glyph: '}', color: (0.95, 0.4, 0.3), slot: "main hand", either: true, tags: ["weapon"], ranged: (range: 5, roll: "1d6", kind: "energy", look: (glyph: '*', color: (r: 255, g: 77, b: 38))), cost: 80, heat: (15, 20), spawn: (2, 10, 3)),
    (name: "blaster carbine", glyph: '}', color: (0.9, 0.3, 0.25), slot: "main hand", also: ["off hand"], tags: ["weapon"], ranged: (range: 9, roll: "1d8+1", kind: "energy", look: (glyph: '*', color: (r: 255, g: 77, b: 38))), cost: 100, heat: (22, 22), spawn: (3, 10, 2)),
    (name: "ion pistol", glyph: '}', color: (0.4, 0.7, 1.0), slot: "main hand", either: true, tags: ["weapon"], ranged: (range: 5, roll: "1d6", kind: "ion", look: (glyph: '~', color: (r: 89, g: 166, b: 255))), cost: 90, heat: (25, 20), spawn: (2, 10, 2)),
    (name: "slug pistol", glyph: '}', color: (0.6, 0.55, 0.45), slot: "main hand", either: true, tags: ["weapon"], ranged: (range: 6, roll: "1d8", kind: "kinetic", look: (glyph: 'o', color: (r: 242, g: 204, b: 115))), cost: 100, ammo: "slug", spawn: (1, 10, 1)),
    (name: "slug", glyph: ',', color: (0.7, 0.65, 0.5), tags: ["slug"], stack: true, spawn: (1, 10, 4)),
    // What opens an armory locker, and is spent doing it. A droid carries
    // one because the foundry's own machines open its own lockers.
    (name: "keycard", glyph: '=', color: (0.85, 0.75, 0.3), tags: ["keycard"], stack: true, cost: 60, spawn: (1, 10, 2)),
    // The medical pair. A stim closes a wound now; a medkit is worth twice
    // as much and pays it two a turn over ten, which is ten turns of a deck
    // to live through first. Both are spent by being used, since the
    // abilities they lend cost a charge and neither carries `Charges` of
    // its own: one comes off the stack, and the last one takes the item.
    (name: "stim", glyph: '!', color: (0.55, 0.9, 0.63), grants: ["field stims"], stack: true, cost: 100, spawn: (1, 10, 4)),
    (name: "medkit", glyph: '!', color: (0.78, 0.94, 0.82), grants: ["med gel"], stack: true, cost: 100, spawn: (2, 10, 2)),
    (name: "commando helmet", glyph: '[', color: (0.85, 0.85, 0.8), slot: "head", tags: ["armor"], armor: 1, spawn: (1, 10, 2)),
    (name: "rangefinder helmet", glyph: '[', color: (0.6, 0.85, 0.7), slot: "head", tags: ["armor"], armor: 1, dark_sight: 6, spawn: (2, 10, 1)),
    (name: "scrap plate", glyph: '[', color: (0.55, 0.5, 0.45), slot: "torso", tags: ["armor"], armor: 1, spawn: (1, 10, 3)),
    (name: "composite plate", glyph: '[', color: (0.9, 0.9, 0.85), slot: "torso", tags: ["armor"], armor: 2, resists: [("energy", 10)], spawn: (2, 10, 2)),
    (name: "combat gauntlets", glyph: '[', color: (0.7, 0.7, 0.7), slot: "arms", tags: ["armor"], armor: 1, spawn: (1, 10, 2)),
    (name: "armored greaves", glyph: '[', color: (0.65, 0.65, 0.6), slot: "legs", tags: ["armor"], armor: 1, spawn: (1, 10, 2)),
]
