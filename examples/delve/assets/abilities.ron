// The delver's knacks, and the one a beast has.
//
// Every field (the ones marked "optional" may be left out):
//   name:        unique; the player knows the first five in the order `1` to `5` aim them,
//                and a beast names the ones it knows in `beasts.ron`
//   description: optional; what it is, in a sentence, for the knack list
//   look:        optional; (glyph:, color: (r:, g:, b:)), what flies and bursts when it
//                is used; without one the renderer's plain look is drawn
//   aim:       Foe (default) | Ally | SelfOnly | Ground | Anyone
//   mode:      Own | Adjacent | Bolt(range:) | Ball(range:, radius:) |
//              Beam(range:) | Cone(length:)
//   sight:     optional; whether the aim must be a cell the user can see (default true)
//   requires:  optional; Has(status) | Lacks(status) | Wielding(tag) |
//              InSlot(slot, tag) | Above(stat, n); the slots are "main hand" and
//              "off hand", the one tag is "shield"
//   costs:     optional; Pool(stat, n) | Charge(n) | Health(n) | Item(tag, n);
//              the one pool is "mana"
//   time:      optional; hundredths of a step the turn costs (default 100)
//   cooldown:  optional; hundredths before it may be used again, from the
//              moment of use (default 0)
//   effects:   each (kind:, chance:, args:); kind is one the engine ships
//              (Harm, Mend, Inflict, Cleanse, Shove, Pull, Teleport; Ignite(turns:),
//              which sets what it lands on alight; Emit(gas:, amount:), which gives
//              gas off) or the delve's own, Drain, which pours into a pool what it
//              takes; the damage kinds are "bite" | "blade" | "blunt" | "bile" |
//              "fire" | "care", the statuses "scorched" | "dazed", the gases
//              "smoke" | "reek"
#![enable(implicit_some)]
[
    (
        name: "fireball",
        description: "A gout of whale oil, lit. It bursts where it lands and leaves the fat burning.",
        look: (glyph: '*', color: (r: 255, g: 140, b: 40)),
        mode: Ball(range: 8, radius: 2),
        costs: [Pool("mana", 12)],
        cooldown: 200,
        effects: [
            (kind: "Harm", args: (kind: "fire", roll: "3d6")),
            (kind: "Inflict", chance: 50, args: (status: "scorched", turns: 4)),
            (kind: "Ignite", args: (turns: 2)),
        ],
    ),
    (
        name: "blink",
        description: "A step that skips the ground between. Only to somewhere you can see.",
        look: (glyph: '~', color: (r: 140, g: 180, b: 255)),
        aim: Ground,
        mode: Bolt(range: 7),
        costs: [Pool("mana", 5)],
        cooldown: 400,
        effects: [(kind: "Teleport")],
    ),
    (
        name: "mend",
        description: "Knit your own flesh. It takes the turn, and a fight rarely waits.",
        look: (glyph: '+', color: (r: 120, g: 230, b: 120)),
        aim: SelfOnly,
        mode: Own,
        costs: [Pool("mana", 6)],
        effects: [(kind: "Mend", args: (kind: "care", roll: "2d6"))],
    ),
    (
        name: "drain",
        description: "A thread of fire that burns what it touches and pours the heat back into you.",
        look: (glyph: '-', color: (r: 255, g: 90, b: 60)),
        mode: Bolt(range: 6),
        effects: [
            (kind: "Harm", args: (kind: "fire", roll: "1d6")),
            (kind: "Drain", args: (pool: "mana", amount: 4)),
        ],
    ),
    (
        name: "shield bash",
        description: "The whalebone shield, swung. Whatever it hits is knocked back and left reeling.",
        look: (glyph: ')', color: (r: 220, g: 220, b: 200)),
        mode: Adjacent,
        requires: [InSlot("off hand", "shield")],
        cooldown: 300,
        effects: [
            (kind: "Harm", args: (kind: "blunt", roll: "1d6")),
            (kind: "Shove", args: (cells: 1)),
            (kind: "Inflict", chance: 70, args: (status: "dazed", turns: 2)),
        ],
    ),
    (
        name: "spit",
        look: (glyph: 'o', color: (r: 160, g: 255, b: 70)),
        mode: Bolt(range: 5),
        cooldown: 300,
        effects: [(kind: "Harm", args: (kind: "bile", roll: "1d4"))],
    ),
]
