// What lives inside the whale, floor by floor.
//
// Every field:
//   name:       unique
//   glyph:      one character
//   color:      (r, g, b) in 0..=1
//   hp:         maximum health
//   armor:      flat damage removed from each hit
//   attack:     dice notation, "NdS+B" or a flat number
//   perception: tiles at which it notices you
//   speed:      percent, 100 normal
//   flee_at:    percent health at or below which it runs; 0 never flees
//   spawn:      (first_floor, last_floor, weight, min_group, max_group)
[
    (name: "gut eel", glyph: 'e', color: (0.6, 0.75, 0.5), hp: 6, armor: 0, attack: "1d4", perception: 6, speed: 120, flee_at: 0, spawn: (1, 3, 4, 1, 3)),
    (name: "stomach crab", glyph: 'c', color: (0.85, 0.5, 0.4), hp: 9, armor: 2, attack: "1d5", perception: 5, speed: 80, flee_at: 0, spawn: (1, 4, 3, 2, 4)),
    (name: "bone rat", glyph: 'r', color: (0.8, 0.8, 0.7), hp: 5, armor: 0, attack: "1d3", perception: 8, speed: 140, flee_at: 40, spawn: (2, 5, 4, 3, 6)),
    (name: "salt ghost", glyph: 'g', color: (0.7, 0.85, 0.95), hp: 14, armor: 1, attack: "1d6+1", perception: 9, speed: 100, flee_at: 0, spawn: (3, 5, 2, 1, 2)),
    (name: "heart warden", glyph: 'W', color: (0.95, 0.2, 0.25), hp: 40, armor: 3, attack: "2d6", perception: 12, speed: 90, flee_at: 0, spawn: (99, 99, 0, 1, 1)),
]
