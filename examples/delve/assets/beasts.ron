#![enable(implicit_some)]
// What lives inside the whale, floor by floor.
//
// Every field:
//   name:       unique
//   glyph:      one character
//   color:      (r, g, b) in 0..=1
//   hp:         maximum health
//   armor:      flat damage removed from each hit
//   attack:     dice notation, "NdS+B" or a flat number
//   perception: tiles at which it notices you
//   speed:      percent, 100 normal
//   flee_at:    percent health at or below which it runs; 0 never flees
//   spawn:      (first_floor, last_floor, weight, min_group, max_group)
//   glow:       optional; the light it sheds, as (intensity: 0..=255, radius: tiles,
//               color: (r: 0..=255, g: 0..=255, b: 0..=255), flicker: 0..=255, 0 steady, may be left out)
//   dark_sight: optional tiles it sees with no light at all; absent means only what it touches
//   notice:     optional; how it notices a quiet player, as (certain: tiles always noticed,
//               chance_pct: 0..=100 per turn beyond that, lit_bonus: tiles added while the
//               player stands in light, may be left out, memory: turns it searches after
//               losing sight, may be left out, 6); absent means it sees you the moment it can
//   abilities:  optional; names from `abilities.ron` it knows; it leads with one when one is worth firing
[
    (name: "gut eel", glyph: 'e', color: (0.6, 0.75, 0.5), hp: 6, armor: 0, attack: "1d4", perception: 6, speed: 120, flee_at: 0, spawn: (1, 3, 4, 1, 3), glow: (intensity: 70, radius: 2, color: (r: 120, g: 255, b: 150), flicker: 40), dark_sight: 4, notice: (certain: 2, chance_pct: 20, lit_bonus: 3, memory: 4), abilities: ["spit"]),
    (name: "stomach crab", glyph: 'c', color: (0.85, 0.5, 0.4), hp: 9, armor: 2, attack: "1d5", perception: 5, speed: 80, flee_at: 0, spawn: (1, 4, 3, 2, 4), dark_sight: 3, notice: (certain: 1, chance_pct: 10, lit_bonus: 2, memory: 3)),
    (name: "bone rat", glyph: 'r', color: (0.8, 0.8, 0.7), hp: 5, armor: 0, attack: "1d3", perception: 8, speed: 140, flee_at: 40, spawn: (2, 5, 4, 3, 6), dark_sight: 6, notice: (certain: 3, chance_pct: 35, lit_bonus: 4, memory: 6)),
    (name: "salt ghost", glyph: 'g', color: (0.7, 0.85, 0.95), hp: 14, armor: 1, attack: "1d6+1", perception: 9, speed: 100, flee_at: 0, spawn: (3, 5, 2, 1, 2), glow: (intensity: 90, radius: 3, color: (r: 170, g: 220, b: 255), flicker: 90), dark_sight: 7, notice: (certain: 2, chance_pct: 15, lit_bonus: 6, memory: 8)),
    (name: "heart warden", glyph: 'W', color: (0.95, 0.2, 0.25), hp: 40, armor: 3, attack: "2d6", perception: 12, speed: 90, flee_at: 0, spawn: (99, 99, 0, 1, 1), glow: (intensity: 210, radius: 7, color: (r: 255, g: 45, b: 55), flicker: 110), dark_sight: 12),
]
