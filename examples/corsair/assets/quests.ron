// Corsair's tasks: what the ledger asks of you, and what wins the run.
//
// Every field:
//   name:       unique, referred to by `after`
//   title:      what the ledger shows
//   text:       the pitch, shown under the title
//   after:      names of tasks that must be done before this one opens
//   objectives: a list of (text, on, need)
//     on:       what it counts, and of what; None in place of the subject counts any:
//               Killed(monster name) | KilledFaction(faction name)
//               | PickedUp(item name) | Carrying(item name) | Equipped(item name)
//               | EnteredCave(level, 1 is the top) | EnteredSite(Port | Cove)
//     need:     Total(n) counts matching facts (amounts add up) | Latest(n) needs one fact of amount n or more
//   victory:    optional; finishing this task wins the run
#![enable(implicit_some)]
[
    (
        name: "sea_legs",
        title: "Sea legs",
        text: "Beasts prowl the scrub beyond the docks. Prove your blade on them.",
        objectives: [(text: "Kill three beasts", on: KilledFaction("beasts"), need: Total(3))],
    ),
    (
        name: "wet_blade",
        title: "A wet blade",
        text: "Cutthroats hold the coves. Thin them out.",
        after: ["sea_legs"],
        objectives: [(text: "Kill two cutthroats", on: Killed("cutthroat"), need: Total(2))],
    ),
    (
        name: "hoard",
        title: "The smugglers' hoard",
        text: "Every cove hides a cave, and every cave a vault. Find one and fill your pockets.",
        after: ["sea_legs"],
        objectives: [
            (text: "Reach a smugglers' vault", on: EnteredCave(2), need: Total(1)),
            (text: "Carry a hundred doubloons", on: Carrying("doubloon"), need: Latest(100)),
        ],
    ),
    (
        name: "retire",
        title: "Retire rich",
        text: "Bring the hoard back to any port and never work again.",
        after: ["hoard"],
        objectives: [(text: "Set foot in a port with the hoard", on: EnteredSite(Port), need: Total(1))],
        victory: true,
    ),
]
