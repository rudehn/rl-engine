// Corsair's abilities: what a pirate calls on besides a cutlass.
//
// Every field (the ones marked "optional" may be left out):
//   name:        unique; the player knows broadside, grapnel and plunder of itself and the swig
//                from any bottle of rum it carries (`items.ron` grants it), `1` to `4` aim what
//                is known in this order, and a monster names the ones it knows in `monsters.ron`
//   description: optional; what it is, in a sentence, for the list on `a`
//   look:        optional; (glyph:, color: (r:, g:, b:)), what flies and bursts when it
//                is used; without one the renderer's plain look is drawn
//   aim:       Foe (default) | Ally | SelfOnly | Ground | Anyone
//   mode:      Own | Adjacent | Bolt(range:) | Ball(range:, radius:) |
//              Beam(range:) | Cone(length:)
//   sight:     optional; whether the aim must be a cell the user can see (default true)
//   requires:  optional; Has(status) | Lacks(status) | Wielding(tag) |
//              InSlot(slot, tag) | Above(stat, n)
//   costs:     optional; Pool(stat, n) | Charge(n) | Health(n) | Item(tag, n),
//              where Charge is spent from the item that grants the ability, the bottle
//              for the swig, and a tag is one from `items.ron`, "powder" or "rum"
//   time:      optional; hundredths of a step the turn costs (default 100)
//   cooldown:  optional; hundredths before it may be used again, from the
//              moment of use (default 0)
//   effects:   each (kind:, chance:, args:); kind is one the engine ships
//              (Harm, Mend, Inflict, Cleanse, Shove, Pull, Teleport) or
//              Corsair's own, Plunder, which spills a foe's purse at its feet
#![enable(implicit_some)]
[
    (
        name: "broadside",
        description: "Every pistol you carry, fired at once into whatever stands in the spread.",
        look: (glyph: '*', color: (r: 255, g: 230, b: 150)),
        mode: Cone(length: 5),
        costs: [Item("powder", 1)],
        cooldown: 400,
        effects: [
            (kind: "Harm", args: (kind: "pistol", roll: "2d6")),
            (kind: "Inflict", chance: 40, args: (status: "deafened", turns: 3)),
        ],
    ),
    (
        name: "grapnel",
        description: "A hook on a line, thrown. Whatever it catches is hauled in.",
        look: (glyph: 'J', color: (r: 180, g: 150, b: 110)),
        mode: Bolt(range: 7),
        cooldown: 300,
        effects: [(kind: "Pull", args: (cells: 3))],
    ),
    (
        name: "swig",
        description: "A pull of rum. It closes a wound, clears the venom and the bleeding, and puts heart in you for a while. Costs the bottle.",
        look: (glyph: '!', color: (r: 230, g: 170, b: 60)),
        aim: SelfOnly,
        mode: Own,
        costs: [Charge(1)],
        effects: [
            (kind: "Mend", args: (kind: "care", roll: "2d4")),
            (kind: "Cleanse", args: (status: "bleeding")),
            (kind: "Cleanse", args: (status: "venom")),
            (kind: "Inflict", args: (status: "hearty", turns: 10)),
        ],
    ),
    (
        name: "plunder",
        description: "A shakedown. Whoever is beside you empties their purse onto the sand.",
        look: (glyph: '$', color: (r: 255, g: 215, b: 0)),
        mode: Adjacent,
        effects: [(kind: "Plunder")],
    ),
]
