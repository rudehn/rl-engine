// Corsair's items: what lies on the sand and what the dead leave behind.
//
// Every field (the ones marked "optional" may be left out):
//   name:   unique, referred to by drop and spawn tables; one of it, singular, since the engine
//           says a stack as "5 throwing knives"; a thing with no plural is named by its measure,
//           "bottle of rum"
//   glyph:  one character
//   color:  (r, g, b) in 0..=1
//   slot:   optional; where it is worn: "main hand" | "off hand" | "body" | "head"
//   also:   optional; slots it also claims when worn, for two-handers
//   tags:   optional; what affixes and abilities see: "weapon" | "blade" | "gun" | "armor" |
//           "shield" | "hat" | "powder" | "rum"; an ability that costs Item("powder", 1) spends
//           one from a stack tagged "powder"
//           a "weapon" gains +1 damage per enchant level, "armor" +1 armor per level
//   armor:  optional; flat armor while worn
//   attack: optional; the damage roll while wielded, "NdS+B" or a flat number
//   kind:   optional; the damage kind while wielded: "cutlass" | "pistol" | "bite" | "claw" | "fist" | "fire"
//   ranged: optional; (range, roll, kind) for a shot while worn; `f` fires at the nearest foe in sight
//   throw:  optional; (range:, strike: (roll, kind)) when thrown; `r` throws the first one carried,
//           `t` in the chest the one picked, and a sapient monster throws its own and picks up more
//   effects: optional; [(kind:, chance:, args:)] written as an ability's effects are in
//           abilities.ron, landed by any trigger that names no list of its own
//   triggers: optional; [(on:, area:, fires:, effects:, look:)], what the item does at a moment:
//           on: "use" (used from the chest, landing on whoever used it where they stand) |
//               "land" (where it comes down when thrown) | "fire" | "hit" (for a gun);
//           area: Here (default) | Burst(radius: n); fires: optional, how many times before it
//           stops; effects: optional, in place of the item's `effects`; look: optional,
//           (glyph:, color: (r:, g:, b:)) shown over every cell it lands on
//   consumable: optional; (charges: n, when_empty: Destroyed | Kept), what a use spends: one off
//           a stack, the last taking the bottle with it; absent, a use costs nothing
//   stack:  optional; whether copies merge into one counted entry
//   spawn:  optional; (min_band, max_band, weight) for lying on the ground,
//           where the band is the region's distance from your home port
#![enable(implicit_some)]
[
    (name: "cutlass", glyph: ')', color: (0.8, 0.8, 0.85), slot: "main hand", tags: ["weapon", "blade"], attack: "1d6", kind: "cutlass", spawn: (0, 40, 2)),
    (name: "boarding axe", glyph: ')', color: (0.7, 0.5, 0.3), slot: "main hand", also: ["off hand"], tags: ["weapon", "blade"], attack: "1d10", kind: "cutlass", spawn: (4, 40, 1)),
    (name: "pistol", glyph: '}', color: (0.5, 0.5, 0.55), slot: "off hand", tags: ["weapon", "gun"], ranged: (6, "1d8", "pistol"), spawn: (3, 40, 2)),
    (name: "buckler", glyph: '[', color: (0.6, 0.6, 0.5), slot: "off hand", tags: ["armor", "shield"], armor: 1, spawn: (2, 40, 2)),
    (name: "leather jerkin", glyph: '[', color: (0.6, 0.4, 0.2), slot: "body", tags: ["armor"], armor: 1, spawn: (0, 40, 2)),
    (name: "tricorne", glyph: '[', color: (0.3, 0.3, 0.35), slot: "head", tags: ["armor", "hat"], armor: 1, spawn: (6, 40, 1)),
    // A pull of rum is not an ability the captain learned: the bottle says
    // what it does, and the engine spends one for it.
    (name: "bottle of rum", glyph: '!', color: (0.9, 0.6, 0.2), tags: ["rum"], stack: true, spawn: (0, 40, 4),
     consumable: (charges: 1, when_empty: Destroyed),
     triggers: [(on: "use", effects: [
        (kind: "Mend", args: (kind: "care", roll: "2d4")),
        (kind: "Cleanse", args: (status: "bleeding")),
        (kind: "Cleanse", args: (status: "venom")),
        (kind: "Inflict", args: (status: "hearty", turns: 10)),
     ])]),
    (name: "doubloon", glyph: '$', color: (1.0, 0.85, 0.2), stack: true, spawn: (0, 40, 4)),
    (name: "throwing knife", glyph: '/', color: (0.78, 0.8, 0.86), throw: (range: 6, strike: ("1d4+1", "cutlass")), stack: true, spawn: (1, 40, 2)),
    (name: "charge of powder", glyph: ',', color: (0.4, 0.4, 0.42), tags: ["powder"], stack: true, spawn: (0, 40, 3)),
]
