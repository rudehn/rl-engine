[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
# The release this template was written against; read the engine's
# CHANGELOG.md for what moved.
atglyph = "0.4.0"
# `system_font_discovery` lets the terminal ask the system for a monospace
# font, which it draws every letter with when a game ships no typeface of its
# own; without it a cell draws its background and no glyph. It costs a build on
# Linux the fontconfig development package.
# Must be the Bevy `atglyph` re-exports, or the game builds two Bevys whose
# types do not match.
bevy = { version = "0.19", features = ["system_font_discovery"] }

# Map generation and pathfinding are arithmetic-heavy, and an unoptimised
# debug build takes seconds per floor. Dependencies get full optimisation,
# your own code a light pass, so builds stay quick and play stays smooth.
# Dependencies carry no debug info: nobody steps through Bevy in a
# debugger, and it is most of a build's size on disk. Your own crate keeps
# it, so a backtrace still names your code.
[profile.dev.package."*"]
opt-level = 3
debug = false

[profile.dev]
opt-level = 1
